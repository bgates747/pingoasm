040191             0327*   ; Current Pingo scene-lighting and mesh-policy API. These helpers are grafted
040191             0328*   ; onto the curated Earth Party transport snapshot so its qualified camera
040191             0329*   ; command semantics remain unchanged.
040191             0330*   pingo_light_unity: equ 127
040191             0331*   pingo_shading_textured: equ 0
040191             0332*   pingo_shading_flat_palette: equ 1
040191             0333*   pingo_shading_flat_pattern: equ 2
040191             0334*   pingo_mesh_illumination_scene: equ 0
040191             0335*   pingo_mesh_illumination_self: equ 1
040191             0336*   pingo_flat_patterns_buffer_id: equ 3000
040191             0337*   pingo_flat_lookup_buffer_id: equ 3001
040191             0338*   pingo_flat_pattern_count: equ 126
040191             0339*   pingo_flat_material_count: equ 15
040191             0340*   pingo_flat_band_count: equ 16
