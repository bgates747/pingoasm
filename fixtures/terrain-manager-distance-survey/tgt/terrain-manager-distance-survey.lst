042973             0221*       SURVEY_STORE_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_y
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_y 
042973 7D          0001*M1         ld a,l
042974 32 4C 9D 04 0002*M1         ld (ADDRESS),a
042978 7C          0003*M1         ld a,h
042979 32 4D 9D 04 0004*M1         ld (ADDRESS+1),a
