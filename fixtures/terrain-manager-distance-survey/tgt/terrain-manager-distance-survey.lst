0427B3 D7 76       0418*       dw  30423 ; 48
0427B5 F8 77       0419*       dw  30712 ; 49
0427B7 07 79       0420*       dw  30983 ; 50
0427B9 03 7A       0421*       dw  31235 ; 51
0427BB ED 7A       0422*       dw  31469 ; 52
0427BD C3 7B       0423*       dw  31683 ; 53
0427BF 87 7C       0424*       dw  31879 ; 54
0427C1 37 7D       0425*       dw  32055 ; 55
0427C3 D4 7D       0426*       dw  32212 ; 56
0427C5 5D 7E       0427*       dw  32349 ; 57
0427C7 D3 7E       0428*       dw  32467 ; 58
0427C9 36 7F       0429*       dw  32566 ; 59
0427CB 84 7F       0430*       dw  32644 ; 60
