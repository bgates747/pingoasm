042DE5             0102        include "../../berkeley-flight-fdm/src/render-async.inc"
042DE5             0001*   ; =============================================================================
042DE5             0002*   ; Qualified Pingo render-completion callback support.
042DE5             0003*   ;
042DE5             0004*   ; One render may be in flight. The interrupt callback only recognizes/copies
042DE5             0005*   ; the ten-byte P3DR payload and publishes byte flags; all VDU work remains in
042DE5             0006*   ; the foreground. Non-P3DR records continue through MOS keyboard handling.
042DE5             0007*   ; =============================================================================
042DE5             0008*   
042DE5             0009*   render_notify_token: equ 0C35Ah
042DE5             0010*   setup_barrier_value: equ 0A5h
042DE5             0011*   
042DE5             0012*   initialize_render_state:
042DE5 AF          0013*       xor a
042DE6 32 CF 2F 04 0014*       ld (render_in_flight),a
042DEA 32 D0 2F 04 0015*       ld (completion_ready),a
042DEE 32 E7 2F 04 0016*       ld (sequence_initialized),a
042DF2 32 E8 2F 04 0017*       ld (exit_requested),a
042DF6 32 E9 2F 04 0018*       ld (callback_error),a
042DFA 32 E5 2F 04 0019*       ld (expected_sequence+0),a
042DFE 32 E6 2F 04 0020*       ld (expected_sequence+1),a
042E02 C9          0021*       ret
042E03             0022*   
042E03             0023*   ; Scene construction is asynchronous. General poll 0A5h fences those commands
042E03             0024*   ; before command 41 is enabled and the first render is submitted.
042E03             0025*   wait_for_setup_barrier:
042E03 DD 2A CC 2F 0026*       ld ix,(sysvars_pointer)
       04          
042E08 AF          0027*       xor a
042E09 DD 77 37    0028*       ld (ix+sysvar_gp),a
042E0C 21 23 2E 04 0029*       ld hl,@command
042E10 01 04 00 00 0030*       ld bc,@end-@command
042E14 5B DF       0031*       rst.lil 18h
042E16             0032*   @wait:
042E16 DD 2A CC 2F 0033*       ld ix,(sysvars_pointer)
       04          
042E1B DD 7E 37    0034*       ld a,(ix+sysvar_gp)
042E1E FE A5       0035*       cp setup_barrier_value
042E20 20 F4       0036*       jr nz,@wait
042E22 C9          0037*       ret
042E23             0038*   @command:
042E23 17 00 80 A5 0039*       db 23,0,080h,setup_barrier_value
042E27             0040*   @end:
042E27             0041*   
042E27             0042*   ; Publish in-flight state before any render byte reaches the VDP.
042E27             0043*   submit_current_render:
042E27 AF          0044*       xor a
042E28 32 D0 2F 04 0045*       ld (completion_ready),a
042E2C 3E 01       0046*       ld a,1
042E2E 32 CF 2F 04 0047*       ld (render_in_flight),a
042E32             0048*       RENDBMP sid,tgtbmid
                       M1 Args: SID=sid BMID=tgtbmid 
042E32 21 40 2E 04 0001*M1     ld hl,@beg
042E36 01 09 00 00 0002*M1     ld bc,@end-@beg
042E3A 5B DF       0003*M1     rst.lil $18
042E3C C3 49 2E 04 0004*M1     jp @end
042E40             0005*M1 @beg:
042E40             0006*M1 ;  1040 VDU 23, 0, &A0, sid%; &49, 38, bmid%; Render To Bitmap
042E40 17 00 A0    0007*M1     db 23, 0, $A0
042E43 C3 06       0008*M1     dw SID
042E45 49 26       0009*M1     db $49, 38
042E47 01 01       0010*M1     dw BMID
042E49             0011*M1 @end:
042E49 C9          0049*       ret
042E4A             0050*   
042E4A             0051*   ; Atomically snapshot the callback mailbox, then validate version, event,
042E4A             0052*   ; registration token, and monotonically increasing 16-bit sequence.
042E4A             0053*   consume_render_completion:
042E4A F3          0054*       di
042E4B 21 D1 2F 04 0055*       ld hl,completion_record
042E4F 11 DB 2F 04 0056*       ld de,completion_snapshot
042E53 01 0A 00 00 0057*       ld bc,10
042E57 ED B0       0058*       ldir
042E59 AF          0059*       xor a
042E5A 32 D0 2F 04 0060*       ld (completion_ready),a
042E5E FB          0061*       ei
042E5F             0062*   
042E5F 3A DF 2F 04 0063*       ld a,(completion_snapshot+4)
042E63 FE 01       0064*       cp 1
042E65 20 7D       0065*       jr nz,@reject
042E67 3A E0 2F 04 0066*       ld a,(completion_snapshot+5)
042E6B FE 01       0067*       cp 1
042E6D 20 75       0068*       jr nz,@reject
042E6F 3A E1 2F 04 0069*       ld a,(completion_snapshot+6)
042E73 FE 5A       0070*       cp render_notify_token & 0FFh
042E75 20 6D       0071*       jr nz,@reject
042E77 3A E2 2F 04 0072*       ld a,(completion_snapshot+7)
042E7B FE C3       0073*       cp render_notify_token >> 8
042E7D 20 65       0074*       jr nz,@reject
042E7F             0075*   
042E7F 3A E7 2F 04 0076*       ld a,(sequence_initialized)
042E83 B7          0077*       or a
042E84 28 18       0078*       jr z,@accept_first_sequence
042E86 21 E3 2F 04 0079*       ld hl,completion_snapshot+8
042E8A FD 21 E5 2F 0080*       ld iy,expected_sequence
       04          
042E8F 7E          0081*       ld a,(hl)
042E90 FD BE 00    0082*       cp (iy+0)
042E93 20 4F       0083*       jr nz,@reject
042E95 23          0084*       inc hl
042E96 7E          0085*       ld a,(hl)
042E97 FD BE 01    0086*       cp (iy+1)
042E9A 20 48       0087*       jr nz,@reject
042E9C 18 18       0088*       jr @sequence_valid
042E9E             0089*   
042E9E             0090*   @accept_first_sequence:
042E9E 21 E3 2F 04 0091*       ld hl,completion_snapshot+8
042EA2 FD 21 E5 2F 0092*       ld iy,expected_sequence
       04          
042EA7 7E          0093*       ld a,(hl)
042EA8 FD 77 00    0094*       ld (iy+0),a
042EAB 23          0095*       inc hl
042EAC 7E          0096*       ld a,(hl)
042EAD FD 77 01    0097*       ld (iy+1),a
042EB0 3E 01       0098*       ld a,1
042EB2 32 E7 2F 04 0099*       ld (sequence_initialized),a
042EB6             0100*   
042EB6             0101*   @sequence_valid:
042EB6 CD EF 2E 04 0102*       call increment_expected_sequence
042EBA F3          0103*       di
042EBB AF          0104*       xor a
042EBC 32 CF 2F 04 0105*       ld (render_in_flight),a
042EC0 FB          0106*       ei
042EC1             0107*   
042EC1             0108*   ; Display only a completed target.  The attitude-aware sky/ground fallback is
042EC1             0109*   ; painted first; Pingo's transparent untouched pixels then reveal it wherever
042EC1             0110*   ; terrain is absent.  The graphics viewport protects the static cockpit panel.
042EC1 CD 38 2B 04 0111*       call draw_flight_backdrop
042EC5             0112*       DISPBMP tgtbmid,viewport_x,viewport_y
                       M1 Args: BMID=tgtbmid X=viewport_x Y=viewport_y 
042EC5 21 D3 2E 04 0001*M1     ld hl,@beg
042EC9 01 0C 00 00 0002*M1     ld bc,@end-@beg
042ECD 5B DF       0003*M1     rst.lil $18
042ECF C3 DF 2E 04 0004*M1     jp @end
042ED3             0005*M1 @beg:
042ED3             0006*M1 ;   VDU 23, 27, &20, bmid% Select output bitmap
042ED3 17 1B 20    0007*M1     db 23,27,$20
042ED6 01 01       0008*M1     dw BMID
042ED8             0009*M1 ;   VDU 23, 27, 3, 0; 0; Display output bitmap
042ED8 17 1B 03    0010*M1     db 23,27,3
042EDB 00 00 00 00 0011*M1     dw X,Y
042EDF             0012*M1 @end:
042EDF CD 8D 02 04 0113*       call vdu_flip
042EE3 C9          0114*       ret
042EE4             0115*   
042EE4             0116*   @reject:
042EE4             0117*   ; Keep render_in_flight asserted: returning while a completion producer may
042EE4             0118*   ; still exist is less safe than remaining resident for diagnosis.
042EE4 3E 01       0119*       ld a,1
042EE6 32 E9 2F 04 0120*       ld (callback_error),a
042EEA 32 E8 2F 04 0121*       ld (exit_requested),a
042EEE C9          0122*       ret
042EEF             0123*   
042EEF             0124*   increment_expected_sequence:
042EEF 21 E5 2F 04 0125*       ld hl,expected_sequence
042EF3 34          0126*       inc (hl)
042EF4 C0          0127*       ret nz
042EF5 23          0128*       inc hl
042EF6 34          0129*       inc (hl)
042EF7 C9          0130*       ret
042EF8             0131*   
042EF8             0132*   install_render_callback:
042EF8 21 38 2F 04 0133*       ld hl,render_packet_callback
042EFC 0E 00       0134*       ld c,0
042EFE             0135*       MOSCALL mos_setkbvector
                       M1 Args: function=mos_setkbvector 
042EFE 3E 1D       0001*M1         ld a,function
042F00 5B CF       0002*M1         rst.lil 08h
042F02 C9          0136*       ret
042F03             0137*   
042F03             0138*   remove_render_callback:
042F03 21 00 00 00 0139*       ld hl,0
042F07 0E 00       0140*       ld c,0
042F09             0141*       MOSCALL mos_setkbvector
                       M1 Args: function=mos_setkbvector 
042F09 3E 1D       0001*M1         ld a,function
042F0B 5B CF       0002*M1         rst.lil 08h
042F0D C9          0142*       ret
042F0E             0143*   
042F0E             0144*   enable_render_notifications:
042F0E 21 19 2F 04 0145*       ld hl,@command
042F12 01 0A 00 00 0146*       ld bc,@end-@command
042F16 5B DF       0147*       rst.lil 18h
042F18 C9          0148*       ret
042F19             0149*   @command:
042F19 17 00 A0    0150*       db 23,0,0A0h
042F1C C3 06       0151*       dw sid
042F1E 49 29 01    0152*       db 49h,41,1
042F21 5A C3       0153*       dw render_notify_token
042F23             0154*   @end:
042F23             0155*   
042F23             0156*   disable_render_notifications:
042F23 21 2E 2F 04 0157*       ld hl,@command
042F27 01 0A 00 00 0158*       ld bc,@end-@command
042F2B 5B DF       0159*       rst.lil 18h
042F2D C9          0160*       ret
042F2E             0161*   @command:
042F2E 17 00 A0    0162*       db 23,0,0A0h
042F31 C3 06       0163*       dw sid
042F33 49 29 00    0164*       db 49h,41,0
042F36 00 00       0165*       dw 0
042F38             0166*   @end:
042F38             0167*   
042F38             0168*   ; MOS invokes this from its UART interrupt path with DEU pointing at the
042F38             0169*   ; payload. It must not make MOS/VDU calls or perform foreground work.
042F38             0170*   render_packet_callback:
042F38 F5          0171*       push af
042F39 DD E5       0172*       push ix
042F3B FD E5       0173*       push iy
042F3D D5          0174*       push de
042F3E DD E1       0175*       pop ix
042F40             0176*   
042F40 DD 7E 00    0177*       ld a,(ix+0)
042F43 FE 50       0178*       cp 'P'
042F45 20 6B       0179*       jr nz,@keyboard
042F47 DD 7E 01    0180*       ld a,(ix+1)
042F4A FE 33       0181*       cp '3'
042F4C 20 64       0182*       jr nz,@keyboard
042F4E DD 7E 02    0183*       ld a,(ix+2)
042F51 FE 44       0184*       cp 'D'
042F53 20 5D       0185*       jr nz,@keyboard
042F55 DD 7E 03    0186*       ld a,(ix+3)
042F58 FE 52       0187*       cp 'R'
042F5A 20 56       0188*       jr nz,@keyboard
042F5C             0189*   
042F5C FD 21 D1 2F 0190*       ld iy,completion_record
       04          
042F61 DD 7E 00    0191*       ld a,(ix+0)
042F64 FD 77 00    0192*       ld (iy+0),a
042F67 DD 7E 01    0193*       ld a,(ix+1)
042F6A FD 77 01    0194*       ld (iy+1),a
042F6D DD 7E 02    0195*       ld a,(ix+2)
042F70 FD 77 02    0196*       ld (iy+2),a
042F73 DD 7E 03    0197*       ld a,(ix+3)
042F76 FD 77 03    0198*       ld (iy+3),a
042F79 DD 7E 04    0199*       ld a,(ix+4)
042F7C FD 77 04    0200*       ld (iy+4),a
042F7F DD 7E 05    0201*       ld a,(ix+5)
042F82 FD 77 05    0202*       ld (iy+5),a
042F85 DD 7E 06    0203*       ld a,(ix+6)
042F88 FD 77 06    0204*       ld (iy+6),a
042F8B DD 7E 07    0205*       ld a,(ix+7)
042F8E FD 77 07    0206*       ld (iy+7),a
042F91 DD 7E 08    0207*       ld a,(ix+8)
042F94 FD 77 08    0208*       ld (iy+8),a
042F97 DD 7E 09    0209*       ld a,(ix+9)
042F9A FD 77 09    0210*       ld (iy+9),a
042F9D             0211*   
042F9D             0212*   ; MOS resumes normal keyboard processing after this callback. Turn the P3DR
042F9D             0213*   ; signature into a harmless null key-up record before returning.
042F9D AF          0214*       xor a
042F9E DD 77 00    0215*       ld (ix+0),a
042FA1 DD 77 01    0216*       ld (ix+1),a
042FA4 DD 77 02    0217*       ld (ix+2),a
042FA7 DD 77 03    0218*       ld (ix+3),a
042FAA 3E 01       0219*       ld a,1
042FAC 32 D0 2F 04 0220*       ld (completion_ready),a
042FB0 18 14       0221*       jr @done
042FB2             0222*   
042FB2             0223*   @keyboard:
042FB2             0224*   ; An Escape key-down can request shutdown immediately, even between simulation
042FB2             0225*   ; quanta. The foreground still drains any outstanding render before returning.
042FB2 DD 7E 03    0226*       ld a,(ix+3)
042FB5 FE 01       0227*       cp 1
042FB7 20 0D       0228*       jr nz,@done
042FB9 DD 7E 00    0229*       ld a,(ix+0)
042FBC FE 1B       0230*       cp 27
042FBE 20 06       0231*       jr nz,@done
042FC0 3E 01       0232*       ld a,1
042FC2 32 E8 2F 04 0233*       ld (exit_requested),a
042FC6             0234*   
042FC6             0235*   @done:
042FC6 FD E1       0236*       pop iy
042FC8 DD E1       0237*       pop ix
042FCA F1          0238*       pop af
042FCB C9          0239*       ret
042FCC             0240*   
