048212             0291*   distance_lod_records_end:
048212             0110        include "terrain-manager-distance-provider.inc"
048212             0001*   ; =============================================================================
048212             0002*   ; Hybrid Marina distance-control provider for the universal terrain manager.
048212             0003*   ;
048212             0004*   ; This file owns topology and corpus policy only.  The shared manager owns
048212             0005*   ; desired-set traversal, resident state, bounded publication, activation, and
048212             0006*   ; shutdown.  Axial q/r remain signed u16 in every manager/P3DM field.
048212             0007*   ;
048212             0008*   ; Natural L0 uses slots 0..90 and retains the qualified radius-five mapping.
048212             0009*   ; Static regular L1/L2 chunks use slots 91..182 from DISTLOD.INC.  Keeping the
048212             0010*   ; combined desired set below 256 lets the unchanged manager own publication,
048212             0011*   ; retries, activation, atomic rebase placement, and shutdown for both tiers.
048212             0012*   ;
048212             0013*   ; Every radius-five disk maps bijectively onto the first 91 slots through
048212             0014*   ;
048212             0015*   ;     slot = (5*q + 11*r) mod 91.
048212             0016*   ;
048212             0017*   ; The kernel basis (11,-5),(5,6) has determinant 91 and minimum non-zero hex
048212             0018*   ; distance 11.  Therefore no difference between two cells in one radius-five
048212             0019*   ; disk (maximum distance 10) can be in the kernel.  Smaller disks inherit the
048212             0020*   ; same injectivity, and normalizing negative residues makes the mapping global.
048212             0021*   ; =============================================================================
048212             0022*   
048212             0023*   hex_provider_q_max: equ 213
048212             0024*   hex_provider_even_rows: equ 235
048212             0025*   hex_provider_odd_rows: equ 234
048212             0026*   hex_provider_cell_id_pair_stride: equ 469
048212             0027*   hex_provider_terrain_y_count: equ 9728
048212             0028*   hex_provider_object_scale_q8_8: equ 32768
048212             0029*   hex_provider_hysteresis_count: equ 256
048212             0030*   hex_provider_vertical_exit_first: equ 4657
048212             0031*   hex_provider_tip_exit_first: equ 5377
048212             0032*   hex_provider_sloped_normal_squared: equ 4146176
048212             0033*   hex_provider_sloped_hysteresis: equ 521271
048212             0034*   hex_provider_sloped_exit_first: equ 9532472
048212             0035*   
048212             0036*       MACRO HEX_PROVIDER_LOAD_U16_HL ADDRESS
048212             0037*           ld hl,0
048212             0038*           ld a,(ADDRESS)
048212             0039*           ld l,a
048212             0040*           ld a,(ADDRESS+1)
048212             0041*           ld h,a
048212             0042*       ENDMACRO
048212             0043*   
048212             0044*       MACRO HEX_PROVIDER_LOAD_U16_DE ADDRESS
048212             0045*           ld de,0
048212             0046*           ld a,(ADDRESS)
048212             0047*           ld e,a
048212             0048*           ld a,(ADDRESS+1)
048212             0049*           ld d,a
048212             0050*       ENDMACRO
048212             0051*   
048212             0052*       MACRO HEX_PROVIDER_STORE_U16_HL ADDRESS
048212             0053*           ld a,l
048212             0054*           ld (ADDRESS),a
048212             0055*           ld a,h
048212             0056*           ld (ADDRESS+1),a
048212             0057*       ENDMACRO
048212             0058*   
048212             0059*       MACRO HEX_PROVIDER_LOAD_CAMERA_HL OFFSET
048212             0060*           ld hl,0
