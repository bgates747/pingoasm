0402B0 C9          0530*       RET
0402B1             0531*   ; load an image file to a buffer and make it a bitmap
0402B1             0532*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
0402B1             0533*   vdu_load_img:
0402B1             0534*   ; back up image type and dimension parameters
0402B1 F5          0535*       push af
0402B2 C5          0536*   	push bc
0402B3 D5          0537*   	push de
0402B4 E5          0538*       push hl
0402B5             0539*   ; set parameters for vdu call
0402B5 7D          0540*       ld a,l
0402B6 32 D4 02 04 0541*       ld (@bufferId),a
0402BA 7C          0542*       ld a,h
0402BB 32 D5 02 04 0543*       ld (@bufferId+1),a
0402BF             0544*   ; load the image
0402BF CD 60 03 04 0545*   	call vdu_load_buffer_from_file
0402C3             0546*   ; now make it a bitmap
0402C3             0547*   ; Command 14: Consolidate blocks in a buffer
0402C3             0548*   ; VDU 23, 0, &A0, bufferId; 14
0402C3 21 D1 02 04 0549*       ld hl,@beg
0402C7 01 06 00 00 0550*       ld bc,@end-@beg
