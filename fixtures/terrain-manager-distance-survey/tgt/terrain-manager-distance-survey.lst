048BEA             0111        include "../../../runtime/ez80/terrain-manager.inc"
048BEA             0001*   ; =============================================================================
048BEA             0002*   ; Topology-neutral Pingo terrain residency manager (ADL=1).
048BEA             0003*   ;
048BEA             0004*   ; Required compile-time constants:
048BEA             0005*   ;   terrain_manager_slot_count       1..255 (91 for radius-five hex)
048BEA             0006*   ;   terrain_manager_max_ring
048BEA             0007*   ;   terrain_manager_initial_ring
048BEA             0008*   ;   terrain_manager_mesh_id_base     exact u16
048BEA             0009*   ;   terrain_manager_object_id_base   exact u16
048BEA             0010*   ;
048BEA             0011*   ; Required provider hooks:
048BEA             0012*   ;   terrain_provider_ring_count
048BEA             0013*   ;       A=ring -> A=count (1..slot_count).
048BEA             0014*   ;   terrain_provider_desired_at
048BEA             0015*   ;       A=ordinal. Fills candidate_q/r (s16), candidate_slot (u8), and
048BEA             0016*   ;       candidate_lod (u8). Carry set means clipped/outside the corpus.
048BEA             0017*   ;       Slots must be injective over every desired set and stable per world cell.
048BEA             0018*   ;   terrain_provider_load_candidate
048BEA             0019*   ;       Reads candidate fields and work_mesh_id. Performs one complete validated
048BEA             0020*   ;       P3DM/AGNB publication; Z/A=0 success, NZ/A=error. Failure must retain the
048BEA             0021*   ;       old mesh/object exactly.
048BEA             0022*   ;   terrain_provider_position_candidate
048BEA             0023*   ;       Reads candidate fields, current origin and work_object_id. Publishes the
048BEA             0024*   ;       command-52 transform; Z/A=0 success, NZ/A=error.
048BEA             0025*   ;   terrain_provider_candidate_is_desired
048BEA             0026*   ;       Reads candidate fields/current origin/ring; Z desired, NZ stale.
048BEA             0027*   ;   terrain_provider_normalize_position
048BEA             0028*   ;       IX is opaque mutable application position state. The manager seeds
048BEA             0029*   ;       proposed_origin_q/r. Provider may normalize local X/Z, writes proposed
048BEA             0030*   ;       q/r, marks application position dirty, and returns carry iff origin moved.
048BEA             0031*   ;
048BEA             0032*   ; Required VDU helper: pingo_set_object_active (HL=u16 object ID, A=0/1).
048BEA             0033*   ;
048BEA             0034*   ; Public API:
048BEA             0035*   ;   terrain_manager_initialize
048BEA             0036*   ;   terrain_manager_submit_origin       BC=s16 q, DE=s16 r
048BEA             0037*   ;   terrain_manager_update_position     IX=opaque mutable position state;
048BEA             0038*   ;                                       A=0 unchanged/A=1 rebased, carry=error
048BEA             0039*   ;   terrain_manager_set_ring            A=ring
048BEA             0040*   ;   terrain_manager_service_idle        only while no render is in flight
048BEA             0041*   ;   terrain_manager_query               IX=status
048BEA             0042*   ;   terrain_manager_shutdown_idle       only while no render is in flight
048BEA             0043*   ;
048BEA             0044*   ; service_idle performs one load, activation, deactivation, or atomic all-active
048BEA             0045*   ; origin-reposition transaction. Carry clear returns A=operation; carry set
048BEA             0046*   ; returns A=error. Every dw below is accessed bytewise.
048BEA             0047*   ; =============================================================================
048BEA             0048*   
048BEA             0049*   terrain_manager_state_uninitialized: equ 0
048BEA             0050*   terrain_manager_state_ready:         equ 1
048BEA             0051*   terrain_manager_state_error:         equ 2
048BEA             0052*   terrain_manager_state_shutdown:      equ 3
048BEA             0053*   
048BEA             0054*   terrain_manager_operation_none:       equ 0
048BEA             0055*   terrain_manager_operation_load:       equ 1
048BEA             0056*   terrain_manager_operation_activate:   equ 2
048BEA             0057*   terrain_manager_operation_deactivate: equ 3
048BEA             0058*   terrain_manager_operation_rebase:     equ 4
048BEA             0059*   terrain_manager_operation_shutdown:   equ 5
048BEA             0060*   
048BEA             0061*   terrain_manager_flag_resident: equ 1
048BEA             0062*   terrain_manager_flag_active:   equ 2
048BEA             0063*   
048BEA             0064*   terrain_manager_error_config:   equ 020h
048BEA             0065*   terrain_manager_error_ring:     equ 021h
048BEA             0066*   terrain_manager_error_origin:   equ 022h
048BEA             0067*   terrain_manager_error_provider: equ 023h
048BEA             0068*   terrain_manager_error_position: equ 024h
048BEA             0069*   terrain_manager_error_slot:     equ 025h
048BEA             0070*   terrain_manager_retry_max:      equ 5
