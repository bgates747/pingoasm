042988 11 68 FF FF 0226*       ld de,-survey_angular_step
04298C 52 19       0227*       add.s hl,de                         ; intentional 16-bit turn wrap
04298E             0228*       SURVEY_STORE_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_y
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_y 
04298E 7D          0001*M1         ld a,l
04298F 32 4C 9D 04 0002*M1         ld (ADDRESS),a
042993 7C          0003*M1         ld a,h
042994 32 4D 9D 04 0004*M1         ld (ADDRESS+1),a
042998 C9          0229*       ret
042999             0230*   
042999             0231*   ; Build one local XZ displacement from WASD, rotate it around world Y using
042999             0232*   ; only the absolute camera yaw, then append Page Up/Down as an unrotated world
042999             0233*   ; Y displacement.  p3d_vec3_translate16 commits all three components together
042999             0234*   ; or leaves the camera unchanged at a signed-coordinate boundary.
042999             0235*   survey_update_translation:
042999 AF          0236*       xor a
04299A 32 64 9D 04 0237*       ld (survey_translation_delta+p3d_vec3_x+0),a
04299E 32 65 9D 04 0238*       ld (survey_translation_delta+p3d_vec3_x+1),a
0429A2 32 66 9D 04 0239*       ld (survey_translation_delta+p3d_vec3_y+0),a
0429A6 32 67 9D 04 0240*       ld (survey_translation_delta+p3d_vec3_y+1),a
0429AA 32 68 9D 04 0241*       ld (survey_translation_delta+p3d_vec3_z+0),a
0429AE 32 69 9D 04 0242*       ld (survey_translation_delta+p3d_vec3_z+1),a
0429B2             0243*   
0429B2 DD 21 5C 00 0244*       ld ix,keyboard_masks
       04          
0429B7             0245*   
0429B7             0246*   ; W/S: forward local -Z / backward local +Z.
0429B7 DD CB 04 4E 0247*       bit 1,(ix+4)                        ; W
0429BB 28 23       0248*       jr z,@backward_only
0429BD DD CB 0A 4E 0249*       bit 1,(ix+10)                       ; S
0429C1 20 37       0250*       jr nz,@forward_done
0429C3             0251*       SURVEY_LOAD_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
0429C3 3A 6A 9D 04 0001*M1         ld a,(ADDRESS)
0429C7 6F          0002*M1         ld l,a
0429C8 3A 6B 9D 04 0003*M1         ld a,(ADDRESS+1)
0429CC 67          0004*M1         ld h,a
