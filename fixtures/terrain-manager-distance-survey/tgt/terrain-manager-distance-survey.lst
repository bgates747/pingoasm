040D48             1888*   ;   transformed vec3 at (ix)
040D48             1889*   ;   carry clear on success
040D48             1890*   ;   carry set on arithmetic overflow
040D48             1891*   ; destroys:
040D48             1892*   ;   af, af', bc, de, hl, bc', de', hl'
