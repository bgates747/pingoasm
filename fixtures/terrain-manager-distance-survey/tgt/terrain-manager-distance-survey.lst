0409F4             1492*   ; Signed low-16 addition with signed-overflow carry.
0409F4             1493*   ;
0409F4             1494*   ; inputs:  hl = left, de = right
0409F4             1495*   ; outputs: hl = wrapped sum; carry set on signed overflow
0409F4             1496*   ; destroys: af
