041141             2225*   
041141             2226*   ; Apply one intrinsic local Euler delta to a local-to-world orientation.
041141             2227*   ; Fixed-point operations are deliberately ordered as:
041141             2228*   ;
041141             2229*   ;   ((R * Rz(dz)) * Ry(dy)) * Rx(dx)
041141             2230*   ;
041141             2231*   ; This is continuously equivalent to R*(Rz*Ry*Rx), while making the exact
041141             2232*   ; integer rounding order explicit and avoiding construction of a temporary
041141             2233*   ; matrix.
041141             2234*   ;
041141             2235*   ; inputs:
041141             2236*   ;   ix -> matrix
041141             2237*   ;   iy -> Pingo-angle vec3
041141             2238*   ; outputs:
041141             2239*   ;   updated matrix, carry as for the axis routines
041141             2240*   ; destroys:
041141             2241*   ;   af, af', bc, de, hl, bc', de', hl'
041141             2242*   ; preserves:
041141             2243*   ;   ix, iy; matrix is unchanged if any axis fails
041141             2244*   p3d_mat3_rotate_local_xyz16:
041141             2245*   ; Whole-operation snapshot, because each individual axis is only locally
041141             2246*   ; transactional.
041141 DD 6E 00    2247*       ld l,(ix+0)
041144 DD 66 01    2248*       ld h,(ix+1)
041147 E5          2249*       push hl
041148 DD 6E 02    2250*       ld l,(ix+2)
04114B DD 66 03    2251*       ld h,(ix+3)
04114E E5          2252*       push hl
04114F DD 6E 04    2253*       ld l,(ix+4)
041152 DD 66 05    2254*       ld h,(ix+5)
041155 E5          2255*       push hl
041156 DD 6E 06    2256*       ld l,(ix+6)
041159 DD 66 07    2257*       ld h,(ix+7)
04115C E5          2258*       push hl
04115D DD 6E 08    2259*       ld l,(ix+8)
041160 DD 66 09    2260*       ld h,(ix+9)
041163 E5          2261*       push hl
041164 DD 6E 0A    2262*       ld l,(ix+10)
041167 DD 66 0B    2263*       ld h,(ix+11)
04116A E5          2264*       push hl
04116B DD 6E 0C    2265*       ld l,(ix+12)
04116E DD 66 0D    2266*       ld h,(ix+13)
041171 E5          2267*       push hl
041172 DD 6E 0E    2268*       ld l,(ix+14)
041175 DD 66 0F    2269*       ld h,(ix+15)
041178 E5          2270*       push hl
041179 DD 6E 10    2271*       ld l,(ix+16)
04117C DD 66 11    2272*       ld h,(ix+17)
04117F E5          2273*       push hl
041180 FD 6E 04    2274*       ld l,(iy+p3d_vec3_z)
041183 FD 66 05    2275*       ld h,(iy+p3d_vec3_z+1)
041186 CD 72 10 04 2276*       call p3d_mat3_rotate_local_z16
04118A 38 23       2277*       jr c,@failed
04118C FD 6E 02    2278*       ld l,(iy+p3d_vec3_y)
04118F FD 66 03    2279*       ld h,(iy+p3d_vec3_y+1)
041192 CD A3 0F 04 2280*       call p3d_mat3_rotate_local_y16
041196 38 17       2281*       jr c,@failed
041198 FD 6E 00    2282*       ld l,(iy+p3d_vec3_x)
