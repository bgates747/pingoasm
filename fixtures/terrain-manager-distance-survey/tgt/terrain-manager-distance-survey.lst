0402D8 CD 07 03 04 0559*       call vdu_buff_select
0402DC D1          0560*   	pop de ; image height
0402DD C1          0561*   	pop bc ; image width
0402DE F1          0562*   	pop af ; image type
0402DF C3 22 03 04 0563*   	jp vdu_bmp_create ; will return to caller from there
