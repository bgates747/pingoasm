047C7E             0001*   ; =============================================================================
047C7E             0002*   ; Fixture-only live terrain-radius controls.
047C7E             0003*   ;
047C7E             0004*   ; The manager receives policy through manager_survey_radius_request; it does
047C7E             0005*   ; not know about keyboards.  Top-row digits use MOS's BBC-compatible physical
047C7E             0006*   ; key map.  Selection is rising-edge only, and simultaneous presses choose the
047C7E             0007*   ; lowest radius deterministically.
047C7E             0008*   ; =============================================================================
047C7E             0009*   
047C7E             0010*   manager_survey_initialize_radius_controls:
047C7E AF          0011*       xor a
047C7F 32 07 7D 04 0012*       ld (manager_survey_radius_keys_down),a
047C83 32 09 7D 04 0013*       ld (manager_survey_radius_pending),a
047C87 3E 05       0014*       ld a,manager_survey_default_radius
047C89 32 08 7D 04 0015*       ld (manager_survey_radius_request),a
047C8D C9          0016*       ret
047C8E             0017*   
047C8E             0018*   manager_survey_update_radius_keys:
047C8E DD 21 5C 00 0019*       ld ix,keyboard_masks
       04          
047C93 06 00       0020*       ld b,0
047C95 DD CB 04 7E 0021*       bit 7,(ix+4)                       ; top-row 0: physical key 40
047C99 28 02       0022*       jr z,@one
047C9B CB C0       0023*       set 0,b
047C9D             0024*   @one:
047C9D DD CB 06 46 0025*       bit 0,(ix+6)                       ; top-row 1: physical key 49
047CA1 28 02       0026*       jr z,@two
047CA3 CB C8       0027*       set 1,b
047CA5             0028*   @two:
047CA5 DD CB 06 4E 0029*       bit 1,(ix+6)                       ; top-row 2: physical key 50
047CA9 28 02       0030*       jr z,@three
047CAB CB D0       0031*       set 2,b
047CAD             0032*   @three:
047CAD DD CB 02 4E 0033*       bit 1,(ix+2)                       ; top-row 3: physical key 18
047CB1 28 02       0034*       jr z,@four
047CB3 CB D8       0035*       set 3,b
047CB5             0036*   @four:
047CB5 DD CB 02 56 0037*       bit 2,(ix+2)                       ; top-row 4: physical key 19
047CB9 28 02       0038*       jr z,@five
047CBB CB E0       0039*       set 4,b
047CBD             0040*   @five:
047CBD DD CB 02 5E 0041*       bit 3,(ix+2)                       ; top-row 5: physical key 20
047CC1 28 02       0042*       jr z,@edges
047CC3 CB E8       0043*       set 5,b
047CC5             0044*   
047CC5             0045*   @edges:
047CC5 3A 07 7D 04 0046*       ld a,(manager_survey_radius_keys_down)
047CC9 4F          0047*       ld c,a
047CCA 78          0048*       ld a,b
047CCB 32 07 7D 04 0049*       ld (manager_survey_radius_keys_down),a
047CCF 79          0050*       ld a,c
047CD0 2F          0051*       cpl
047CD1 A0          0052*       and b                              ; A = newly pressed radius keys
047CD2 C8          0053*       ret z
047CD3 CB 47       0054*       bit 0,a
047CD5 20 14       0055*       jr nz,@radius_zero
047CD7 CB 4F       0056*       bit 1,a
047CD9 20 13       0057*       jr nz,@radius_one
047CDB CB 57       0058*       bit 2,a
047CDD 20 13       0059*       jr nz,@radius_two
047CDF CB 5F       0060*       bit 3,a
047CE1 20 13       0061*       jr nz,@radius_three
047CE3 CB 67       0062*       bit 4,a
047CE5 20 13       0063*       jr nz,@radius_four
047CE7 3E 05       0064*       ld a,5
