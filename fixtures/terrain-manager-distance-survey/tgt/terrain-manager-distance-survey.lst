047A9C             0001*   ; =============================================================================
047A9C             0002*   ; Experimental Pingo command 53 client.
047A9C             0003*   ;
047A9C             0004*   ; Inputs:
047A9C             0005*   ;   HL = projection far distance in Pingo scene units (2..65535)
047A9C             0006*   ;
047A9C             0007*   ; Values 0 and 1 are consumed but rejected by the VDP, preserving the current
047A9C             0008*   ; setting.  Copy the two-byte value bytewise so ADL mode cannot widen the
047A9C             0009*   ; packet field into the following command stream.
047A9C             0010*   ; Clobbers AF, BC, HL.
047A9C             0011*   ; =============================================================================
047A9C             0012*   
