040D84             1929*   ; Multiply the row at IY by the vector at IX, accumulate all three products
040D84             1930*   ; at signed 32-bit width, then normalize once.
040D84             1931*   p3d_mat3_row_mul_vec3_16:
040D84             1932*   ; product 0 operands in the active bank
