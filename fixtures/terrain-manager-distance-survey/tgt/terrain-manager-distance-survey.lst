040097             0096        include "../../berkeley-flight-triangular-dither/src/timer.inc"
040097             0001*   ; =============================================================================
040097             0002*   ; MOS elapsed-time sampler used by moveobj-local.
040097             0003*   ;
040097             0004*   ; Curated from tests/apps/_common/timer.inc. Simulation accumulates full 24-bit
040097             0005*   ; elapsed values from the 120 Hz MOS clock; render cadence is independent.
040097             0006*   ; =============================================================================
040097             0007*   
040097 00 00 00    0008*   timestamp_now: dl 0
04009A 00 00 00    0009*   timestamp_old: dl 0
04009D 00 00 00    0010*   timestamp_chg: dl 0
0400A0             0011*   
0400A0             0012*   ; Update the global timestamp from the MOS 120 Hz system clock.
0400A0             0013*   ; returns: HL=elapsed ticks, DE=previous timestamp
0400A0             0014*   ; destroys: AF,HL,DE,IX
0400A0             0015*   timestamp_tick:
0400A0 ED 5B 97 00 0016*       ld de,(timestamp_now)
       04          
0400A5 ED 53 9A 00 0017*       ld (timestamp_old),de
       04          
0400AA             0018*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0400AA 3E 08       0001*M1         ld a,function
0400AC 5B CF       0002*M1         rst.lil 08h
0400AE DD 27 00    0019*       ld hl,(ix+sysvar_time) ; ADL24 OK: MOS time is a 24-bit 120 Hz counter
0400B1 22 97 00 04 0020*       ld (timestamp_now),hl
0400B5 AF          0021*       xor a
0400B6 ED 52       0022*       sbc hl,de
0400B8 22 9D 00 04 0023*       ld (timestamp_chg),hl
0400BC C9          0024*       ret
0400BD             0097        include "../../berkeley-flight-triangular-dither/src/vdu_pingo.inc"
0400BD             0001*   ; =============================================================================
0400BD             0002*   ; Current-Pingo VDU helpers for moveobj-local.
0400BD             0003*   ;
0400BD             0004*   ; This app-local snapshot deliberately limits Pingo traffic to the absolute
0400BD             0005*   ; commands it uses: 0-5, 9, 13, 17, 21, 25, and 38. The remaining routines are
0400BD             0006*   ; stock VDP/MOS helpers for screen setup,
0400BD             0007*   ; bitmap creation, and file-to-buffer upload.
0400BD             0008*   ; =============================================================================
0400BD             0009*   
0400BD             0010*   ; Exact-width stores for contiguous 16-bit fields in self-modifying VDU
0400BD             0011*   ; packets. In ADL=1 an unsuffixed LD (address),rr transfers three bytes even
0400BD             0012*   ; when the target is declared with DW. These macros instead write two bytes at
0400BD             0013*   ; the pointer in HL and advance HL past the field. Byte transfers neither use
0400BD             0014*   ; a multibyte data width nor redirect the address through MBASE.
0400BD             0015*       MACRO ST_U16_BC_ADV
0400BD             0016*       ld (hl),c
0400BD             0017*       inc hl
0400BD             0018*       ld (hl),b
0400BD             0019*       inc hl
0400BD             0020*       ENDMACRO
0400BD             0021*   
0400BD             0022*       MACRO ST_U16_DE_ADV
0400BD             0023*       ld (hl),e
0400BD             0024*       inc hl
0400BD             0025*       ld (hl),d
0400BD             0026*       inc hl
0400BD             0027*       ENDMACRO
0400BD             0028*   
0400BD             0029*       MACRO ST_U16_IY_ADV
0400BD             0030*       push af
0400BD             0031*       ld a,iyl
0400BD             0032*       ld (hl),a
0400BD             0033*       inc hl
0400BD             0034*       ld a,iyh
0400BD             0035*       ld (hl),a
0400BD             0036*       inc hl
0400BD             0037*       pop af
0400BD             0038*       ENDMACRO
0400BD             0039*   
0400BD             0040*   ; create pingo control structure
0400BD             0041*       MACRO CCS SID, SCENE_WIDTH, SCENE_HEIGHT
0400BD             0042*       ld hl,@beg
0400BD             0043*       ld bc,@end-@beg
0400BD             0044*       rst.lil $18
0400BD             0045*       jp @end
0400BD             0046*   @beg:
0400BD             0047*   ;   VDU 23,0, &A0, sid%; &49, 0, cstw%; csth%; Create Control Structure
0400BD             0048*       db 23,0,$A0
0400BD             0049*       dw SID
0400BD             0050*       db $49,0
0400BD             0051*       dw SCENE_WIDTH
0400BD             0052*       dw SCENE_HEIGHT
0400BD             0053*   @end:
0400BD             0054*       ENDMACRO
0400BD             0055*   
0400BD             0056*   ; DEFINE MESH VERTICES
0400BD             0057*       MACRO SV SID, MESH_ID, VERTEX_DATA, VERTEX_COUNT
0400BD             0058*       ld hl,@beg
0400BD             0059*       ld bc,@end-@beg
0400BD             0060*       rst.lil $18
0400BD             0061*       jp @end
0400BD             0062*   @beg:
0400BD             0063*   ;   VDU 23,0, &A0, sid%; &49, 1, mid%; VERTICES%; Define Mesh Vertices
0400BD             0064*       db 23,0,$A0
0400BD             0065*       dw SID
0400BD             0066*       db $49,1
0400BD             0067*       dw MESH_ID, VERTEX_COUNT
0400BD             0068*   @end:
0400BD             0069*       ld hl,VERTEX_DATA
0400BD             0070*       ld bc,VERTEX_COUNT*6 ; 3 coordinates per vertex, 2 bytes per coordinate
0400BD             0071*       rst.lil $18
0400BD             0072*       ENDMACRO
0400BD             0073*   
0400BD             0074*   ; DEFINE MESH VERTEX INDICES
0400BD             0075*       MACRO SMVI SID, MID, VERTEX_INDICES, INDICES_N
0400BD             0076*       ld hl,@beg
0400BD             0077*       ld bc,@end-@beg
0400BD             0078*       rst.lil $18
0400BD             0079*       jp @end
0400BD             0080*   @beg:
0400BD             0081*   ;   VDU 23,0, &A0, sid%; &49, 2, mid%; model_indices%; Set Mesh Vertex indices
0400BD             0082*       db 23,0,$A0
0400BD             0083*       dw SID
0400BD             0084*       db $49,2
0400BD             0085*       dw MID, INDICES_N
0400BD             0086*   @end:
0400BD             0087*       ld hl,VERTEX_INDICES
0400BD             0088*       ld bc,INDICES_N*2 ; 2 bytes per index
0400BD             0089*       rst.lil $18
0400BD             0090*       ENDMACRO
0400BD             0091*   
0400BD             0092*   ; DEFINE OBJECT TEXTURE COORDINATES
0400BD             0093*       MACRO STC SID, MESH_ID, UV_DATA, UV_COUNT
0400BD             0094*       ld hl,@beg
0400BD             0095*       ld bc,@end-@beg
0400BD             0096*       rst.lil $18
0400BD             0097*       jp @end
0400BD             0098*   @beg:
0400BD             0099*   ;   VDU 23, 0, &A0, sid; &49, 3, mid; n; u0; v0; ... : Define Mesh Texture Coordinates
0400BD             0100*       db 23,0,$A0
0400BD             0101*       dw SID
0400BD             0102*       db $49,3
0400BD             0103*       dw MESH_ID, UV_COUNT
0400BD             0104*   @end:
0400BD             0105*       ld hl,UV_DATA
0400BD             0106*       ld bc,UV_COUNT*4 ; 2 coordinates per uv, 2 bytes per coordinate
0400BD             0107*       rst.lil $18
0400BD             0108*       ENDMACRO
0400BD             0109*   
0400BD             0110*   ; SET OBJECT TEXTURE COORDINATE INDEXES
0400BD             0111*       MACRO STCI SID, MESH_ID, UV_INDICES, INDICES_N
0400BD             0112*       ld hl,@beg
0400BD             0113*       ld bc,@end-@beg
0400BD             0114*       rst.lil $18
0400BD             0115*       jp @end
0400BD             0116*   @beg:
0400BD             0117*   ;   VDU 23, 0, &A0, sid; &49, 4, mid; n; i0; ... : Set Mesh Texture Coordinate Indexes
0400BD             0118*       db 23,0,$A0
0400BD             0119*       dw SID
0400BD             0120*       db $49,4
0400BD             0121*       dw MESH_ID, INDICES_N
0400BD             0122*   @end:
0400BD             0123*       ld hl,UV_INDICES
0400BD             0124*       ld bc,INDICES_N*2 ; 2 bytes per index
0400BD             0125*       rst.lil $18
0400BD             0126*       ENDMACRO
0400BD             0127*   
0400BD             0128*   ; CREATE OBJECT
0400BD             0129*       MACRO CO SID, OID, MESH_ID, BITMAP_ID
0400BD             0130*       ld hl,@beg
0400BD             0131*       ld bc,@end-@beg
0400BD             0132*       rst.lil $18
