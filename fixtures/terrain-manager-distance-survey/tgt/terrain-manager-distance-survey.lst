04297E             0225*       SURVEY_LOAD_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_y
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_y 
04297E 3A 4C 9D 04 0001*M1         ld a,(ADDRESS)
042982 6F          0002*M1         ld l,a
