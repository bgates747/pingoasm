040CEB             1807*   ; Apply Pingo-order Euler rotations to one signed 16-bit vec3 in place.
040CEB             1808*   ;
040CEB             1809*   ; Rotation order is X, then Y, then Z, matching Pingo transform construction.
040CEB             1810*   ;
040CEB             1811*   ; inputs:
040CEB             1812*   ;   ix -> six-byte source/destination vec3
040CEB             1813*   ;   iy -> six-byte angle vec3 (X, Y, Z)
040CEB             1814*   ; outputs:
040CEB             1815*   ;   rotated vec3 at (ix)
040CEB             1816*   ;   carry clear on success
040CEB             1817*   ;   carry set on arithmetic overflow
040CEB             1818*   ; destroys:
040CEB             1819*   ;   af, af', bc, de, hl, bc', de', hl'
040CEB             1820*   ; note:
040CEB             1821*   ;   The vector is restored to its original value if any axis fails.
040CEB             1822*   p3d_vec3_rotate_xyz16:
040CEB             1823*   ; Snapshot the vector and all angles before any in-place write.
040CEB DD 6E 00    1824*       ld l,(ix+p3d_vec3_x)
