040A2A DD 66 05    1544*       ld h,(ix+p3d_vec3_z+1)
040A2D FD 5E 04    1545*       ld e,(iy+p3d_vec3_z)
040A30 FD 56 05    1546*       ld d,(iy+p3d_vec3_z+1)
