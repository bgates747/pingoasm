040A12 D8          1534*       ret c
040A13 E5          1535*       push hl
040A14 DD 6E 02    1536*       ld l,(ix+p3d_vec3_y)
040A17 DD 66 03    1537*       ld h,(ix+p3d_vec3_y+1)
040A1A FD 5E 02    1538*       ld e,(iy+p3d_vec3_y)
040A1D FD 56 03    1539*       ld d,(iy+p3d_vec3_y+1)
