040A02             1511*   ; Translate one signed 16-bit vec3 in place.
040A02             1512*   ;
040A02             1513*   ; This performs component-wise integer addition. Both operands must use the
040A02             1514*   ; same Pingo domain, normally translation-distance units.
040A02             1515*   ;
040A02             1516*   ; inputs:
040A02             1517*   ;   ix -> six-byte source/destination vec3
040A02             1518*   ;   iy -> six-byte translation vec3
040A02             1519*   ; outputs:
040A02             1520*   ;   (ix) = (ix) + (iy)
040A02             1521*   ;   carry clear on success
040A02             1522*   ;   carry set if any signed component overflows
040A02             1523*   ;   vector is unchanged on overflow
040A02             1524*   ; destroys:
040A02             1525*   ;   af, bc, de, hl
040A02             1526*   ; preserves:
040A02             1527*   ;   ix, iy, and all shadow registers
040A02             1528*   p3d_vec3_translate16:
040A02 DD 6E 00    1529*       ld l,(ix+p3d_vec3_x)
040A05 DD 66 01    1530*       ld h,(ix+p3d_vec3_x+1)
040A08 FD 5E 00    1531*       ld e,(iy+p3d_vec3_x)
040A0B FD 56 01    1532*       ld d,(iy+p3d_vec3_x+1)
