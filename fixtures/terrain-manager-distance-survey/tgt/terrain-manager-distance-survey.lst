040322             0603*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
040322             0604*   ; inputs: a=format; bc=width; de=height
040322             0605*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
040322             0606*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
040322             0607*   ; 0 	RGBA8888 (4-bytes per pixel)
040322             0608*   ; 1 	RGBA2222 (1-bytes per pixel)
040322             0609*   ; 2 	Mono/Mask (1-bit per pixel)
040322             0610*   ; 3 	Reserved for internal use by VDP (“native” format)
040322             0611*   vdu_bmp_create:
040322 21 40 03 04 0612*       ld hl,@width
040326             0613*       ST_U16_BC_ADV
                       M1 Args: none
