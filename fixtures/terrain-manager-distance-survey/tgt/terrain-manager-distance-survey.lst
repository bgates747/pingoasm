040000             0034    
040000             0035    ; Universal-manager policy.  This client supplies no flight dynamics,
040000             0036    ; collision, aircraft, or non-terrain scenery assumptions.
040000             0037    terrain_manager_slot_count: equ 183
040000             0038    terrain_manager_max_ring: equ 5
040000             0039    terrain_manager_initial_ring: equ 5
040000             0040    terrain_manager_mesh_id_base: equ 1
040000             0041    terrain_manager_object_id_base: equ 1
040000             0042    
040000             0043    ; Command 53 carries the complete unsigned word.  At the terrain convention of
040000             0044    ; eight metres per Pingo unit this is about 524 km; resident rings and later
040000             0045    ; LOD policy, rather than the projection plane, still bound submitted geometry.
040000             0046    manager_survey_projection_far_units: equ 65535
040000             0047    
040000             0048    manager_survey_slot_count: equ terrain_manager_slot_count
040000             0049    manager_survey_default_radius: equ terrain_manager_initial_ring
040000             0050    manager_survey_mesh_base: equ terrain_manager_mesh_id_base
040000             0051    manager_survey_object_base: equ terrain_manager_object_id_base
040000             0052    
040000             0053    ; Preserve the visually reviewed Berkeley Marina pose, but express it in its
040000             0054    ; actual containing cell so the first manager publication needs no corrective
040000             0055    ; origin rebase.  The view is 500 m above the source datum, facing almost due
040000             0056    ; south and pitched down twenty degrees.
040000             0057    manager_survey_start_q: equ 80
040000             0058    manager_survey_start_r: equ 125
040000             0059    camera_initial_x: equ 4275
040000             0060    camera_initial_y: equ 8000
040000             0061    camera_initial_z: equ 466
040000             0062    camera_initial_pitch: equ -1820
040000             0063    camera_initial_yaw: equ 8192
040000             0064    
040000             0065    ; The complete NAT corpus uses the provider's true Bay Area q/r bounds.  The
040000             0066    ; historical Campanile and Marina extractions remain separate build artifacts,
040000             0067    ; but no experimental disk fence limits this regional viewer.
040000             0068    hex_provider_fixture_bounds_enabled: equ 0
040000             0069    hex_provider_fixture_center_q: equ manager_survey_start_q
040000             0070    hex_provider_fixture_center_r: equ manager_survey_start_r
040000             0071    hex_provider_fixture_radius: equ 5
040000             0072    hex_provider_natural_namespace: equ 1
