047ABA             0001*   ; =============================================================================
047ABA             0002*   ; Stable Pingo terrain slots for the reusable-manager survey fixture.
047ABA             0003*   ;
047ABA             0004*   ; The fixture reserves the complete radius-five axial hex disk, but
047ABA             0005*   ; every slot starts inactive.  Runtime-patched packets keep mesh and object
047ABA             0006*   ; identifiers genuinely 16-bit; the setup loop must not silently become an
047ABA             0007*   ; eight-bit-ID implementation merely because this first pool begins at one.
047ABA             0008*   ; Command 50 can subsequently replace each placeholder mesh atomically.
047ABA             0009*   ; =============================================================================
047ABA             0010*   
047ABA             0011*       MACRO MANAGER_SCENE_STORE_U16_HL ADDRESS
047ABA             0012*           ld a,l
047ABA             0013*           ld (ADDRESS),a
047ABA             0014*           ld a,h
047ABA             0015*           ld (ADDRESS+1),a
047ABA             0016*       ENDMACRO
047ABA             0017*   
047ABA             0018*       MACRO MANAGER_SCENE_LOAD_U16_HL ADDRESS
047ABA             0019*           ld hl,0
047ABA             0020*           ld a,(ADDRESS)
047ABA             0021*           ld l,a
047ABA             0022*           ld a,(ADDRESS+1)
047ABA             0023*           ld h,a
047ABA             0024*       ENDMACRO
047ABA             0025*   
047ABA             0026*       MACRO MANAGER_SCENE_LOAD_U16_DE ADDRESS
047ABA             0027*           ld de,0
047ABA             0028*           ld a,(ADDRESS)
047ABA             0029*           ld e,a
047ABA             0030*           ld a,(ADDRESS+1)
047ABA             0031*           ld d,a
047ABA             0032*       ENDMACRO
047ABA             0033*   
047ABA             0034*   manager_survey_establish_scene_slots:
047ABA 21 01 00 00 0035*       ld hl,manager_survey_mesh_base
047ABE             0036*       MANAGER_SCENE_STORE_U16_HL terrain_scene_next_mesh_id
                       M1 Args: ADDRESS=terrain_scene_next_mesh_id 
