04034F 21 5A 03 04 0633*       ld hl,@cmd
040353 01 06 00 00 0634*       ld bc,@end-@cmd
040357 5B DF       0635*       rst.lil $18
040359 C9          0636*       ret
04035A             0637*   @cmd:
04035A 17 00 A0    0638*       db 23,0,$A0
04035D 00 00       0639*   @bufferId: dw 0
04035F 0E          0640*       db 14
040360             0641*   @end:
040360             0642*   ; &E8-&EF 	232-239 	Bitmap plot §
040360             0643*   plot_bmp: equ 0xE8
040360             0644*   ; 5 	Plot absolute in current foreground colour
040360             0645*   dr_abs_fg: equ 5
040360             0646*   
040360             0647*   ; inputs: hl = bufferId, ix = file size ; iy = pointer to filename
040360             0648*   vdu_load_buffer_from_file:
040360             0649*   ; load buffer ids
040360 7D          0650*       ld a,l
040361 32 98 03 04 0651*       ld (@id0),a
040365 32 ED 03 04 0652*       ld (@id1),a
040369 7C          0653*       ld a,h
04036A 32 99 03 04 0654*       ld (@id0+1),a
04036E 32 EE 03 04 0655*       ld (@id1+1),a
040372             0656*   ; load filesize from ix
040372 DD 22 18 04 0657*       ld (@filesize),ix
       04          
040377 ED 4B 18 04 0658*       ld bc,(@filesize) ; for the mos_load call
       04          
04037C             0659*   ; load the file from disk into ram
04037C FD E5       0660*       push iy
04037E E1          0661*   	pop hl ; pointer to filename
04037F 11 94 9D 04 0662*   	ld de,filedata
040383 3E 01       0663*   	ld a,mos_load
040385 5B CF       0664*   	RST.LIL 08h
040387             0665*   ; clear target buffer
040387 21 95 03 04 0666*       ld hl,@clear0
04038B 01 06 00 00 0667*       ld bc,@clear1-@clear0
04038F 5B DF       0668*       rst.lil $18
040391 C3 9B 03 04 0669*       jp @clear1
040395 17 00 A0    0670*   @clear0: db 23,0,0xA0
040398 00 00       0671*   @id0:	dw 0x0000 ; bufferId
04039A 02          0672*   		db 2 ; clear buffer
04039B             0673*   @clear1:
04039B             0674*   ; load default chunk size of 256 bytes
04039B AF          0675*       xor a
04039C 32 F0 03 04 0676*       ld (@chunksize),a
0403A0 3E 01       0677*       ld a,1
0403A2 32 F1 03 04 0678*       ld (@chunksize+1),a
0403A6             0679*   ; point hl at the start of the file data
0403A6 21 94 9D 04 0680*       ld hl,filedata
0403AA 22 1B 04 04 0681*       ld (@chunkpointer),hl
0403AE             0682*   @loop:
0403AE 2A 18 04 04 0683*       ld hl,(@filesize) ; get the remaining bytes
0403B2 11 00 01 00 0684*       ld de,256
0403B6 AF          0685*       xor a ; clear carry
0403B7 ED 52       0686*       sbc hl,de
0403B9 22 18 04 04 0687*       ld (@filesize),hl ; store remaining bytes
0403BD CA DC 03 04 0688*       jp z,@loadchunk ; jp means will return to caller from there
0403C1 FA CD 03 04 0689*       jp m,@lastchunk ; ditto
0403C5 CD DC 03 04 0690*       call @loadchunk ; load the next chunk and return here to loop again
0403C9 C3 AE 03 04 0691*       jp @loop ; loop back to load the next chunk
0403CD             0692*   @lastchunk:
0403CD 11 00 01 00 0693*       ld de,256
0403D1 19          0694*       add hl,de
0403D2 7D          0695*       ld a,l
0403D3 32 F0 03 04 0696*       ld (@chunksize),a ; store the remaining bytes
0403D7 7C          0697*       ld a,h
0403D8 32 F1 03 04 0698*       ld (@chunksize+1),a
0403DC             0699*       ; fall through to loadchunk
0403DC             0700*   @loadchunk:
0403DC 21 EA 03 04 0701*       ld hl,@chunk0
0403E0 01 08 00 00 0702*       ld bc,@chunk1-@chunk0
0403E4 5B DF       0703*       rst.lil $18
0403E6 C3 F2 03 04 0704*       jp @chunk1
0403EA             0705*   @chunk0:
0403EA             0706*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
0403EA 17 00 A0    0707*   		db 23,0,0xA0
0403ED 00 00       0708*   @id1:	dw 0x0000 ; bufferId
0403EF 00          0709*   		db 0 ; load buffer
0403F0 00 00       0710*   @chunksize:	dw 0x0000 ; length of data in bytes
0403F2             0711*   @chunk1:
0403F2 2A 1B 04 04 0712*       ld hl,(@chunkpointer) ; get the file data pointer
0403F6 01 00 00 00 0713*       ld bc,0 ; make sure bcu is zero
0403FA 3A F0 03 04 0714*       ld a,(@chunksize)
0403FE 4F          0715*       ld c,a
0403FF 3A F1 03 04 0716*       ld a,(@chunksize+1)
040403 47          0717*       ld b,a
040404 5B DF       0718*       rst.lil $18
040406 2A 1B 04 04 0719*       ld hl,(@chunkpointer) ; get the file data pointer
04040A 01 00 01 00 0720*       ld bc,256
04040E 09          0721*       add hl,bc ; advance the file data pointer
04040F 22 1B 04 04 0722*       ld (@chunkpointer),hl ; store pointer to file data
040413 3E 2E       0723*       ld a,'.' ; print a progress breadcrumb
040415 5B D7       0724*       rst.lil 10h
040417 C9          0725*       ret
040418 00 00 00    0726*   @filesize: dl 0 ; file size in bytes
04041B 00 00 00    0727*   @chunkpointer: dl 0 ; pointer to current chunk
04041E             0098        include "../../berkeley-flight-triangular-dither/src/agon/3d.inc"
04041E             0001*   ; eZ80-local integer 3D arithmetic for Pingo-compatible values
04041E             0002*   ;
04041E             0003*   ; Scalar arithmetic, forward/inverse trigonometric lookup, vector and matrix
04041E             0004*   ; transforms, persistent object-pose integration, stateful camera look-at,
04041E             0005*   ; and dirty Pingo command synchronization are implemented below. Include
04041E             0006*   ; 3d_sincos_table.inc after this file so its forward table references resolve.
04041E             0007*   ;
04041E             0008*   ; Pingo wire values are little-endian 16-bit quantities:
04041E             0009*   ;
04041E             0010*   ;   mesh coordinate: signed normalized, value = raw / 32767
04041E             0011*   ;   rotation angle:  signed turns,      radians = raw * 2*pi / 32767
04041E             0012*   ;   translation:     signed distance,   value = raw * 256 / 32767
04041E             0013*   ;   scale:           unsigned 8.8,      value = raw / 256
04041E             0014*   ;
04041E             0015*   ; A local vec3 occupies six bytes. Its component interpretation is supplied
04041E             0016*   ; by the operation; the layout itself does not encode a numeric domain.
04041E             0017*   
04041E             0018*   p3d_vec3_x:       equ 0
04041E             0019*   p3d_vec3_y:       equ 2
04041E             0020*   p3d_vec3_z:       equ 4
04041E             0021*   p3d_vec3_size:    equ 6
04041E             0022*   p3d_norm_max:     equ 32767
04041E             0023*   p3d_norm_half_up: equ 16384
04041E             0024*   
04041E             0025*   ; A row-major signed-Q15 matrix occupies 18 bytes.
04041E             0026*   p3d_mat3_r0c0:    equ 0
04041E             0027*   p3d_mat3_r0c1:    equ 2
04041E             0028*   p3d_mat3_r0c2:    equ 4
04041E             0029*   p3d_mat3_r1c0:    equ 6
04041E             0030*   p3d_mat3_r1c1:    equ 8
04041E             0031*   p3d_mat3_r1c2:    equ 10
04041E             0032*   p3d_mat3_r2c0:    equ 12
04041E             0033*   p3d_mat3_r2c1:    equ 14
04041E             0034*   p3d_mat3_r2c2:    equ 16
04041E             0035*   p3d_mat3_size:    equ 18
04041E             0036*   
04041E             0037*   ; Packed eZ80-side state for one Pingo object. The eZ80 owns this complete
04041E             0038*   ; state; Pingo receives absolute create/scale/rotation/translation commands.
04041E             0039*   ; All word and aggregate fields start at even offsets.
04041E             0040*   p3d_object_dirty:                    equ 0
04041E             0041*   p3d_object_reserved:                 equ 1
04041E             0042*   p3d_object_sid:                      equ 2
04041E             0043*   p3d_object_oid:                      equ 4
04041E             0044*   p3d_object_mid:                      equ 6
04041E             0045*   p3d_object_bmid:                     equ 8
04041E             0046*   p3d_object_world_position:           equ 10
04041E             0047*   p3d_object_pingo_translation:        equ p3d_object_world_position
04041E             0048*   p3d_object_pingo_rotation:           equ 16
04041E             0049*   p3d_object_scale:                    equ 22
04041E             0050*   p3d_object_orientation:              equ 28
04041E             0051*   p3d_object_local_linear_velocity:    equ 46
04041E             0052*   p3d_object_local_angular_velocity:   equ 52
04041E             0053*   p3d_object_angular_residual:         equ 58
04041E             0054*   p3d_object_size:                     equ 64
04041E             0055*   
04041E             0056*   ; The four-word input tuple accepted by p3d_object_init16 has the same ID
04041E             0057*   ; offsets relative to its own base, minus the two-byte state header.
04041E             0058*   p3d_object_ids_sid:                  equ 0
04041E             0059*   p3d_object_ids_oid:                  equ 2
04041E             0060*   p3d_object_ids_mid:                  equ 4
04041E             0061*   p3d_object_ids_bmid:                 equ 6
04041E             0062*   p3d_object_ids_size:                 equ 8
04041E             0063*   
04041E             0064*   p3d_object_dirty_position:           equ 0x01
04041E             0065*   p3d_object_dirty_rotation:           equ 0x02
04041E             0066*   p3d_object_dirty_scale:              equ 0x04
04041E             0067*   p3d_object_dirty_create:             equ 0x08
04041E             0068*   p3d_object_dirty_pose:               equ 0x03
04041E             0069*   p3d_object_dirty_all:                equ 0x0f
04041E             0070*   
04041E             0071*   ; Packed eZ80-side state for one Pingo camera. Camera commands describe a
04041E             0072*   ; world pose, just like object commands; Pingo inverts that pose internally
04041E             0073*   ; when constructing the view matrix. The orientation is retained so later
04041E             0074*   ; camera-local movement can use the same matrix/vector primitives as objects.
04041E             0075*   p3d_camera_dirty:                    equ 0
04041E             0076*   p3d_camera_look_flags:               equ 1
04041E             0077*   p3d_camera_sid:                      equ 2
04041E             0078*   p3d_camera_world_position:           equ 4
04041E             0079*   p3d_camera_pingo_translation:        equ p3d_camera_world_position
04041E             0080*   p3d_camera_pingo_rotation:           equ 10
04041E             0081*   p3d_camera_orientation:              equ 16
04041E             0082*   p3d_camera_pole_yaw:                 equ 34
04041E             0083*   p3d_camera_size:                     equ 36
04041E             0084*   
04041E             0085*   p3d_camera_dirty_position:           equ 0x01
04041E             0086*   p3d_camera_dirty_rotation:           equ 0x02
04041E             0087*   p3d_camera_dirty_all:                equ 0x03
04041E             0088*   
04041E             0089*   ; Known look-at state bits. Unknown bits are caller-owned and preserved.
04041E             0090*   p3d_camera_look_valid:               equ 0x01
04041E             0091*   p3d_camera_look_in_pole:             equ 0x02
04041E             0092*   p3d_camera_look_inverted:            equ 0x04
04041E             0093*   p3d_camera_look_known:               equ 0x07
04041E             0094*   
04041E             0095*   ; Required A-register policy for each camera aim call.
04041E             0096*   p3d_camera_roll_upright:             equ 0
04041E             0097*   p3d_camera_roll_continuous:          equ 1
04041E             0098*   p3d_camera_roll_policy_count:        equ 2
04041E             0099*   
04041E             0100*   ; Current buffered-command Pingo selector and absolute object subcommands.
04041E             0101*   p3d_pingo_command:                   equ 0x49
04041E             0102*   p3d_pingo_create_object:             equ 5
04041E             0103*   p3d_pingo_set_object_xyz_scale:      equ 9
04041E             0104*   p3d_pingo_set_object_xyz_rotation:   equ 13
04041E             0105*   p3d_pingo_set_object_xyz_translation: equ 17
04041E             0106*   p3d_pingo_create_packet_size:        equ 13
04041E             0107*   p3d_pingo_update_packet_size:        equ 15
04041E             0108*   
04041E             0109*   ; ---------------------------------------------------------------------------
04041E             0110*   ; Scalar arithmetic primitives
04041E             0111*   ; ---------------------------------------------------------------------------
04041E             0112*   
04041E             0113*   ; Unsigned 16-bit by unsigned 16-bit multiplication.
04041E             0114*   ;
04041E             0115*   ; inputs:
04041E             0116*   ;   hl = unsigned 16-bit multiplicand (H:L; UHL ignored)
04041E             0117*   ;   de = unsigned 16-bit multiplier (D:E; UDE ignored)
04041E             0118*   ; outputs:
04041E             0119*   ;   hl:de = unsigned 32-bit product in bytes H:L:D:E
04041E             0120*   ; destroys:
04041E             0121*   ;   af, bc
04041E             0122*   ; preserves:
04041E             0123*   ;   bc', de', hl'
04041E             0124*   p3d_umul16x16_32:
04041E 43          0125*       ld b,e
04041F 4D          0126*       ld c,l
040420 6B          0127*       ld l,e
040421 59          0128*       ld e,c
040422 ED 4C       0129*       mlt bc                  ; bc = low * low
040424 78          0130*       ld a,b                  ; save product byte 1
040425 44          0131*       ld b,h                  ; prepare high * high
040426 ED 6C       0132*       mlt hl                  ; hl = high * low
040428 85          0133*       add a,l
040429 6F          0134*       ld l,a
04042A 8C          0135*       adc a,h
04042B 95          0136*       sub a,l
04042C 67          0137*       ld h,a
04042D 79          0138*       ld a,c                  ; save product byte 0
04042E 4A          0139*       ld c,d                  ; bc = high:high
04042F ED 5C       0140*       mlt de                  ; de = low * high
040431 52 19       0141*       add.s hl,de             ; accumulate middle bytes
040433 5F          0142*       ld e,a
040434 55          0143*       ld d,l
040435 6C          0144*       ld l,h
040436 26 00       0145*       ld h,0
040438 CB 14       0146*       rl h                    ; carry from middle-byte accumulation
04043A ED 4C       0147*       mlt bc                  ; bc = high * high
04043C 52 09       0148*       add.s hl,bc
04043E C9          0149*       ret
04043F             0150*   
04043F             0151*   ; Signed 16-bit by signed 16-bit multiplication.
04043F             0152*   ;
04043F             0153*   ; inputs:
04043F             0154*   ;   hl = signed 16-bit multiplicand (H:L; UHL ignored)
04043F             0155*   ;   de = signed 16-bit multiplier (D:E; UDE ignored)
04043F             0156*   ; outputs:
04043F             0157*   ;   hl:de = signed 32-bit product in bytes H:L:D:E
04043F             0158*   ;   carry clear on success
04043F             0159*   ; destroys:
04043F             0160*   ;   af, af', bc
04043F             0161*   ; preserves:
04043F             0162*   ;   bc', de', hl'
04043F             0163*   p3d_smul16x16_32:
04043F             0164*   ; park the product sign in the shadow flags
04043F 7C          0165*       ld a,h
040440 AA          0166*       xor d
040441 08          0167*       ex af,af'
040442             0168*   ; absolute value of hl
040442 CB 7C       0169*       bit 7,h
040444 28 07       0170*       jr z,@hl_positive
040446 AF          0171*       xor a
040447 95          0172*       sub l
040448 6F          0173*       ld l,a
040449 3E 00       0174*       ld a,0                  ; ld preserves carry
04044B 9C          0175*       sbc a,h
04044C 67          0176*       ld h,a
04044D             0177*   @hl_positive:
04044D             0178*   ; absolute value of de
04044D CB 7A       0179*       bit 7,d
04044F 28 07       0180*       jr z,@de_positive
040451 AF          0181*       xor a
040452 93          0182*       sub e
040453 5F          0183*       ld e,a
040454 3E 00       0184*       ld a,0
040456 9A          0185*       sbc a,d
040457 57          0186*       ld d,a
040458             0187*   @de_positive:
040458 CD 1E 04 04 0188*       call p3d_umul16x16_32
04045C             0189*   ; restore the sign flags
04045C 08          0190*       ex af,af'
04045D F0          0191*       ret p
04045E             0192*   ; negate logical H:L:D:E
04045E AF          0193*       xor a
04045F 93          0194*       sub e
040460 5F          0195*       ld e,a
040461 3E 00       0196*       ld a,0
040463 9A          0197*       sbc a,d
040464 57          0198*       ld d,a
040465 3E 00       0199*       ld a,0
040467 9D          0200*       sbc a,l
040468 6F          0201*       ld l,a
040469 3E 00       0202*       ld a,0
04046B 9C          0203*       sbc a,h
04046C 67          0204*       ld h,a
04046D B7          0205*       or a                    ; success: carry clear
04046E C9          0206*       ret
04046F             0207*   
04046F             0208*   ; Add two signed 32-bit values held in opposite GP register banks.
04046F             0209*   ;
04046F             0210*   ; inputs:
04046F             0211*   ;   active hl:de = right/addend in bytes H:L:D:E
04046F             0212*   ;   shadow hl:de = left/accumulator in bytes H':L':D':E'
04046F             0213*   ; outputs:
04046F             0214*   ;   hl:de = left + right
04046F             0215*   ;   the opposite GP register bank is active on return
04046F             0216*   ;   carry clear on success
04046F             0217*   ;   carry set on signed overflow
04046F             0218*   ; destroys:
04046F             0219*   ;   af and both hl:de banks
04046F             0220*   ; preserves:
04046F             0221*   ;   af' and both bc banks
04046F             0222*   p3d_sadd32:
04046F             0223*   ; low byte
04046F 7B          0224*       ld a,e
040470 D9          0225*       exx
040471 83          0226*       add a,e
040472 5F          0227*       ld e,a
040473             0228*   ; middle-low byte
040473 D9          0229*       exx
040474 7A          0230*       ld a,d
040475 D9          0231*       exx
040476 8A          0232*       adc a,d
040477 57          0233*       ld d,a
040478             0234*   ; middle-high byte
040478 D9          0235*       exx
040479 7D          0236*       ld a,l
04047A D9          0237*       exx
04047B 8D          0238*       adc a,l
04047C 6F          0239*       ld l,a
04047D             0240*   ; high byte
04047D D9          0241*       exx
04047E 7C          0242*       ld a,h
04047F D9          0243*       exx
040480 8C          0244*       adc a,h
040481 67          0245*       ld h,a
040482             0246*   ; the final byte operation owns the signed-overflow flag
040482 EA 88 04 04 0247*       jp pe,@overflow
040486 B7          0248*       or a                    ; success: carry clear
040487 C9          0249*       ret
040488             0250*   @overflow:
040488 37          0251*       scf
040489 C9          0252*       ret
04048A             0253*   
04048A             0254*   ; Subtract two signed 32-bit values held in opposite GP register banks.
04048A             0255*   ;
04048A             0256*   ; inputs:
04048A             0257*   ;   active hl:de = right/subtrahend in bytes H:L:D:E
04048A             0258*   ;   shadow hl:de = left/minuend in bytes H':L':D':E'
04048A             0259*   ; outputs:
04048A             0260*   ;   hl:de = left - right
04048A             0261*   ;   the opposite GP register bank is active on return
04048A             0262*   ;   carry clear on success
04048A             0263*   ;   carry set on signed overflow
04048A             0264*   ; destroys:
04048A             0265*   ;   af and both hl:de banks
04048A             0266*   ; preserves:
04048A             0267*   ;   af' and both bc banks
04048A             0268*   p3d_ssub32:
04048A             0269*   ; low byte: left + ~right + 1
04048A 7B          0270*       ld a,e
04048B 2F          0271*       cpl
04048C 37          0272*       scf
04048D D9          0273*       exx
04048E 8B          0274*       adc a,e
04048F 5F          0275*       ld e,a
040490             0276*   ; middle-low byte
040490 D9          0277*       exx
040491 7A          0278*       ld a,d
040492 2F          0279*       cpl
040493 D9          0280*       exx
040494 8A          0281*       adc a,d
040495 57          0282*       ld d,a
040496             0283*   ; middle-high byte
040496 D9          0284*       exx
040497 7D          0285*       ld a,l
040498 2F          0286*       cpl
040499 D9          0287*       exx
04049A 8D          0288*       adc a,l
04049B 6F          0289*       ld l,a
04049C             0290*   ; high byte
04049C D9          0291*       exx
04049D 7C          0292*       ld a,h
04049E 2F          0293*       cpl
04049F D9          0294*       exx
0404A0 8C          0295*       adc a,h
0404A1 67          0296*       ld h,a
0404A2             0297*   ; the final byte operation owns the signed-overflow flag
0404A2 EA A8 04 04 0298*       jp pe,@overflow
0404A6 B7          0299*       or a                    ; success: carry clear
0404A7 C9          0300*       ret
0404A8             0301*   @overflow:
0404A8 37          0302*       scf
0404A9 C9          0303*       ret
0404AA             0304*   
0404AA             0305*   ; Reduce a signed 32-bit product by Pingo's signed-normalized divisor.
0404AA             0306*   ;
0404AA             0307*   ; This is the narrowing operation needed after multiplying a coordinate by a
0404AA             0308*   ; normalized sine, cosine, or matrix coefficient:
0404AA             0309*   ;
0404AA             0310*   ;   result = round(product / 32767)
0404AA             0311*   ;
0404AA             0312*   ; inputs:
0404AA             0313*   ;   hl:de = signed 32-bit product in bytes H:L:D:E
0404AA             0314*   ; outputs:
0404AA             0315*   ;   hl = signed 16-bit result in H:L
0404AA             0316*   ;   carry clear on success
0404AA             0317*   ;   carry set if the rounded result is outside -32768..32767
0404AA             0318*   ; destroys:
0404AA             0319*   ;   af, af', bc, de
0404AA             0320*   ; preserves:
0404AA             0321*   ;   bc', de', hl'
0404AA             0322*   p3d_sdiv32767_32_to_16:
0404AA             0323*   ; park the input sign in the shadow accumulator
0404AA 7C          0324*       ld a,h
0404AB E6 80       0325*       and 0x80
0404AD 08          0326*       ex af,af'
0404AE             0327*   ; form the unsigned magnitude in H:L:D:E
0404AE CB 7C       0328*       bit 7,h
0404B0 28 0F       0329*       jr z,@magnitude_ready
0404B2 AF          0330*       xor a
0404B3 93          0331*       sub e
0404B4 5F          0332*       ld e,a
0404B5 3E 00       0333*       ld a,0
0404B7 9A          0334*       sbc a,d
0404B8 57          0335*       ld d,a
0404B9 3E 00       0336*       ld a,0
0404BB 9D          0337*       sbc a,l
0404BC 6F          0338*       ld l,a
0404BD 3E 00       0339*       ld a,0
