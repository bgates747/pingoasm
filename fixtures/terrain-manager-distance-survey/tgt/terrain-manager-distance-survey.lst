0427D3             0100        include "../../berkeley-flight-triangular-dither/src/camera-survey-input.inc"
0427D3             0001*   ; =============================================================================
0427D3             0002*   ; Direct, upright camera controls for the Berkeley terrain survey fixture.
0427D3             0003*   ;
0427D3             0004*   ; There is deliberately no proxy object, velocity integrator, flight model, or
0427D3             0005*   ; collision query in this path.  Each 30 Hz quantum decodes held keys into one
0427D3             0006*   ; commanded displacement and an absolute pitch/yaw update.  Horizontal motion
0427D3             0007*   ; is rotated by yaw alone; pitch can therefore never turn forward motion into
0427D3             0008*   ; a climb or dive, and Page Up/Down remain exact world-Y translations.
0427D3             0009*   ; =============================================================================
0427D3             0010*   
0427D3             0011*   ; ADL warning: an unsuffixed multi-byte memory load/store is 24-bit.  Every
0427D3             0012*   ; scalar below is a wire-compatible 16-bit word and is transferred bytewise.
0427D3             0013*       MACRO SURVEY_LOAD_HL ADDRESS
0427D3             0014*           ld a,(ADDRESS)
0427D3             0015*           ld l,a
0427D3             0016*           ld a,(ADDRESS+1)
0427D3             0017*           ld h,a
0427D3             0018*       ENDMACRO
0427D3             0019*   
0427D3             0020*       MACRO SURVEY_STORE_HL ADDRESS
0427D3             0021*           ld a,l
0427D3             0022*           ld (ADDRESS),a
0427D3             0023*           ld a,h
0427D3             0024*           ld (ADDRESS+1),a
0427D3             0025*       ENDMACRO
0427D3             0026*   
0427D3             0027*       MACRO SURVEY_NEGATE_HL
0427D3             0028*           xor a
0427D3             0029*           sub l
0427D3             0030*           ld l,a
0427D3             0031*           ld a,0
0427D3             0032*           sbc a,h
0427D3             0033*           ld h,a
0427D3             0034*       ENDMACRO
0427D3             0035*   
0427D3             0036*   ; Establish exactly the same initial pose as fixture 3.  p3d_camera_init16
0427D3             0037*   ; copies camera_initial_position and supplies zero Euler rotation, zero roll,
0427D3             0038*   ; and an identity retained orientation.
0427D3             0039*   init_camera_survey:
0427D3 21 20 00 00 0040*       ld hl,survey_translation_rate_initial
0427D7             0041*       SURVEY_STORE_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
0427D7 7D          0001*M1         ld a,l
0427D8 32 6A 9D 04 0002*M1         ld (ADDRESS),a
0427DC 7C          0003*M1         ld a,h
0427DD 32 6B 9D 04 0004*M1         ld (ADDRESS+1),a
0427E1 AF          0042*       xor a
0427E2 32 6C 9D 04 0043*       ld (survey_speed_keys_down),a
0427E6 DD 21 40 9D 0044*       ld ix,camera_state
       04          
0427EB FD 21 3A 9D 0045*       ld iy,camera_initial_position
       04          
0427F0 21 C3 06 00 0046*       ld hl,sid
0427F4 CD 90 1B 04 0047*       call p3d_camera_init16
0427F8 C3 AB 9B 04 0048*       jp sync_camera_state
0427FC             0049*   
0427FC             0050*   ; One deterministic input quantum.  Changing the speed setting alone does not
0427FC             0051*   ; dirty the camera or request a redundant render.
0427FC             0052*   simulate_camera_step:
0427FC CD 08 28 04 0053*       call survey_update_translation_rate
042800 CD 8A 28 04 0054*       call survey_update_rotation
042804 C3 99 29 04 0055*       jp survey_update_translation
042808             0056*   
042808             0057*   ; Minus and Equals choose the next slower/faster power-of-two rate only on a
042808             0058*   ; rising edge.  Holding a key cannot race through the ladder; opposed keys
042808             0059*   ; cancel.  MOS maps main Minus to byte 2 bit 7 and main Equals/Plus to byte 11
042808             0060*   ; bit 5 (BBC physical key 94).
042808             0061*   survey_update_translation_rate:
042808 DD 21 5C 00 0062*       ld ix,keyboard_masks
       04          
04280D 06 00       0063*       ld b,0
04280F DD CB 02 7E 0064*       bit 7,(ix+2)                       ; Minus
042813 28 02       0065*       jr z,@minus_ready
042815 CB C0       0066*       set 0,b
042817             0067*   @minus_ready:
042817 DD CB 0B 6E 0068*       bit 5,(ix+11)                      ; Equals
04281B 28 02       0069*       jr z,@current_ready
04281D CB C8       0070*       set 1,b
04281F             0071*   @current_ready:
04281F 3A 6C 9D 04 0072*       ld a,(survey_speed_keys_down)
042823 4F          0073*       ld c,a                             ; C = preceding held state
042824 78          0074*       ld a,b
042825 32 6C 9D 04 0075*       ld (survey_speed_keys_down),a
042829 FE 03       0076*       cp 3
04282B C8          0077*       ret z                              ; opposed keys cancel
04282C 79          0078*       ld a,c
04282D 2F          0079*       cpl
04282E A0          0080*       and b                              ; A = newly pressed keys
04282F FE 01       0081*       cp 1
042831 28 05       0082*       jr z,survey_translation_rate_down
042833 FE 02       0083*       cp 2
042835 28 2A       0084*       jr z,survey_translation_rate_up
042837 C9          0085*       ret
042838             0086*   
042838             0087*   survey_translation_rate_down:
042838             0088*       SURVEY_LOAD_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
042838 3A 6A 9D 04 0001*M1         ld a,(ADDRESS)
04283C 6F          0002*M1         ld l,a
04283D 3A 6B 9D 04 0003*M1         ld a,(ADDRESS+1)
042841 67          0004*M1         ld h,a
042842 CB 3C       0089*       srl h
042844 CB 1D       0090*       rr l
042846 E5          0091*       push hl
042847 11 08 00 00 0092*       ld de,survey_translation_rate_min
04284B B7          0093*       or a
04284C 52 ED 52    0094*       sbc.s hl,de
04284F E1          0095*       pop hl
042850 30 04       0096*       jr nc,@store
042852 21 08 00 00 0097*       ld hl,survey_translation_rate_min
042856             0098*   @store:
042856             0099*       SURVEY_STORE_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
042856 7D          0001*M1         ld a,l
042857 32 6A 9D 04 0002*M1         ld (ADDRESS),a
04285B 7C          0003*M1         ld a,h
04285C 32 6B 9D 04 0004*M1         ld (ADDRESS+1),a
042860 C9          0100*       ret
042861             0101*   
042861             0102*   survey_translation_rate_up:
042861             0103*       SURVEY_LOAD_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
042861 3A 6A 9D 04 0001*M1         ld a,(ADDRESS)
042865 6F          0002*M1         ld l,a
042866 3A 6B 9D 04 0003*M1         ld a,(ADDRESS+1)
04286A 67          0004*M1         ld h,a
04286B 52 29       0104*       add.s hl,hl
04286D E5          0105*       push hl
04286E 11 00 01 00 0106*       ld de,survey_translation_rate_max
042872 B7          0107*       or a
042873 52 ED 52    0108*       sbc.s hl,de
042876 E1          0109*       pop hl
042877 38 06       0110*       jr c,@store
042879 28 04       0111*       jr z,@store
04287B 21 00 01 00 0112*       ld hl,survey_translation_rate_max
04287F             0113*   @store:
04287F             0114*       SURVEY_STORE_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
04287F 7D          0001*M1         ld a,l
042880 32 6A 9D 04 0002*M1         ld (ADDRESS),a
042884 7C          0003*M1         ld a,h
042885 32 6B 9D 04 0004*M1         ld (ADDRESS+1),a
042889 C9          0115*       ret
04288A             0116*   
04288A             0117*   ; Arrow keys own absolute camera pitch/yaw. Camera Euler angles act inversely
04288A             0118*   ; on the view: Up/Left subtract from the rendered pitch/yaw, while Down/Right
04288A             0119*   ; add. Opposed keys cancel. Pitch is held
04288A             0120*   ; one raw angle word short of either exact vertical, and roll is forcibly zero
04288A             0121*   ; whenever an angular command is applied.
04288A             0122*   survey_update_rotation:
04288A AF          0123*       xor a
04288B 32 6D 9D 04 0124*       ld (survey_rotation_changed),a
04288F DD 21 5C 00 0125*       ld ix,keyboard_masks
       04          
042894             0126*   
042894 DD CB 07 4E 0127*       bit 1,(ix+7)                       ; Up
042898 28 0C       0128*       jr z,@down_only
04289A DD CB 05 4E 0129*       bit 1,(ix+5)                       ; Down
04289E 20 16       0130*       jr nz,@pitch_done
0428A0 CD 03 29 04 0131*       call survey_pitch_up
0428A4 18 0A       0132*       jr @pitch_changed
0428A6             0133*   @down_only:
0428A6 DD CB 05 4E 0134*       bit 1,(ix+5)
0428AA 28 0A       0135*       jr z,@pitch_done
0428AC CD 32 29 04 0136*       call survey_pitch_down
0428B0             0137*   @pitch_changed:
0428B0 3E 01       0138*       ld a,1
0428B2 32 6D 9D 04 0139*       ld (survey_rotation_changed),a
0428B6             0140*   @pitch_done:
0428B6             0141*   
0428B6 DD CB 03 4E 0142*       bit 1,(ix+3)                       ; Left
0428BA 28 0C       0143*       jr z,@right_only
0428BC DD CB 0F 4E 0144*       bit 1,(ix+15)                      ; Right
0428C0 20 16       0145*       jr nz,@yaw_done
0428C2 CD 63 29 04 0146*       call survey_yaw_left
0428C6 18 0A       0147*       jr @yaw_changed
0428C8             0148*   @right_only:
0428C8 DD CB 0F 4E 0149*       bit 1,(ix+15)
0428CC 28 0A       0150*       jr z,@yaw_done
0428CE CD 7E 29 04 0151*       call survey_yaw_right
0428D2             0152*   @yaw_changed:
0428D2 3E 01       0153*       ld a,1
0428D4 32 6D 9D 04 0154*       ld (survey_rotation_changed),a
0428D8             0155*   @yaw_done:
0428D8             0156*   
0428D8 3A 6D 9D 04 0157*       ld a,(survey_rotation_changed)
0428DC B7          0158*       or a
0428DD C8          0159*       ret z
0428DE             0160*   
0428DE             0161*   ; The no-roll invariant is executable rather than merely conventional.
0428DE AF          0162*       xor a
0428DF 32 4E 9D 04 0163*       ld (camera_state+p3d_camera_pingo_rotation+p3d_vec3_z),a
0428E3 32 4F 9D 04 0164*       ld (camera_state+p3d_camera_pingo_rotation+p3d_vec3_z+1),a
0428E7             0165*   
0428E7             0166*   ; Keep the retained camera orientation coherent with the emitted Euler words.
0428E7             0167*   ; This closed form is Ry(yaw)*Rx(pitch), explicitly with roll zero.
0428E7 DD 21 50 9D 0168*       ld ix,camera_state+p3d_camera_orientation
       04          
0428EC FD 21 4A 9D 0169*       ld iy,camera_state+p3d_camera_pingo_rotation
       04          
0428F1 CD BF 12 04 0170*       call p3d_camera_mat3_from_euler_fine16
0428F5 DD 21 40 9D 0171*       ld ix,camera_state
       04          
0428FA DD 7E 00    0172*       ld a,(ix+p3d_camera_dirty)
0428FD F6 02       0173*       or p3d_camera_dirty_rotation
0428FF DD 77 00    0174*       ld (ix+p3d_camera_dirty),a
042902 C9          0175*       ret
042903             0176*   
042903             0177*   survey_pitch_up:
042903             0178*       SURVEY_LOAD_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042903 3A 4A 9D 04 0001*M1         ld a,(ADDRESS)
042907 6F          0002*M1         ld l,a
042908 3A 4B 9D 04 0003*M1         ld a,(ADDRESS+1)
04290C 67          0004*M1         ld h,a
04290D 11 68 FF FF 0179*       ld de,-survey_angular_step
042911 52 19       0180*       add.s hl,de
042913             0181*   ; The bound comparison must be signed.  A plain unsigned compare would treat
042913             0182*   ; every positive pitch as "below" 0xe001 and snap directly to -8191 when the
042913             0183*   ; pilot reversed away from the positive limit.
042913 CB 7C       0184*       bit 7,h
042915 28 10       0185*       jr z,@store
042917 E5          0186*       push hl
042918 11 01 E0 FF 0187*       ld de,-survey_pitch_limit
04291C B7          0188*       or a
04291D 52 ED 52    0189*       sbc.s hl,de
042920 E1          0190*       pop hl
042921 30 04       0191*       jr nc,@store
042923 21 01 E0 FF 0192*       ld hl,-survey_pitch_limit
042927             0193*   @store:
042927             0194*       SURVEY_STORE_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042927 7D          0001*M1         ld a,l
042928 32 4A 9D 04 0002*M1         ld (ADDRESS),a
04292C 7C          0003*M1         ld a,h
04292D 32 4B 9D 04 0004*M1         ld (ADDRESS+1),a
042931 C9          0195*       ret
042932             0196*   
042932             0197*   survey_pitch_down:
042932             0198*       SURVEY_LOAD_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042932 3A 4A 9D 04 0001*M1         ld a,(ADDRESS)
042936 6F          0002*M1         ld l,a
042937 3A 4B 9D 04 0003*M1         ld a,(ADDRESS+1)
04293B 67          0004*M1         ld h,a
04293C 11 98 00 00 0199*       ld de,survey_angular_step
042940 52 19       0200*       add.s hl,de
042942             0201*   ; Likewise, a negative candidate is already below the positive upper bound.
042942             0202*   ; Guarding its sign prevents a reversal from -8191 snapping to +8191.
042942 CB 7C       0203*       bit 7,h
042944 20 12       0204*       jr nz,@store
042946 E5          0205*       push hl
042947 11 FF 1F 00 0206*       ld de,survey_pitch_limit
04294B B7          0207*       or a
04294C 52 ED 52    0208*       sbc.s hl,de
04294F E1          0209*       pop hl
042950 38 06       0210*       jr c,@store
042952 28 04       0211*       jr z,@store
042954 21 FF 1F 00 0212*       ld hl,survey_pitch_limit
042958             0213*   @store:
042958             0214*       SURVEY_STORE_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042958 7D          0001*M1         ld a,l
042959 32 4A 9D 04 0002*M1         ld (ADDRESS),a
04295D 7C          0003*M1         ld a,h
04295E 32 4B 9D 04 0004*M1         ld (ADDRESS+1),a
042962 C9          0215*       ret
042963             0216*   
