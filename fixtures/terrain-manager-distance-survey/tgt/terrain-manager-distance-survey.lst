040A9D             1666*       ld e,l
040A9D             1667*       ld d,h
040A9D             1668*       push iy
040A9D             1669*       pop hl
040A9D             1670*       ld (ix+p3d_vec3_y),l
040A9D             1671*       ld (ix+p3d_vec3_y+1),h
040A9D             1672*       ld (ix+p3d_vec3_z),e
040A9D             1673*       ld (ix+p3d_vec3_z+1),d
040A9D             1674*       pop iy
040A9D             1675*       or a
040A9D             1676*       ret
