0400BD             0134*   @beg:
0400BD             0135*   ;   VDU 23, 0, &A0, sid; &49, 5, oid; mid; bmid; :  Create Object
0400BD             0136*       db 23,0,$A0
0400BD             0137*       dw SID
0400BD             0138*       db $49,5
0400BD             0139*       dw OID
0400BD             0140*       dw MESH_ID
0400BD             0141*       dw BITMAP_ID
0400BD             0142*   @end:
0400BD             0143*       ENDMACRO
0400BD             0144*   
0400BD             0145*   ; SET OBJECT XYZ SCALE FACTORS
0400BD             0146*       MACRO SO SID, OID, SCALEX, SCALEY, SCALEZ
0400BD             0147*       ld hl,@beg
0400BD             0148*       ld bc,@end-@beg
0400BD             0149*       rst.lil $18
0400BD             0150*       jp @end
0400BD             0151*   @beg:
0400BD             0152*   ;   VDU 23, 0, &A0, sid%; &49, 9, oid%; scale; scale; scale; Set Object XYZ Scale Factors
0400BD             0153*       db 23,0,$A0
0400BD             0154*       dw SID
0400BD             0155*       db $49,9
0400BD             0156*       dw OID
0400BD             0157*       dw SCALEX
0400BD             0158*       dw SCALEY
0400BD             0159*       dw SCALEZ
0400BD             0160*   @end:
0400BD             0161*       ENDMACRO
0400BD             0162*   
0400BD             0163*   ; CREATE RENDER TARGET BITMAP RGBA8888 FORMAT
0400BD             0164*       MACRO CTB BMID, SCENE_WIDTH, SCENE_HEIGHT
0400BD             0165*       ld hl,@beg
0400BD             0166*       ld bc,@end-@beg
0400BD             0167*       rst.lil $18
0400BD             0168*       jp @end
0400BD             0169*   @beg:
0400BD             0170*   ;   VDU 23, 27, &20, bmid2% Select output bitmap
0400BD             0171*       db 23,27,$20
0400BD             0172*       dw BMID
0400BD             0173*   ;   VDU 23, 27, 2, cstw%; csth%; &0000; &00C0; Create solid color bitmap
0400BD             0174*       db 23,27,2
0400BD             0175*       dw SCENE_WIDTH
0400BD             0176*       dw SCENE_HEIGHT
0400BD             0177*       ; ff00ffff dark magenta full alpha
0400BD             0178*       db 0xff ; red
0400BD             0179*       db 0x00 ; green
0400BD             0180*       db 0xff ; blue
0400BD             0181*       db 0xff ; alpha
0400BD             0182*   @end:
0400BD             0183*       ENDMACRO
0400BD             0184*   
0400BD             0185*   ; CREATE RENDER TARGET BITMAP RGBA2222 FORMAT
0400BD             0186*       MACRO CTB2 BMID, SCENE_WIDTH, SCENE_HEIGHT
0400BD             0187*       ld hl,@beg
0400BD             0188*       ld bc,@end-@beg
0400BD             0189*       rst.lil $18
0400BD             0190*       jp @end
0400BD             0191*   @beg:
0400BD             0192*   ;   VDU 23, 27, &20, bmid2% Select output bitmap
0400BD             0193*       db 23,27,$20
0400BD             0194*       dw BMID
0400BD             0195*   ;   VDU 23, 27, &22, cstw%; csth%; color : Create solid color bitmap
0400BD             0196*       db 23,27,$22
0400BD             0197*       dw SCENE_WIDTH
0400BD             0198*       dw SCENE_HEIGHT
0400BD             0199*       db %11110011 ; opaque magenta (AABBGGRR)
0400BD             0200*   @end:
0400BD             0201*       ENDMACRO
0400BD             0202*   
0400BD             0203*   ; RENDER TO TARGET BITMAP
0400BD             0204*       MACRO RENDBMP SID, BMID
