042AF3             0041         include "render-async.inc"
042AF3             0001*    ; =============================================================================
042AF3             0002*    ; Qualified Pingo render-completion callback support.
042AF3             0003*    ;
042AF3             0004*    ; One render may be in flight. The interrupt callback only recognizes/copies
042AF3             0005*    ; the ten-byte P3DR payload and publishes byte flags; all VDU work remains in
042AF3             0006*    ; the foreground. Non-P3DR records continue through MOS keyboard handling.
042AF3             0007*    ; =============================================================================
042AF3             0008*    
042AF3             0009*    render_notify_token: equ 0C35Ah
042AF3             0010*    setup_barrier_value: equ 0A5h
042AF3             0011*    
042AF3             0012*    initialize_render_state:
042AF3 AF          0013*        xor a
042AF4 32 DD 2C 04 0014*        ld (render_in_flight),a
042AF8 32 DE 2C 04 0015*        ld (completion_ready),a
042AFC 32 F5 2C 04 0016*        ld (sequence_initialized),a
042B00 32 F6 2C 04 0017*        ld (exit_requested),a
042B04 32 F7 2C 04 0018*        ld (callback_error),a
042B08 32 F3 2C 04 0019*        ld (expected_sequence+0),a
042B0C 32 F4 2C 04 0020*        ld (expected_sequence+1),a
042B10 C9          0021*        ret
042B11             0022*    
042B11             0023*    ; Scene construction is asynchronous. General poll 0A5h fences those commands
042B11             0024*    ; before command 41 is enabled and the first render is submitted.
042B11             0025*    wait_for_setup_barrier:
042B11 DD 2A DA 2C 0026*        ld ix,(sysvars_pointer)
       04          
042B16 AF          0027*        xor a
042B17 DD 77 37    0028*        ld (ix+sysvar_gp),a
042B1A 21 31 2B 04 0029*        ld hl,@command
042B1E 01 04 00 00 0030*        ld bc,@end-@command
042B22 5B DF       0031*        rst.lil 18h
042B24             0032*    @wait:
042B24 DD 2A DA 2C 0033*        ld ix,(sysvars_pointer)
       04          
042B29 DD 7E 37    0034*        ld a,(ix+sysvar_gp)
042B2C FE A5       0035*        cp setup_barrier_value
042B2E 20 F4       0036*        jr nz,@wait
042B30 C9          0037*        ret
042B31             0038*    @command:
042B31 17 00 80 A5 0039*        db 23,0,080h,setup_barrier_value
042B35             0040*    @end:
042B35             0041*    
042B35             0042*    ; Publish in-flight state before any render byte reaches the VDP.
042B35             0043*    submit_current_render:
042B35 AF          0044*        xor a
042B36 32 DE 2C 04 0045*        ld (completion_ready),a
042B3A 3E 01       0046*        ld a,1
042B3C 32 DD 2C 04 0047*        ld (render_in_flight),a
042B40             0048*        RENDBMP sid,tgtbmid
                       M1 Args: SID=sid BMID=tgtbmid 
042B40 21 4E 2B 04 0001*M1      ld hl,@beg
042B44 01 09 00 00 0002*M1      ld bc,@end-@beg
042B48 5B DF       0003*M1      rst.lil $18
042B4A C3 57 2B 04 0004*M1      jp @end
042B4E             0005*M1  @beg:
042B4E             0006*M1  ;  1040 VDU 23, 0, &A0, sid%; &49, 38, bmid%; Render To Bitmap
042B4E 17 00 A0    0007*M1      db 23, 0, $A0
042B51 C3 06       0008*M1      dw SID
042B53 49 26       0009*M1      db $49, 38
042B55 01 01       0010*M1      dw BMID
042B57             0011*M1  @end:
042B57 C9          0049*        ret
042B58             0050*    
042B58             0051*    ; Atomically snapshot the callback mailbox, then validate version, event,
042B58             0052*    ; registration token, and monotonically increasing 16-bit sequence.
042B58             0053*    consume_render_completion:
042B58 F3          0054*        di
042B59 21 DF 2C 04 0055*        ld hl,completion_record
042B5D 11 E9 2C 04 0056*        ld de,completion_snapshot
042B61 01 0A 00 00 0057*        ld bc,10
042B65 ED B0       0058*        ldir
042B67 AF          0059*        xor a
042B68 32 DE 2C 04 0060*        ld (completion_ready),a
042B6C FB          0061*        ei
042B6D             0062*    
042B6D 3A ED 2C 04 0063*        ld a,(completion_snapshot+4)
042B71 FE 01       0064*        cp 1
042B73 20 7D       0065*        jr nz,@reject
042B75 3A EE 2C 04 0066*        ld a,(completion_snapshot+5)
042B79 FE 01       0067*        cp 1
042B7B 20 75       0068*        jr nz,@reject
042B7D 3A EF 2C 04 0069*        ld a,(completion_snapshot+6)
042B81 FE 5A       0070*        cp render_notify_token & 0FFh
042B83 20 6D       0071*        jr nz,@reject
042B85 3A F0 2C 04 0072*        ld a,(completion_snapshot+7)
042B89 FE C3       0073*        cp render_notify_token >> 8
042B8B 20 65       0074*        jr nz,@reject
042B8D             0075*    
042B8D 3A F5 2C 04 0076*        ld a,(sequence_initialized)
042B91 B7          0077*        or a
042B92 28 18       0078*        jr z,@accept_first_sequence
042B94 21 F1 2C 04 0079*        ld hl,completion_snapshot+8
042B98 FD 21 F3 2C 0080*        ld iy,expected_sequence
       04          
042B9D 7E          0081*        ld a,(hl)
042B9E FD BE 00    0082*        cp (iy+0)
042BA1 20 4F       0083*        jr nz,@reject
042BA3 23          0084*        inc hl
042BA4 7E          0085*        ld a,(hl)
042BA5 FD BE 01    0086*        cp (iy+1)
042BA8 20 48       0087*        jr nz,@reject
042BAA 18 18       0088*        jr @sequence_valid
042BAC             0089*    
042BAC             0090*    @accept_first_sequence:
042BAC 21 F1 2C 04 0091*        ld hl,completion_snapshot+8
042BB0 FD 21 F3 2C 0092*        ld iy,expected_sequence
       04          
042BB5 7E          0093*        ld a,(hl)
042BB6 FD 77 00    0094*        ld (iy+0),a
042BB9 23          0095*        inc hl
042BBA 7E          0096*        ld a,(hl)
042BBB FD 77 01    0097*        ld (iy+1),a
042BBE 3E 01       0098*        ld a,1
042BC0 32 F5 2C 04 0099*        ld (sequence_initialized),a
042BC4             0100*    
042BC4             0101*    @sequence_valid:
042BC4 CD FD 2B 04 0102*        call increment_expected_sequence
042BC8 F3          0103*        di
042BC9 AF          0104*        xor a
042BCA 32 DD 2C 04 0105*        ld (render_in_flight),a
042BCE FB          0106*        ei
042BCF             0107*    
042BCF             0108*    ; Display only a completed target. The following render command, if any, is
042BCF             0109*    ; queued after this display/flip sequence and may safely reuse one bitmap.
042BCF CD 9B 02 04 0110*        call vdu_clg
042BD3             0111*        DISPBMP tgtbmid,viewport_x,viewport_y
                       M1 Args: BMID=tgtbmid X=viewport_x Y=viewport_y 
042BD3 21 E1 2B 04 0001*M1      ld hl,@beg
042BD7 01 0C 00 00 0002*M1      ld bc,@end-@beg
042BDB 5B DF       0003*M1      rst.lil $18
042BDD C3 ED 2B 04 0004*M1      jp @end
042BE1             0005*M1  @beg:
042BE1             0006*M1  ;   VDU 23, 27, &20, bmid% Select output bitmap
042BE1 17 1B 20    0007*M1      db 23,27,$20
042BE4 01 01       0008*M1      dw BMID
042BE6             0009*M1  ;   VDU 23, 27, 3, 0; 0; Display output bitmap
042BE6 17 1B 03    0010*M1      db 23,27,3
042BE9 00 00 00 00 0011*M1      dw X,Y
042BED             0012*M1  @end:
042BED CD 8D 02 04 0112*        call vdu_flip
042BF1 C9          0113*        ret
042BF2             0114*    
042BF2             0115*    @reject:
042BF2             0116*    ; Keep render_in_flight asserted: returning while a completion producer may
042BF2             0117*    ; still exist is less safe than remaining resident for diagnosis.
042BF2 3E 01       0118*        ld a,1
042BF4 32 F7 2C 04 0119*        ld (callback_error),a
042BF8 32 F6 2C 04 0120*        ld (exit_requested),a
042BFC C9          0121*        ret
042BFD             0122*    
042BFD             0123*    increment_expected_sequence:
042BFD 21 F3 2C 04 0124*        ld hl,expected_sequence
042C01 34          0125*        inc (hl)
042C02 C0          0126*        ret nz
042C03 23          0127*        inc hl
042C04 34          0128*        inc (hl)
042C05 C9          0129*        ret
042C06             0130*    
042C06             0131*    install_render_callback:
042C06 21 46 2C 04 0132*        ld hl,render_packet_callback
042C0A 0E 00       0133*        ld c,0
042C0C             0134*        MOSCALL mos_setkbvector
                       M1 Args: function=mos_setkbvector 
042C0C 3E 1D       0001*M1          ld a,function
042C0E 5B CF       0002*M1          rst.lil 08h
042C10 C9          0135*        ret
042C11             0136*    
042C11             0137*    remove_render_callback:
042C11 21 00 00 00 0138*        ld hl,0
042C15 0E 00       0139*        ld c,0
042C17             0140*        MOSCALL mos_setkbvector
                       M1 Args: function=mos_setkbvector 
042C17 3E 1D       0001*M1          ld a,function
042C19 5B CF       0002*M1          rst.lil 08h
042C1B C9          0141*        ret
042C1C             0142*    
042C1C             0143*    enable_render_notifications:
042C1C 21 27 2C 04 0144*        ld hl,@command
042C20 01 0A 00 00 0145*        ld bc,@end-@command
042C24 5B DF       0146*        rst.lil 18h
042C26 C9          0147*        ret
042C27             0148*    @command:
042C27 17 00 A0    0149*        db 23,0,0A0h
042C2A C3 06       0150*        dw sid
042C2C 49 29 01    0151*        db 49h,41,1
042C2F 5A C3       0152*        dw render_notify_token
042C31             0153*    @end:
042C31             0154*    
042C31             0155*    disable_render_notifications:
042C31 21 3C 2C 04 0156*        ld hl,@command
042C35 01 0A 00 00 0157*        ld bc,@end-@command
042C39 5B DF       0158*        rst.lil 18h
042C3B C9          0159*        ret
042C3C             0160*    @command:
042C3C 17 00 A0    0161*        db 23,0,0A0h
042C3F C3 06       0162*        dw sid
042C41 49 29 00    0163*        db 49h,41,0
042C44 00 00       0164*        dw 0
042C46             0165*    @end:
042C46             0166*    
042C46             0167*    ; MOS invokes this from its UART interrupt path with DEU pointing at the
042C46             0168*    ; payload. It must not make MOS/VDU calls or perform foreground work.
042C46             0169*    render_packet_callback:
042C46 F5          0170*        push af
042C47 DD E5       0171*        push ix
042C49 FD E5       0172*        push iy
042C4B D5          0173*        push de
042C4C DD E1       0174*        pop ix
042C4E             0175*    
042C4E DD 7E 00    0176*        ld a,(ix+0)
042C51 FE 50       0177*        cp 'P'
042C53 20 6B       0178*        jr nz,@keyboard
042C55 DD 7E 01    0179*        ld a,(ix+1)
042C58 FE 33       0180*        cp '3'
042C5A 20 64       0181*        jr nz,@keyboard
042C5C DD 7E 02    0182*        ld a,(ix+2)
042C5F FE 44       0183*        cp 'D'
042C61 20 5D       0184*        jr nz,@keyboard
042C63 DD 7E 03    0185*        ld a,(ix+3)
042C66 FE 52       0186*        cp 'R'
042C68 20 56       0187*        jr nz,@keyboard
042C6A             0188*    
042C6A FD 21 DF 2C 0189*        ld iy,completion_record
       04          
042C6F DD 7E 00    0190*        ld a,(ix+0)
042C72 FD 77 00    0191*        ld (iy+0),a
042C75 DD 7E 01    0192*        ld a,(ix+1)
042C78 FD 77 01    0193*        ld (iy+1),a
042C7B DD 7E 02    0194*        ld a,(ix+2)
042C7E FD 77 02    0195*        ld (iy+2),a
042C81 DD 7E 03    0196*        ld a,(ix+3)
042C84 FD 77 03    0197*        ld (iy+3),a
042C87 DD 7E 04    0198*        ld a,(ix+4)
042C8A FD 77 04    0199*        ld (iy+4),a
042C8D DD 7E 05    0200*        ld a,(ix+5)
042C90 FD 77 05    0201*        ld (iy+5),a
042C93 DD 7E 06    0202*        ld a,(ix+6)
042C96 FD 77 06    0203*        ld (iy+6),a
042C99 DD 7E 07    0204*        ld a,(ix+7)
042C9C FD 77 07    0205*        ld (iy+7),a
042C9F DD 7E 08    0206*        ld a,(ix+8)
042CA2 FD 77 08    0207*        ld (iy+8),a
042CA5 DD 7E 09    0208*        ld a,(ix+9)
042CA8 FD 77 09    0209*        ld (iy+9),a
042CAB             0210*    
042CAB             0211*    ; MOS resumes normal keyboard processing after this callback. Turn the P3DR
042CAB             0212*    ; signature into a harmless null key-up record before returning.
042CAB AF          0213*        xor a
042CAC DD 77 00    0214*        ld (ix+0),a
042CAF DD 77 01    0215*        ld (ix+1),a
042CB2 DD 77 02    0216*        ld (ix+2),a
042CB5 DD 77 03    0217*        ld (ix+3),a
042CB8 3E 01       0218*        ld a,1
042CBA 32 DE 2C 04 0219*        ld (completion_ready),a
042CBE 18 14       0220*        jr @done
042CC0             0221*    
042CC0             0222*    @keyboard:
042CC0             0223*    ; An Escape key-down can request shutdown immediately, even between simulation
042CC0             0224*    ; quanta. The foreground still drains any outstanding render before returning.
042CC0 DD 7E 03    0225*        ld a,(ix+3)
042CC3 FE 01       0226*        cp 1
042CC5 20 0D       0227*        jr nz,@done
042CC7 DD 7E 00    0228*        ld a,(ix+0)
042CCA FE 1B       0229*        cp 27
042CCC 20 06       0230*        jr nz,@done
042CCE 3E 01       0231*        ld a,1
042CD0 32 F6 2C 04 0232*        ld (exit_requested),a
042CD4             0233*    
042CD4             0234*    @done:
042CD4 FD E1       0235*        pop iy
042CD6 DD E1       0236*        pop ix
042CD8 F1          0237*        pop af
042CD9 C9          0238*        ret
042CDA             0239*    
042CDA             0240*    sysvars_pointer:
042CDA 00 00 00    0241*        dl 0
042CDD             0242*    
042CDD             0243*    render_in_flight:
042CDD 00          0244*        db 0
042CDE             0245*    
042CDE             0246*    completion_ready:
042CDE 00          0247*        db 0
042CDF             0248*    
042CDF             0249*    completion_record:
042CDF             0250*        ds 10
042CE9             0251*    
042CE9             0252*    completion_snapshot:
042CE9             0253*        ds 10
042CF3             0254*    
042CF3             0255*    expected_sequence:
042CF3             0256*        ds 2
042CF5             0257*    
042CF5             0258*    sequence_initialized:
       FF FF FF FF 
       FF FF FF FF 
       FF FF FF FF 
       FF FF FF FF 
       FF FF FF FF 
       FF FF 
042CF5 00          0259*        db 0
042CF6             0260*    
042CF6             0261*    exit_requested:
042CF6 00          0262*        db 0
042CF7             0263*    
042CF7             0264*    callback_error:
042CF7 00          0265*        db 0
042CF8             0042     
042CF8             0043     waitKeypress:
042CF8             0044         MOSCALL mos_getkey
                       M1 Args: function=mos_getkey 
042CF8 3E 00       0001M1           ld a,function
042CFA 5B CF       0002M1           rst.lil 08h
042CFC C9          0045         ret
042CFD             0046     
042CFD             0047         MACRO OT SID, OID, X, Y, Z
042CFD             0048             ld hl,@beg
042CFD             0049             ld bc,@end-@beg
042CFD             0050             rst.lil 18h
042CFD             0051             jp @end
042CFD             0052     @beg:
042CFD             0053             db 23,0,0A0h
042CFD             0054             dw SID
