041D16 FD 77 09    3610*        ld (iy+9),a
041D19             3611*    @restore_canonical:
041D19 FD 7E 12    3612*        ld a,(iy+18)
041D1C FD 77 00    3613*        ld (iy+0),a
041D1F FD 7E 13    3614*        ld a,(iy+19)
041D22 FD 77 01    3615*        ld (iy+1),a
041D25 FD 7E 0F    3616*        ld a,(iy+15)
041D28 FD 77 0C    3617*        ld (iy+12),a
041D2B FD 7E 10    3618*        ld a,(iy+16)
041D2E FD 77 0D    3619*        ld (iy+13),a
041D31 C9          3620*        ret
041D32             3621*    
041D32             3622*    ; Aim a Pingo camera at one world-space point.
041D32             3623*    ;
041D32             3624*    ; inputs:
041D32             3625*    ;   ix -> p3d camera state
041D32             3626*    ;   iy -> target world-position vec3
041D32             3627*    ;   a  = required roll policy:
041D32             3628*    ;          p3d_camera_roll_upright
041D32             3629*    ;          p3d_camera_roll_continuous
041D32             3630*    ; outputs:
041D32             3631*    ;   absolute Pingo Euler words and matching local-to-world matrix updated
041D32             3632*    ;   rotation dirty set iff the emitted Euler bytes changed
041D32             3633*    ;   carry clear on success
041D32             3634*    ;   carry set for an invalid policy or coincident camera/target, with the
041D32             3635*    ;   complete camera state unchanged
041D32             3636*    ; destroys:
041D32             3637*    ;   af, af', bc, de, hl, bc', de', hl'
041D32             3638*    ; preserves:
041D32             3639*    ;   ix, iy and the target vec3
041D32             3640*    ;
041D32             3641*    ; The solver first retains roughly eleven direction bits by scaling all three
041D32             3642*    ; exact sign/magnitude differences into a common 1024..2047 maximum. Thus
041D32             3643*    ; x^2+z^2 is below 2^23. The pole cone is scale-independent: enter when
041D32             3644*    ; horizontal <= |dy|/32 and leave only when horizontal > |dy|/16.
041D32             3645*    ;
041D32             3646*    ; Upright mode emits pitch=atan2(dy,horizontal), yaw=atan2(-dx,-dz), roll=0.
041D32             3647*    ; Continuous mode retains the equivalent inverted Euler branch after a pole
041D32             3648*    ; crossing, allowing pitch to pass through +/-90 degrees without a 180-degree
041D32             3649*    ; frame twist. Inside the hysteresis band the last reliable canonical yaw is
041D32             3650*    ; retained and pitch is the exact vertical cardinal.
041D32             3651*    p3d_camera_look_at_point16:
041D32             3652*    p3d_camera_aim_at_point16:
041D32 FE 02       3653*        cp p3d_camera_roll_policy_count
041D34 38 02       3654*        jr c,@policy_valid
041D36 37          3655*        scf
041D37 C9          3656*        ret
041D38             3657*    @policy_valid:
041D38 4F          3658*        ld c,a                  ; p3d difference helper preserves BC
041D39 FD E5       3659*        push iy
041D3B 06 00       3660*        ld b,0                  ; component sign bits X/Y/Z
041D3D             3661*    ; Exact X magnitude/sign.
041D3D FD 6E 00    3662*        ld l,(iy+p3d_vec3_x)
041D40 FD 66 01    3663*        ld h,(iy+p3d_vec3_x+1)
041D43 DD 5E 04    3664*        ld e,(ix+p3d_camera_world_position+p3d_vec3_x)
041D46 DD 56 05    3665*        ld d,(ix+p3d_camera_world_position+p3d_vec3_x+1)
041D49 CD FD 1B 04 3666*        call p3d_lookat_difference_magnitude16
041D4D B7          3667*        or a
041D4E 28 02       3668*        jr z,@x_sign_ready
041D50 CB C0       3669*        set 0,b
041D52             3670*    @x_sign_ready:
041D52 23          3671*        inc hl
041D53 52 2B       3672*        dec.s hl
041D55 E5          3673*        push hl
041D56             3674*    ; Exact Y magnitude/sign.
041D56 FD 6E 02    3675*        ld l,(iy+p3d_vec3_y)
041D59 FD 66 03    3676*        ld h,(iy+p3d_vec3_y+1)
041D5C DD 5E 06    3677*        ld e,(ix+p3d_camera_world_position+p3d_vec3_y)
041D5F DD 56 07    3678*        ld d,(ix+p3d_camera_world_position+p3d_vec3_y+1)
041D62 CD FD 1B 04 3679*        call p3d_lookat_difference_magnitude16
041D66 B7          3680*        or a
041D67 28 02       3681*        jr z,@y_sign_ready
