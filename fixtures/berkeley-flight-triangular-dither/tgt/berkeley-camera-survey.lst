041C1F             3459*    ; Add one half turn and return the canonical signed half-turn representative.
041C1F             3460*    ; Input is one canonical p3d_atan2_fine16 result in -16384..16383.
041C1F             3461*    ; input/output: HL; destroys AF,DE; preserves indexes/shadows.
041C1F             3462*    p3d_lookat_add_half_turn16:
041C1F 11 00 40 00 3463*        ld de,16384
041C23 52 19       3464*        add.s hl,de
041C25 CB 74       3465*        bit 6,h
041C27 C8          3466*        ret z
041C28 CB FC       3467*        set 7,h
041C2A C9          3468*        ret
041C2B             3469*    
041C2B             3470*    ; Select the exact upside-down Euler representation of the same look
041C2B             3471*    ; direction. Work offsets are private to p3d_camera_aim_at_point16.
041C2B             3472*    ;
041C2B             3473*    ; inputs:
041C2B             3474*    ;   ix -> camera state
041C2B             3475*    ;   iy -> look-at work frame
041C2B             3476*    ;   work +0 = canonical pitch, work +12 = canonical yaw
041C2B             3477*    ; outputs:
041C2B             3478*    ;   those words replaced by the equivalent inverted pitch/yaw
041C2B             3479*    ; destroys:
041C2B             3480*    ;   af, de, hl
041C2B             3481*    p3d_lookat_select_inverted16:
041C2B FD 6E 00    3482*        ld l,(iy+0)
041C2E FD 66 01    3483*        ld h,(iy+1)
041C31 7C          3484*        ld a,h
041C32 B5          3485*        or l
041C33 20 12       3486*        jr nz,@nonzero_pitch
041C35             3487*    ; At the ambiguous half turn, retain the sign approached by the previous
041C35             3488*    ; camera pitch. Both words aim identically, but this avoids a raw-word jump.
041C35 DD CB 0B 7E 3489*        bit 7,(ix+p3d_camera_pingo_rotation+p3d_vec3_x+1)
041C39 20 06       3490*        jr nz,@negative_half
041C3B 21 00 40 00 3491*        ld hl,16384
041C3F 18 1E       3492*        jr @pitch_ready
041C41             3493*    @negative_half:
041C41 21 00 C0 FF 3494*        ld hl,-16384
041C45 18 18       3495*        jr @pitch_ready
041C47             3496*    @nonzero_pitch:
