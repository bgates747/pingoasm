042A8C 3A A2 2F 04 0003*M1          ld a,(ADDRESS+1)
042A90 67          0004*M1          ld h,a
042A91             0304*        SURVEY_STORE_HL survey_translation_delta+p3d_vec3_y
                       M1 Args: ADDRESS=survey_translation_delta+p3d_vec3_y 
