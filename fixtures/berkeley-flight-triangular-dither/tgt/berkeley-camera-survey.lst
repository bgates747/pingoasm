041C49 20 0B       3498*        jr nz,@negative_pitch
041C4B EB          3499*        ex de,hl
041C4C 21 00 40 00 3500*        ld hl,16384
041C50 B7          3501*        or a
041C51 52 ED 52    3502*        sbc.s hl,de
041C54 18 09       3503*        jr @pitch_ready
041C56             3504*    @negative_pitch:
041C56 EB          3505*        ex de,hl
041C57 21 00 C0 FF 3506*        ld hl,-16384
