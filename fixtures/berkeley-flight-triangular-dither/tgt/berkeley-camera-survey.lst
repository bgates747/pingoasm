042A85 20 37       0302*        jr nz,@translation_ready
042A87             0303*        SURVEY_LOAD_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
042A87 3A A1 2F 04 0001*M1          ld a,(ADDRESS)
