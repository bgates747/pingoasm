041C5C 52 ED 52    3508*        sbc.s hl,de
041C5F             3509*    @pitch_ready:
041C5F FD 75 00    3510*        ld (iy+0),l
041C62 FD 74 01    3511*        ld (iy+1),h
041C65 FD 6E 0C    3512*        ld l,(iy+12)
041C68 FD 66 0D    3513*        ld h,(iy+13)
