041B90             3349*    
041B90             3350*    ; Initialize one camera state.
041B90             3351*    ;
041B90             3352*    ; inputs:
041B90             3353*    ;   ix -> destination p3d camera state
041B90             3354*    ;   iy -> initial world-position vec3
041B90             3355*    ;   hl = Pingo scene/control ID
041B90             3356*    ; outputs:
041B90             3357*    ;   copied ID/position, zero Euler pose, identity orientation, valid upright
041B90             3358*    ;   look frame, and both camera dirty bits set
041B90             3359*    ;   carry clear
041B90             3360*    ; destroys:
041B90             3361*    ;   af, bc, de, hl
041B90             3362*    ; preserves:
041B90             3363*    ;   ix, iy and all shadow registers
041B90             3364*    ; note:
041B90             3365*    ;   The position may alias the destination; every input is captured first.
041B90             3366*    p3d_camera_init16:
041B90 DD E5       3367*        push ix
041B92 FD E5       3368*        push iy
041B94 E5          3369*        push hl
041B95 FD 6E 00    3370*        ld l,(iy+p3d_vec3_x)
041B98 FD 66 01    3371*        ld h,(iy+p3d_vec3_x+1)
041B9B E5          3372*        push hl
041B9C FD 6E 02    3373*        ld l,(iy+p3d_vec3_y)
041B9F FD 66 03    3374*        ld h,(iy+p3d_vec3_y+1)
041BA2 E5          3375*        push hl
041BA3 FD 6E 04    3376*        ld l,(iy+p3d_vec3_z)
041BA6 FD 66 05    3377*        ld h,(iy+p3d_vec3_z+1)
041BA9 E5          3378*        push hl
041BAA             3379*    ; Seed byte zero, then replicate it over the remaining camera state.
041BAA AF          3380*        xor a
041BAB DD 77 00    3381*        ld (ix+0),a
041BAE DD E5       3382*        push ix
041BB0 E1          3383*        pop hl
041BB1 DD E5       3384*        push ix
041BB3 D1          3385*        pop de
041BB4 13          3386*        inc de
041BB5 01 23 00 00 3387*        ld bc,p3d_camera_size-1
041BB9 ED B0       3388*        ldir
041BBB             3389*    ; Restore position Z/Y/X and scene ID.
041BBB E1          3390*        pop hl
041BBC DD 75 08    3391*        ld (ix+p3d_camera_world_position+p3d_vec3_z),l
041BBF DD 74 09    3392*        ld (ix+p3d_camera_world_position+p3d_vec3_z+1),h
041BC2 E1          3393*        pop hl
041BC3 DD 75 06    3394*        ld (ix+p3d_camera_world_position+p3d_vec3_y),l
041BC6 DD 74 07    3395*        ld (ix+p3d_camera_world_position+p3d_vec3_y+1),h
041BC9 E1          3396*        pop hl
041BCA DD 75 04    3397*        ld (ix+p3d_camera_world_position+p3d_vec3_x),l
