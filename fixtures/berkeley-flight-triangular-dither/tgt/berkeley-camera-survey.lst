041CCB CD 2B 1C 04 3578*        call p3d_lookat_select_inverted16
041CCF FD 6E 00    3579*        ld l,(iy+0)
041CD2 FD 66 01    3580*        ld h,(iy+1)
041CD5 DD 5E 0A    3581*        ld e,(ix+p3d_camera_pingo_rotation+p3d_vec3_x)
041CD8 DD 56 0B    3582*        ld d,(ix+p3d_camera_pingo_rotation+p3d_vec3_x+1)
041CDB CD 76 1C 04 3583*        call p3d_lookat_abs_angle_delta16
041CDF E5          3584*        push hl
041CE0 FD 6E 0C    3585*        ld l,(iy+12)
041CE3 FD 66 0D    3586*        ld h,(iy+13)
041CE6 DD 5E 0C    3587*        ld e,(ix+p3d_camera_pingo_rotation+p3d_vec3_y)
041CE9 DD 56 0D    3588*        ld d,(ix+p3d_camera_pingo_rotation+p3d_vec3_y+1)
