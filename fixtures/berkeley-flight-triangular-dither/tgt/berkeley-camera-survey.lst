040E15 ED 32 06    2008*        lea ix,ix+6
040E18 CD 92 0E 04 2009*        call p3d_mat3_dot_row_col16
040E1C DA 86 0E 04 2010*        jp c,@result6_failed
040E20 E5          2011*        push hl
