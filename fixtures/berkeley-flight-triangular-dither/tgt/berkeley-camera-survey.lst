040E4D E1          2029*        pop hl
040E4E DD 75 0C    2030*        ld (ix+p3d_mat3_r2c0),l
040E51 DD 74 0D    2031*        ld (ix+p3d_mat3_r2c0+1),h
040E54 E1          2032*        pop hl
040E55 DD 75 0A    2033*        ld (ix+p3d_mat3_r1c2),l
040E58 DD 74 0B    2034*        ld (ix+p3d_mat3_r1c2+1),h
