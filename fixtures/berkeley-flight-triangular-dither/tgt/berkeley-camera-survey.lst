041424 CD 57 06 04 2647*        call p3d_atan2_16
041428 FD 75 00    2648*        ld (iy+p3d_vec3_x),l
04142B FD 74 01    2649*        ld (iy+p3d_vec3_x+1),h
04142E E1          2650*        pop hl
04142F FD 75 02    2651*        ld (iy+p3d_vec3_y),l
041432 FD 74 03    2652*        ld (iy+p3d_vec3_y+1),h
