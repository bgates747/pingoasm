041C8C FD 77 12    3554*        ld (iy+18),a
041C8F FD 7E 01    3555*        ld a,(iy+1)
041C92 FD 77 13    3556*        ld (iy+19),a
041C95 FD 7E 0C    3557*        ld a,(iy+12)
041C98 FD 77 0F    3558*        ld (iy+15),a
041C9B FD 7E 0D    3559*        ld a,(iy+13)
041C9E FD 77 10    3560*        ld (iy+16),a
041CA1             3561*    ; Upright distance = |pitch-prev_x| + |yaw-prev_y|.
041CA1 FD 6E 00    3562*        ld l,(iy+0)
041CA4 FD 66 01    3563*        ld h,(iy+1)
041CA7 DD 5E 0A    3564*        ld e,(ix+p3d_camera_pingo_rotation+p3d_vec3_x)
041CAA DD 56 0B    3565*        ld d,(ix+p3d_camera_pingo_rotation+p3d_vec3_x+1)
041CAD CD 76 1C 04 3566*        call p3d_lookat_abs_angle_delta16
041CB1 E5          3567*        push hl
041CB2 FD 6E 0C    3568*        ld l,(iy+12)
041CB5 FD 66 0D    3569*        ld h,(iy+13)
041CB8 DD 5E 0C    3570*        ld e,(ix+p3d_camera_pingo_rotation+p3d_vec3_y)
041CBB DD 56 0D    3571*        ld d,(ix+p3d_camera_pingo_rotation+p3d_vec3_y+1)
041CBE CD 76 1C 04 3572*        call p3d_lookat_abs_angle_delta16
041CC2 D1          3573*        pop de
041CC3 52 19       3574*        add.s hl,de
041CC5 FD 75 06    3575*        ld (iy+6),l
041CC8 FD 74 07    3576*        ld (iy+7),h
