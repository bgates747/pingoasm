040DEB ED 33 FC    1994*        lea iy,iy-4
040DEE ED 32 06    1995*        lea ix,ix+6
040DF1 CD 92 0E 04 1996*        call p3d_mat3_dot_row_col16
040DF5 DA 89 0E 04 1997*        jp c,@result3_failed
040DF9 E5          1998*        push hl
040DFA ED 33 02    1999*        lea iy,iy+2
040DFD CD 92 0E 04 2000*        call p3d_mat3_dot_row_col16
040E01 DA 88 0E 04 2001*        jp c,@result4_failed
040E05 E5          2002*        push hl
040E06 ED 33 02    2003*        lea iy,iy+2
