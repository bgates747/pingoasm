0400BD             0227*        dw BMID
0400BD             0228*    ;   VDU 23, 27, 3, 0; 0; Display output bitmap
0400BD             0229*        db 23,27,3
0400BD             0230*        dw X,Y
0400BD             0231*    @end:
0400BD             0232*        ENDMACRO
