042CFD             0060     main:
042CFD 21 20 2F 04 0061         ld hl,title
042D01 CD 3B 02 04 0062         call printString
042D05             0063     ; These are the exact immutable resources and publication order used by FSIM
042D05             0064     ; fixture 3, so its first view is a direct visual control for this fixture.
042D05 21 B8 0B 00 0065         ld hl,pingo_flat_patterns_buffer_id
042D09 DD 21 E0 07 0066         ld ix,pingo_flat_patterns_bytes
       00          
042D0E FD 21 C4 2F 0067         ld iy,terrain_patterns_file
       04          
042D13 CD 60 03 04 0068         call vdu_load_buffer_from_file
042D17 21 B8 0B 00 0069         ld hl,pingo_flat_patterns_buffer_id
042D1B CD 45 03 04 0070         call vdu_consolidate_buffer
042D1F 21 B9 0B 00 0071         ld hl,pingo_flat_lookup_buffer_id
042D23 DD 21 F0 00 0072         ld ix,pingo_flat_lookup_bytes
       00          
042D28 FD 21 DB 2F 0073         ld iy,terrain_pattern_lookup_file
       04          
042D2D CD 60 03 04 0074         call vdu_load_buffer_from_file
042D31 21 B9 0B 00 0075         ld hl,pingo_flat_lookup_buffer_id
042D35 CD 45 03 04 0076         call vdu_consolidate_buffer
042D39 01 04 00 00 0077         ld bc,4
042D3D 11 04 00 00 0078         ld de,4
042D41 21 00 01 00 0079         ld hl,terrain_bmid
042D45 DD 21 10 00 0080         ld ix,16
       00          
042D4A FD 21 A9 2F 0081         ld iy,terrain_texture
       04          
042D4F 3E 01       0082         ld a,1
042D51 CD B1 02 04 0083         call vdu_load_img
042D55             0084         CTB2 tgtbmid,viewport_width,viewport_height
                       M1 Args: BMID=tgtbmid SCENE_WIDTH=viewport_width SCENE_HEIGHT=viewport_height 
042D55 21 63 2D 04 0001M1       ld hl,@beg
042D59 01 0D 00 00 0002M1       ld bc,@end-@beg
042D5D 5B DF       0003M1       rst.lil $18
042D5F C3 70 2D 04 0004M1       jp @end
042D63             0005M1   @beg:
042D63             0006M1   ;   VDU 23, 27, &20, bmid2% Select output bitmap
042D63 17 1B 20    0007M1       db 23,27,$20
042D66 01 01       0008M1       dw BMID
042D68             0009M1   ;   VDU 23, 27, &22, cstw%; csth%; color : Create solid color bitmap
042D68 17 1B 22    0010M1       db 23,27,$22
042D6B 40 01       0011M1       dw SCENE_WIDTH
042D6D F0 00       0012M1       dw SCENE_HEIGHT
042D6F F3          0013M1       db %11110011 ; opaque magenta (AABBGGRR)
042D70             0014M1   @end:
042D70             0085         CCS sid,viewport_width,viewport_height
                       M1 Args: SID=sid SCENE_WIDTH=viewport_width SCENE_HEIGHT=viewport_height 
042D70 21 7E 2D 04 0001M1       ld hl,@beg
042D74 01 0B 00 00 0002M1       ld bc,@end-@beg
042D78 5B DF       0003M1       rst.lil $18
042D7A C3 89 2D 04 0004M1       jp @end
042D7E             0005M1   @beg:
042D7E             0006M1   ;   VDU 23,0, &A0, sid%; &49, 0, cstw%; csth%; Create Control Structure
042D7E 17 00 A0    0007M1       db 23,0,$A0
042D81 C3 06       0008M1       dw SID
042D83 49 00       0009M1       db $49,0
042D85 40 01       0010M1       dw SCENE_WIDTH
042D87 F0 00       0011M1       dw SCENE_HEIGHT
