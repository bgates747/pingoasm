041BFD             3419*    ; Return the exact sign and unsigned magnitude of target-camera without ever
041BFD             3420*    ; forming the potentially 17-bit signed difference. XOR 0x8000 maps signed
041BFD             3421*    ; words into monotonically ordered unsigned words.
041BFD             3422*    ;
041BFD             3423*    ; inputs:  HL=target component, DE=camera component
041BFD             3424*    ; outputs: HL=unsigned magnitude 0..65535, A=1 when negative else 0
041BFD             3425*    ; destroys: AF, DE; preserves BC and all shadow registers
041BFD             3426*    p3d_lookat_difference_magnitude16:
041BFD 7C          3427*        ld a,h
041BFE EE 80       3428*        xor 0x80
041C00 67          3429*        ld h,a
041C01 7A          3430*        ld a,d
041C02 EE 80       3431*        xor 0x80
041C04 57          3432*        ld d,a
041C05 B7          3433*        or a
041C06 52 ED 52    3434*        sbc.s hl,de
041C09 30 0A       3435*        jr nc,@positive
041C0B AF          3436*        xor a
041C0C 95          3437*        sub l
041C0D 6F          3438*        ld l,a
041C0E 3E 00       3439*        ld a,0
041C10 9C          3440*        sbc a,h
041C11 67          3441*        ld h,a
041C12 3E 01       3442*        ld a,1
041C14 C9          3443*        ret
041C15             3444*    @positive:
041C15 AF          3445*        xor a
041C16 C9          3446*        ret
041C17             3447*    
041C17             3448*    ; Negate one logical signed/unsigned low word.
041C17             3449*    ; input/output: HL; destroys AF; preserves every other register.
041C17             3450*    p3d_lookat_negate16:
041C17 AF          3451*        xor a
041C18 95          3452*        sub l
041C19 6F          3453*        ld l,a
041C1A 3E 00       3454*        ld a,0
041C1C 9C          3455*        sbc a,h
041C1D 67          3456*        ld h,a
041C1E C9          3457*        ret
