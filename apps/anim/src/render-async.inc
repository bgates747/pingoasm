render_notify_token: equ 0A641h
setup_barrier_value: equ 0A5h

initialize_render_state:
    xor a
    ld (render_in_flight),a
    ld (completion_ready),a
    ld (sequence_initialized),a
    ld (exit_requested),a
    ld (callback_error),a
