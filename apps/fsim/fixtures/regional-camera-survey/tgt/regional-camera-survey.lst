040CD5 DD 74 01    0019*M1     ld (ix+p3d_vec3_x+1),h
040CD8 DD 73 02    0020*M1     ld (ix+p3d_vec3_y),e
040CDB DD 72 03    0021*M1     ld (ix+p3d_vec3_y+1),d
