0409FF C9          1506*       ret
040A00             1507*   @overflow:
040A00 37          1508*       scf
040A01 C9          1509*       ret
040A02             1510*   
040A02             1511*   ; Translate one signed 16-bit vec3 in place.
040A02             1512*   ;
040A02             1513*   ; This performs component-wise integer addition. Both operands must use the
040A02             1514*   ; same Pingo domain, normally translation-distance units.
040A02             1515*   ;
040A02             1516*   ; inputs:
040A02             1517*   ;   ix -> six-byte source/destination vec3
040A02             1518*   ;   iy -> six-byte translation vec3
040A02             1519*   ; outputs:
040A02             1520*   ;   (ix) = (ix) + (iy)
040A02             1521*   ;   carry clear on success
040A02             1522*   ;   carry set if any signed component overflows
040A02             1523*   ;   vector is unchanged on overflow
040A02             1524*   ; destroys:
040A02             1525*   ;   af, bc, de, hl
040A02             1526*   ; preserves:
040A02             1527*   ;   ix, iy, and all shadow registers
040A02             1528*   p3d_vec3_translate16:
040A02 DD 6E 00    1529*       ld l,(ix+p3d_vec3_x)
040A05 DD 66 01    1530*       ld h,(ix+p3d_vec3_x+1)
040A08 FD 5E 00    1531*       ld e,(iy+p3d_vec3_x)
040A0B FD 56 01    1532*       ld d,(iy+p3d_vec3_x+1)
040A0E CD F4 09 04 1533*       call p3d_sadd16
040A12 D8          1534*       ret c
040A13 E5          1535*       push hl
040A14 DD 6E 02    1536*       ld l,(ix+p3d_vec3_y)
040A17 DD 66 03    1537*       ld h,(ix+p3d_vec3_y+1)
040A1A FD 5E 02    1538*       ld e,(iy+p3d_vec3_y)
040A1D FD 56 03    1539*       ld d,(iy+p3d_vec3_y+1)
040A20 CD F4 09 04 1540*       call p3d_sadd16
040A24 38 2C       1541*       jr c,@y_failed
040A26 E5          1542*       push hl
040A27 DD 6E 04    1543*       ld l,(ix+p3d_vec3_z)
040A2A DD 66 05    1544*       ld h,(ix+p3d_vec3_z+1)
040A2D FD 5E 04    1545*       ld e,(iy+p3d_vec3_z)
040A30 FD 56 05    1546*       ld d,(iy+p3d_vec3_z+1)
040A33 CD F4 09 04 1547*       call p3d_sadd16
040A37 38 18       1548*       jr c,@z_failed
040A39 4D          1549*       ld c,l
040A3A 44          1550*       ld b,h
040A3B E1          1551*       pop hl
040A3C DD 75 02    1552*       ld (ix+p3d_vec3_y),l
040A3F DD 74 03    1553*       ld (ix+p3d_vec3_y+1),h
040A42 E1          1554*       pop hl
040A43 DD 75 00    1555*       ld (ix+p3d_vec3_x),l
040A46 DD 74 01    1556*       ld (ix+p3d_vec3_x+1),h
040A49 DD 71 04    1557*       ld (ix+p3d_vec3_z),c
040A4C DD 70 05    1558*       ld (ix+p3d_vec3_z+1),b
040A4F B7          1559*       or a
040A50 C9          1560*       ret
