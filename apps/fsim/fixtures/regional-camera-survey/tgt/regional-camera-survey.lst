041D32             3621*   
041D32             3622*   ; Aim a Pingo camera at one world-space point.
041D32             3623*   ;
041D32             3624*   ; inputs:
041D32             3625*   ;   ix -> p3d camera state
041D32             3626*   ;   iy -> target world-position vec3
041D32             3627*   ;   a  = required roll policy:
041D32             3628*   ;          p3d_camera_roll_upright
041D32             3629*   ;          p3d_camera_roll_continuous
041D32             3630*   ; outputs:
041D32             3631*   ;   absolute Pingo Euler words and matching local-to-world matrix updated
041D32             3632*   ;   rotation dirty set iff the emitted Euler bytes changed
041D32             3633*   ;   carry clear on success
041D32             3634*   ;   carry set for an invalid policy or coincident camera/target, with the
041D32             3635*   ;   complete camera state unchanged
041D32             3636*   ; destroys:
041D32             3637*   ;   af, af', bc, de, hl, bc', de', hl'
041D32             3638*   ; preserves:
041D32             3639*   ;   ix, iy and the target vec3
041D32             3640*   ;
041D32             3641*   ; The solver first retains roughly eleven direction bits by scaling all three
041D32             3642*   ; exact sign/magnitude differences into a common 1024..2047 maximum. Thus
041D32             3643*   ; x^2+z^2 is below 2^23. The pole cone is scale-independent: enter when
041D32             3644*   ; horizontal <= |dy|/32 and leave only when horizontal > |dy|/16.
041D32             3645*   ;
041D32             3646*   ; Upright mode emits pitch=atan2(dy,horizontal), yaw=atan2(-dx,-dz), roll=0.
041D32             3647*   ; Continuous mode retains the equivalent inverted Euler branch after a pole
041D32             3648*   ; crossing, allowing pitch to pass through +/-90 degrees without a 180-degree
041D32             3649*   ; frame twist. Inside the hysteresis band the last reliable canonical yaw is
041D32             3650*   ; retained and pitch is the exact vertical cardinal.
041D32             3651*   p3d_camera_look_at_point16:
