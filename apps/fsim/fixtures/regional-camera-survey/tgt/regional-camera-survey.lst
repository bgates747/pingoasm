042903             0177*   survey_pitch_up:
042903             0178*       SURVEY_LOAD_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042903 3A 94 9A 04 0001*M1         ld a,(ADDRESS)
042907 6F          0002*M1         ld l,a
042908 3A 95 9A 04 0003*M1         ld a,(ADDRESS+1)
04290C 67          0004*M1         ld h,a
04290D 11 68 FF FF 0179*       ld de,-survey_angular_step
042911 52 19       0180*       add.s hl,de
