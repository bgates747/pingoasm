040A9D             1639*   ; Rotate one signed 16-bit vec3 around the X axis in place.
040A9D             1640*   ;
040A9D             1641*   ; inputs:
040A9D             1642*   ;   ix -> six-byte source/destination vec3
040A9D             1643*   ;   hl = signed Pingo rotation angle (low word)
040A9D             1644*   ; outputs:
040A9D             1645*   ;   rotated vec3 at (ix)
040A9D             1646*   ;   carry clear on success
040A9D             1647*   ;   carry set on arithmetic overflow
040A9D             1648*   ; destroys:
040A9D             1649*   ;   af, af', bc, de, hl, bc', de', hl'
040A9D             1650*   ; preserves:
040A9D             1651*   ;   ix, iy; vector is unchanged on failure
040A9D             1652*       MACRO P3D_VEC3_ROTATE_X_BODY mulsub_routine, muladd_routine
040A9D             1653*       push iy
040A9D             1654*       push hl
040A9D             1655*       call p3d_sincos16
040A9D             1656*       P3D_ROT_LOAD_COS_SIN p3d_vec3_y,p3d_vec3_z
040A9D             1657*       call mulsub_routine
