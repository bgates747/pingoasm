041402             2625*   ; Canonical lock: z=0, x=atan2(-r12,r11). This preserves x-z at +90
041402             2626*   ; degrees and x+z at -90 degrees.
041402 DD 6E 0A    2627*       ld l,(ix+p3d_mat3_r1c2)
041405 DD 66 0B    2628*       ld h,(ix+p3d_mat3_r1c2+1)
