042913             0182*   ; every positive pitch as "below" 0xe001 and snap directly to -8191 when the
042913             0183*   ; pilot reversed away from the positive limit.
042913 CB 7C       0184*       bit 7,h
042915 28 10       0185*       jr z,@store
042917 E5          0186*       push hl
042918 11 01 E0 FF 0187*       ld de,-survey_pitch_limit
04291C B7          0188*       or a
04291D 52 ED 52    0189*       sbc.s hl,de
042920 E1          0190*       pop hl
042921 30 04       0191*       jr nc,@store
042923 21 01 E0 FF 0192*       ld hl,-survey_pitch_limit
