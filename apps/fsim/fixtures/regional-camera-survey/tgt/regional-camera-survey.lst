                       M1 Args: ADDRESS=survey_translation_rate 
042861 3A B4 9A 04 0001*M1         ld a,(ADDRESS)
042865 6F          0002*M1         ld l,a
042866 3A B5 9A 04 0003*M1         ld a,(ADDRESS+1)
04286A 67          0004*M1         ld h,a
04286B 52 29       0104*       add.s hl,hl
04286D E5          0105*       push hl
04286E 11 00 01 00 0106*       ld de,survey_translation_rate_max
042872 B7          0107*       or a
042873 52 ED 52    0108*       sbc.s hl,de
042876 E1          0109*       pop hl
042877 38 06       0110*       jr c,@store
