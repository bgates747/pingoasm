04287B 21 00 01 00 0112*       ld hl,survey_translation_rate_max
04287F             0113*   @store:
04287F             0114*       SURVEY_STORE_HL survey_translation_rate
                       M1 Args: ADDRESS=survey_translation_rate 
04287F 7D          0001*M1         ld a,l
042880 32 B4 9A 04 0002*M1         ld (ADDRESS),a
042884 7C          0003*M1         ld a,h
042885 32 B5 9A 04 0004*M1         ld (ADDRESS+1),a
042889 C9          0115*       ret
04288A             0116*   
04288A             0117*   ; Arrow keys own absolute camera pitch/yaw. Camera Euler angles act inversely
04288A             0118*   ; on the view: Up/Left subtract from the rendered pitch/yaw, while Down/Right
04288A             0119*   ; add. Opposed keys cancel. Pitch is held
04288A             0120*   ; one raw angle word short of either exact vertical, and roll is forcibly zero
04288A             0121*   ; whenever an angular command is applied.
04288A             0122*   survey_update_rotation:
04288A AF          0123*       xor a
04288B 32 B7 9A 04 0124*       ld (survey_rotation_changed),a
04288F DD 21 5C 00 0125*       ld ix,keyboard_masks
       04          
042894             0126*   
042894 DD CB 07 4E 0127*       bit 1,(ix+7)                       ; Up
042898 28 0C       0128*       jr z,@down_only
04289A DD CB 05 4E 0129*       bit 1,(ix+5)                       ; Down
04289E 20 16       0130*       jr nz,@pitch_done
0428A0 CD 03 29 04 0131*       call survey_pitch_up
0428A4 18 0A       0132*       jr @pitch_changed
0428A6             0133*   @down_only:
0428A6 DD CB 05 4E 0134*       bit 1,(ix+5)
0428AA 28 0A       0135*       jr z,@pitch_done
0428AC CD 32 29 04 0136*       call survey_pitch_down
0428B0             0137*   @pitch_changed:
0428B0 3E 01       0138*       ld a,1
0428B2 32 B7 9A 04 0139*       ld (survey_rotation_changed),a
0428B6             0140*   @pitch_done:
0428B6             0141*   
0428B6 DD CB 03 4E 0142*       bit 1,(ix+3)                       ; Left
0428BA 28 0C       0143*       jr z,@right_only
0428BC DD CB 0F 4E 0144*       bit 1,(ix+15)                      ; Right
0428C0 20 16       0145*       jr nz,@yaw_done
0428C2 CD 63 29 04 0146*       call survey_yaw_left
0428C6 18 0A       0147*       jr @yaw_changed
0428C8             0148*   @right_only:
0428C8 DD CB 0F 4E 0149*       bit 1,(ix+15)
0428CC 28 0A       0150*       jr z,@yaw_done
0428CE CD 7E 29 04 0151*       call survey_yaw_right
0428D2             0152*   @yaw_changed:
0428D2 3E 01       0153*       ld a,1
0428D4 32 B7 9A 04 0154*       ld (survey_rotation_changed),a
0428D8             0155*   @yaw_done:
0428D8             0156*   
0428D8 3A B7 9A 04 0157*       ld a,(survey_rotation_changed)
0428DC B7          0158*       or a
0428DD C8          0159*       ret z
0428DE             0160*   
0428DE             0161*   ; The no-roll invariant is executable rather than merely conventional.
0428DE AF          0162*       xor a
0428DF 32 98 9A 04 0163*       ld (camera_state+p3d_camera_pingo_rotation+p3d_vec3_z),a
0428E3 32 99 9A 04 0164*       ld (camera_state+p3d_camera_pingo_rotation+p3d_vec3_z+1),a
0428E7             0165*   
0428E7             0166*   ; Keep the retained camera orientation coherent with the emitted Euler words.
0428E7             0167*   ; This closed form is Ry(yaw)*Rx(pitch), explicitly with roll zero.
0428E7 DD 21 9A 9A 0168*       ld ix,camera_state+p3d_camera_orientation
       04          
0428EC FD 21 94 9A 0169*       ld iy,camera_state+p3d_camera_pingo_rotation
       04          
0428F1 CD BF 12 04 0170*       call p3d_camera_mat3_from_euler_fine16
0428F5 DD 21 8A 9A 0171*       ld ix,camera_state
       04          
