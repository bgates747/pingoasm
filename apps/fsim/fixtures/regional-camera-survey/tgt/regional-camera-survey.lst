042927             0194*       SURVEY_STORE_HL camera_state+p3d_camera_pingo_rotation+p3d_vec3_x
                       M1 Args: ADDRESS=camera_state+p3d_camera_pingo_rotation+p3d_vec3_x 
042927 7D          0001*M1         ld a,l
042928 32 94 9A 04 0002*M1         ld (ADDRESS),a
04292C 7C          0003*M1         ld a,h
04292D 32 95 9A 04 0004*M1         ld (ADDRESS+1),a
