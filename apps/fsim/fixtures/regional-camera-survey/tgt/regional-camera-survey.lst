042AF3             0072        include "../../koak-flight-streamed/src/flight-backdrop.inc"
042AF3             0001*   ; =============================================================================
042AF3             0002*   ; Camera-attitude sky/ground fallback for the 320x148 exterior viewport.
042AF3             0003*   ;
042AF3             0004*   ; This is the qualified four-triangle Berkeley implementation with one vital
042AF3             0005*   ; regional-view distinction: pitch and roll come from camera_state's retained
042AF3             0006*   ; orientation matrix. Cockpit orientation equals the aircraft attitude, while
042AF3             0007*   ; the chase solver owns an upright horizon that must not inherit aircraft bank.
042AF3             0008*   ; Matrix-derived screen attitude avoids the equivalent +/-180-degree branches
042AF3             0009*   ; that a complete Pingo Euler triple may legitimately use.
042AF3             0010*   ; =============================================================================
042AF3             0011*   
042AF3             0012*   backdrop_plot_move_absolute: equ 04h
042AF3             0013*   backdrop_plot_triangle_absolute: equ 55h
042AF3             0014*   backdrop_sky_colour: equ 47
042AF3             0015*   backdrop_ground_colour: equ 8
042AF3             0016*   backdrop_center_x: equ 160
042AF3             0017*   ; Keep the qualified KOAK value (148/2 = 74) while allowing full-height
042AF3             0018*   ; camera-only fixtures to reuse this camera-matrix backdrop without a fork.
042AF3             0019*   backdrop_center_y: equ viewport_height/2
042AF3             0020*   
042AF3             0021*       MACRO BACKDROP_STORE_HL16 target
042AF3             0022*           ld a,l
042AF3             0023*           ld (target),a
042AF3             0024*           ld a,h
042AF3             0025*           ld (target+1),a
042AF3             0026*       ENDMACRO
042AF3             0027*   
042AF3             0028*       MACRO BACKDROP_LOAD_HL16 source
042AF3             0029*           ld a,(source)
042AF3             0030*           ld l,a
042AF3             0031*           ld a,(source+1)
042AF3             0032*           ld h,a
042AF3             0033*       ENDMACRO
042AF3             0034*   
042AF3             0035*       MACRO BACKDROP_LOAD_DE16 source
042AF3             0036*           ld a,(source)
042AF3             0037*           ld e,a
042AF3             0038*           ld a,(source+1)
042AF3             0039*           ld d,a
042AF3             0040*       ENDMACRO
042AF3             0041*   
042AF3             0042*   ; IX points to one row-major local-to-world camera orientation.  World-up in
042AF3             0043*   ; view coordinates is row 1, so pitch is asin(-r1c2) and screen roll is
042AF3             0044*   ; atan2(r1c0,r1c1).  Both library calls return the same coarse angle-word
042AF3             0045*   ; domain used by the original horizon implementation.
042AF3             0046*   backdrop_extract_attitude:
042AF3 DD 6E 0A    0047*       ld l,(ix+p3d_mat3_r1c2)
042AF6 DD 66 0B    0048*       ld h,(ix+p3d_mat3_r1c2+1)
042AF9 7C          0049*       ld a,h
042AFA FE 80       0050*       cp 080h
042AFC 20 0A       0051*       jr nz,@negate_pitch
042AFE 7D          0052*       ld a,l
042AFF B7          0053*       or a
042B00 20 06       0054*       jr nz,@negate_pitch
042B02 21 FF 7F 00 0055*       ld hl,32767
042B06 18 07       0056*       jr @pitch_ready
042B08             0057*   @negate_pitch:
042B08 AF          0058*       xor a
042B09 95          0059*       sub l
042B0A 6F          0060*       ld l,a
042B0B 3E 00       0061*       ld a,0
