041441             2659*   ; ---------------------------------------------------------------------------
041441             2660*   ; Persistent eZ80-side Pingo object state
041441             2661*   ; ---------------------------------------------------------------------------
041441             2662*   
041441             2663*   ; Initialize all 64 bytes of one object state.
041441             2664*   ;
041441             2665*   ; inputs:
041441             2666*   ;   ix -> destination p3d object state
041441             2667*   ;   iy -> four-word tuple: sid, oid, mid, bmid
041441             2668*   ; outputs:
041441             2669*   ;   identity pose, unit scale, zero velocities/residuals, copied IDs
041441             2670*   ;   all four known dirty bits set for initial Pingo synchronization
041441             2671*   ;   carry clear
041441             2672*   ; destroys:
041441             2673*   ;   af, bc, de, hl
041441             2674*   ; preserves:
041441             2675*   ;   ix, iy and all shadow registers
041441             2676*   ; note:
041441             2677*   ;   The ID tuple may alias the destination; it is captured before the state is
041441             2678*   ;   overwritten.
041441             2679*   p3d_object_init16:
041441 DD E5       2680*       push ix
041443 FD E5       2681*       push iy
041445 FD 6E 00    2682*       ld l,(iy+p3d_object_ids_sid)
041448 FD 66 01    2683*       ld h,(iy+p3d_object_ids_sid+1)
04144B E5          2684*       push hl
04144C FD 6E 02    2685*       ld l,(iy+p3d_object_ids_oid)
04144F FD 66 03    2686*       ld h,(iy+p3d_object_ids_oid+1)
041452 E5          2687*       push hl
041453 FD 6E 04    2688*       ld l,(iy+p3d_object_ids_mid)
041456 FD 66 05    2689*       ld h,(iy+p3d_object_ids_mid+1)
041459 E5          2690*       push hl
04145A FD 6E 06    2691*       ld l,(iy+p3d_object_ids_bmid)
04145D FD 66 07    2692*       ld h,(iy+p3d_object_ids_bmid+1)
041460 E5          2693*       push hl
041461             2694*   ; Seed byte zero, then replicate it over the remaining 63 bytes.
041461 AF          2695*       xor a
041462 DD 77 00    2696*       ld (ix+0),a
041465 DD E5       2697*       push ix
041467 E1          2698*       pop hl
041468 DD E5       2699*       push ix
04146A D1          2700*       pop de
04146B 13          2701*       inc de
04146C 01 3F 00 00 2702*       ld bc,p3d_object_size-1
041470 ED B0       2703*       ldir
041472             2704*   ; Restore the captured creation IDs.
041472 E1          2705*       pop hl
041473 DD 75 08    2706*       ld (ix+p3d_object_bmid),l
041476 DD 74 09    2707*       ld (ix+p3d_object_bmid+1),h
041479 E1          2708*       pop hl
04147A DD 75 06    2709*       ld (ix+p3d_object_mid),l
04147D DD 74 07    2710*       ld (ix+p3d_object_mid+1),h
041480 E1          2711*       pop hl
041481 DD 75 04    2712*       ld (ix+p3d_object_oid),l
041484 DD 74 05    2713*       ld (ix+p3d_object_oid+1),h
041487 E1          2714*       pop hl
