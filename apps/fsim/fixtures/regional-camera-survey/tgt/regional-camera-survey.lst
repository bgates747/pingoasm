042857 32 B4 9A 04 0002*M1         ld (ADDRESS),a
04285B 7C          0003*M1         ld a,h
04285C 32 B5 9A 04 0004*M1         ld (ADDRESS+1),a
042860 C9          0100*       ret
042861             0101*   
042861             0102*   survey_translation_rate_up:
