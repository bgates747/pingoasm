047F03             0001*   ; Thirty-two stable terrain-only scene slots.  The 8x4 rolling window uses
047F03             0002*   ; every active-renderable object and leaves backdrop painting outside Pingo.
047F03             0003*   
047F03             0004*       MACRO REGIONAL_ESTABLISH_TERRAIN_SLOT SLOT
047F03             0005*           SV sid,SLOT,regional_placeholder_vertices,regional_placeholder_vertices_n
047F03             0006*           SMVI sid,SLOT,regional_placeholder_indices,regional_placeholder_indices_n
047F03             0007*           STC sid,SLOT,regional_placeholder_uvs,regional_placeholder_uvs_n
047F03             0008*           STCI sid,SLOT,regional_placeholder_uv_indices,regional_placeholder_indices_n
047F03             0009*           ld hl,SLOT
047F03             0010*           ld a,pingo_shading_flat_pattern
047F03             0011*           call pingo_set_mesh_shading_mode
047F03             0012*           ld hl,SLOT
047F03             0013*           ld a,pingo_mesh_illumination_scene
047F03             0014*           call pingo_set_mesh_illumination_mode
047F03             0015*           CO sid,SLOT,SLOT,terrain_bmid
047F03             0016*           ld hl,SLOT
047F03             0017*           xor a
047F03             0018*           call pingo_set_object_active
047F03             0019*       ENDMACRO
