0412C1 FD 6E 00    2451*       ld l,(iy+p3d_vec3_x)
0412C4 FD 66 01    2452*       ld h,(iy+p3d_vec3_x+1)
0412C7 CD E0 05 04 2453*       call p3d_sincos_fine16
0412CB C5          2454*       push bc                 ; +9 sx
0412CC D5          2455*       push de                 ; +6 cx
