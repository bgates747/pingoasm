042FEA             0074        include "../../koak-flight-streamed/src/streaming-vdu.inc"
042FEA             0001*   ; Runtime-variable Pingo helpers used by the regional slot coordinator.
042FEA             0002*   ; Every packet field is an exact little-endian u16 and is patched bytewise.
042FEA             0003*   
042FEA             0004*   ; Inputs: HL=object ID, DE=mesh ID, BC=bitmap ID.
