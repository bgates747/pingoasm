041398             2549*   ; Export a row-major local-to-world matrix as canonical Pingo XYZ Euler words.
041398             2550*   ; The convention is R=Rz*Ry*Rx, with pitch in -quarter..+quarter turn.
041398             2551*   ;
041398             2552*   ; inputs:
041398             2553*   ;   ix -> matrix
041398             2554*   ;   iy -> output angle vec3
041398             2555*   ; outputs:
041398             2556*   ;   canonical angle vec3
041398             2557*   ;   carry clear
041398             2558*   ; destroys:
041398             2559*   ;   af, af', bc, de, hl, bc', de', hl'
041398             2560*   ; preserves:
041398             2561*   ;   ix, iy
041398             2562*   p3d_mat3_to_euler16:
041398             2563*   ; y = asin(-r20), saturating the otherwise unrepresentable -(-32768).
041398 DD 6E 0C    2564*       ld l,(ix+p3d_mat3_r2c0)
04139B DD 66 0D    2565*       ld h,(ix+p3d_mat3_r2c0+1)
04139E 7C          2566*       ld a,h
04139F FE 80       2567*       cp 0x80
0413A1 20 0A       2568*       jr nz,@negate_pitch
0413A3 7D          2569*       ld a,l
0413A4 B7          2570*       or a
0413A5 20 06       2571*       jr nz,@negate_pitch
0413A7 21 FF 7F 00 2572*       ld hl,32767
0413AB 18 07       2573*       jr @pitch_ready
0413AD             2574*   @negate_pitch:
0413AD AF          2575*       xor a
0413AE 95          2576*       sub l
0413AF 6F          2577*       ld l,a
0413B0 3E 00       2578*       ld a,0
0413B2 9C          2579*       sbc a,h
0413B3 67          2580*       ld h,a
0413B4             2581*   @pitch_ready:
0413B4 CD 91 08 04 2582*       call p3d_asin16
0413B8 E5          2583*       push hl                  ; canonical Y
0413B9             2584*   ; Gimbal lock is exactly the cardinal pitch bins +/-8192.
0413B9 7C          2585*       ld a,h
0413BA FE 20       2586*       cp 0x20
0413BC 20 04       2587*       jr nz,@check_negative_gimbal
0413BE 7D          2588*       ld a,l
0413BF B7          2589*       or a
0413C0 28 40       2590*       jr z,@gimbal
0413C2             2591*   @check_negative_gimbal:
0413C2 7C          2592*       ld a,h
0413C3 FE E0       2593*       cp 0xe0
0413C5 20 04       2594*       jr nz,@nonsingular
0413C7 7D          2595*       ld a,l
0413C8 B7          2596*       or a
0413C9 28 37       2597*       jr z,@gimbal
0413CB             2598*   
0413CB             2599*   @nonsingular:
0413CB             2600*   ; x = atan2(r21,r22)
0413CB DD 6E 0E    2601*       ld l,(ix+p3d_mat3_r2c1)
0413CE DD 66 0F    2602*       ld h,(ix+p3d_mat3_r2c1+1)
0413D1 DD 5E 10    2603*       ld e,(ix+p3d_mat3_r2c2)
0413D4 DD 56 11    2604*       ld d,(ix+p3d_mat3_r2c2+1)
0413D7 CD 57 06 04 2605*       call p3d_atan2_16
0413DB E5          2606*       push hl
0413DC             2607*   ; z = atan2(r10,r00)
0413DC DD 6E 06    2608*       ld l,(ix+p3d_mat3_r1c0)
0413DF DD 66 07    2609*       ld h,(ix+p3d_mat3_r1c0+1)
0413E2 DD 5E 00    2610*       ld e,(ix+p3d_mat3_r0c0)
0413E5 DD 56 01    2611*       ld d,(ix+p3d_mat3_r0c0+1)
0413E8 CD 57 06 04 2612*       call p3d_atan2_16
0413EC FD 75 04    2613*       ld (iy+p3d_vec3_z),l
0413EF FD 74 05    2614*       ld (iy+p3d_vec3_z+1),h
0413F2 E1          2615*       pop hl
0413F3 FD 75 00    2616*       ld (iy+p3d_vec3_x),l
0413F6 FD 74 01    2617*       ld (iy+p3d_vec3_x+1),h
0413F9 E1          2618*       pop hl
0413FA FD 75 02    2619*       ld (iy+p3d_vec3_y),l
0413FD FD 74 03    2620*       ld (iy+p3d_vec3_y+1),h
