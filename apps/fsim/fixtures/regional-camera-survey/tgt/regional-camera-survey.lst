041A93             3231*   
041A93             3232*   ; Add one tick of persistent object-local angular and linear velocity.
041A93             3233*   ;
041A93             3234*   ; Angular residuals retain sub-bin rates. Per component:
041A93             3235*   ;
041A93             3236*   ;   total    = velocity + residual                   (16-bit angular wrap)
041A93             3237*   ;   residual = ((total + 64) mod 128) - 64          (-64..63)
041A93             3238*   ;   delta    = total - residual                     (multiple of 128)
041A93             3239*   ;
041A93             3240*   ; The tie rule is intentionally toward the positive phase, making residual
041A93             3241*   ; -64 stable when velocity becomes zero. The tick applies rotation first,
041A93             3242*   ; snaps the absolute Euler/matrix state, then translates through that resulting
041A93             3243*   ; orientation. Any failure restores all 64 state bytes.
041A93             3244*   ;
041A93             3245*   ; inputs:
041A93             3246*   ;   ix -> object state
041A93             3247*   ; outputs:
041A93             3248*   ;   integrated object state; carry set leaves all 64 bytes unchanged
041A93             3249*   ; destroys:
041A93             3250*   ;   af, af', bc, de, hl, bc', de', hl'
041A93             3251*   ; preserves:
041A93             3252*   ;   ix, iy
041A93             3253*       MACRO P3D_OBJECT_ACCUMULATE_ANGLE velocity_offset, residual_offset, delta_offset
041A93             3254*       ld l,(ix+velocity_offset)
041A93             3255*       ld h,(ix+velocity_offset+1)
041A93             3256*       ld e,(ix+residual_offset)
041A93             3257*       ld d,(ix+residual_offset+1)
041A93             3258*       add.s hl,de
041A93             3259*       ld a,l
041A93             3260*       add a,64
041A93             3261*       and 0x7f
041A93             3262*       sub 64
041A93             3263*       ld e,a
041A93             3264*       add a,a
041A93             3265*       sbc a,a
041A93             3266*       ld d,a
041A93             3267*       ld (ix+residual_offset),e
041A93             3268*       ld (ix+residual_offset+1),d
041A93             3269*       or a
041A93             3270*       sbc.s hl,de
041A93             3271*       ld (iy+delta_offset),l
041A93             3272*       ld (iy+delta_offset+1),h
041A93             3273*       ENDMACRO
