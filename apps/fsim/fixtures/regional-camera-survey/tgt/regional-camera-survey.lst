040A55             1568*   ; Load a*cos and b*sin into opposite GP banks.
040A55             1569*   ; Requires BC=sin, DE=cos, IX=vector.
040A55             1570*       MACRO P3D_ROT_LOAD_COS_SIN a_offset, b_offset
040A55             1571*       ld a,c
040A55             1572*       exx
040A55             1573*       ld e,a
040A55             1574*       exx
