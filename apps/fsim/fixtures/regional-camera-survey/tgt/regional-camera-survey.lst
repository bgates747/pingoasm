047A36             0076        include "regional-camera-streaming.inc"
047A36             0001*   ; =============================================================================
047A36             0002*   ; Arbitrary-position loose-L0 terrain streaming for the regional camera.
047A36             0003*   ;
047A36             0004*   ; One 8x4 rectangle occupies all 32 stable Pingo object slots.  Any eight
047A36             0005*   ; consecutive X cells and four consecutive Y cells have unique residues, so
047A36             0006*   ; slot = (tile_y & 3)*8 + (tile_x & 7) is collision-free for the whole window.
047A36             0007*   ; The rectangle retains fixture 3's useful start footprint: two cells west,
047A36             0008*   ; five east, two south, and one north of the camera's coarse cell.
047A36             0009*   ; =============================================================================
047A36             0010*   
047A36             0011*   terrain_slot_count: equ 32
047A36             0012*   terrain_mesh_base: equ 1
047A36             0013*   terrain_object_base: equ 1
047A36             0014*   regional_grid_columns: equ 201
047A36             0015*   regional_grid_rows: equ 252
047A36             0016*   regional_grid_max_x: equ regional_grid_columns-1
047A36             0017*   regional_grid_max_y: equ regional_grid_rows-1
047A36             0018*   regional_terrain_y_count: equ 9728
047A36             0019*   regional_terrain_scale_q8_8: equ 24576
047A36             0020*   regional_cell_counts: equ 8192
047A36             0021*   regional_half_cell_counts: equ 4096
047A36             0022*   regional_z_low: equ regional_frame_z_bias-regional_half_cell_counts
047A36             0023*   regional_z_high: equ regional_frame_z_bias+regional_half_cell_counts
047A36             0024*   regional_negative_half_high: equ 0f0h
047A36             0025*   
