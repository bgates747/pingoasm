040D48             1875*   ; ---------------------------------------------------------------------------
040D48             1876*   ; Matrix-vector primitives
040D48             1877*   ; ---------------------------------------------------------------------------
040D48             1878*   
040D48             1879*   ; Multiply a signed normalized 3x3 matrix by one signed 16-bit vec3.
040D48             1880*   ;
040D48             1881*   ; Matrix storage is row-major, matching Pingo. Each element is a signed
040D48             1882*   ; normalized 16-bit coefficient, so the matrix occupies 18 bytes.
040D48             1883*   ;
040D48             1884*   ; inputs:
040D48             1885*   ;   ix -> six-byte source/destination vec3
040D48             1886*   ;   iy -> 18-byte row-major matrix
040D48             1887*   ; outputs:
040D48             1888*   ;   transformed vec3 at (ix)
040D48             1889*   ;   carry clear on success
040D48             1890*   ;   carry set on arithmetic overflow
040D48             1891*   ; destroys:
040D48             1892*   ;   af, af', bc, de, hl, bc', de', hl'
040D48             1893*   ; preserves:
040D48             1894*   ;   ix, iy; vector is unchanged on failure
040D48             1895*   p3d_mat3_mul_vec3_16:
040D48 FD E5       1896*       push iy
040D4A CD 84 0D 04 1897*       call p3d_mat3_row_mul_vec3_16
040D4E 38 30       1898*       jr c,@row0_failed
040D50 E5          1899*       push hl
040D51 ED 33 06    1900*       lea iy,iy+6
040D54 CD 84 0D 04 1901*       call p3d_mat3_row_mul_vec3_16
040D58 38 25       1902*       jr c,@row1_failed
040D5A E5          1903*       push hl
040D5B ED 33 06    1904*       lea iy,iy+6
040D5E CD 84 0D 04 1905*       call p3d_mat3_row_mul_vec3_16
040D62 38 1A       1906*       jr c,@row2_failed
040D64 5D          1907*       ld e,l
040D65 54          1908*       ld d,h
040D66 E1          1909*       pop hl
040D67 DD 75 02    1910*       ld (ix+p3d_vec3_y),l
040D6A DD 74 03    1911*       ld (ix+p3d_vec3_y+1),h
040D6D E1          1912*       pop hl
040D6E DD 75 00    1913*       ld (ix+p3d_vec3_x),l
040D71 DD 74 01    1914*       ld (ix+p3d_vec3_x+1),h
040D74 DD 73 04    1915*       ld (ix+p3d_vec3_z),e
040D77 DD 72 05    1916*       ld (ix+p3d_vec3_z+1),d
040D7A FD E1       1917*       pop iy
040D7C B7          1918*       or a
040D7D C9          1919*       ret
040D7E             1920*   @row2_failed:
040D7E E1          1921*       pop hl
040D7F             1922*   @row1_failed:
040D7F E1          1923*       pop hl
040D80             1924*   @row0_failed:
040D80 FD E1       1925*       pop iy
040D82 37          1926*       scf
040D83 C9          1927*       ret
040D84             1928*   
040D84             1929*   ; Multiply the row at IY by the vector at IX, accumulate all three products
040D84             1930*   ; at signed 32-bit width, then normalize once.
040D84             1931*   p3d_mat3_row_mul_vec3_16:
040D84             1932*   ; product 0 operands in the active bank
040D84 DD 6E 00    1933*       ld l,(ix+p3d_vec3_x)
040D87 DD 66 01    1934*       ld h,(ix+p3d_vec3_x+1)
040D8A FD 5E 00    1935*       ld e,(iy+0)
040D8D FD 56 01    1936*       ld d,(iy+1)
040D90             1937*   ; product 1 operands in the shadow bank
040D90 D9          1938*       exx
040D91 DD 6E 02    1939*       ld l,(ix+p3d_vec3_y)
040D94 DD 66 03    1940*       ld h,(ix+p3d_vec3_y+1)
040D97 FD 5E 02    1941*       ld e,(iy+2)
040D9A FD 56 03    1942*       ld d,(iy+3)
040D9D D9          1943*       exx
040D9E CD 3F 04 04 1944*       call p3d_smul16x16_32
040DA2 D9          1945*       exx
040DA3 CD 3F 04 04 1946*       call p3d_smul16x16_32
040DA7 CD 6F 04 04 1947*       call p3d_sadd32
040DAB D8          1948*       ret c
040DAC             1949*   ; park the two-product sum and form product 2 in the opposite bank
040DAC D9          1950*       exx
040DAD DD 6E 04    1951*       ld l,(ix+p3d_vec3_z)
040DB0 DD 66 05    1952*       ld h,(ix+p3d_vec3_z+1)
040DB3 FD 5E 04    1953*       ld e,(iy+4)
040DB6 FD 56 05    1954*       ld d,(iy+5)
040DB9 CD 3F 04 04 1955*       call p3d_smul16x16_32
040DBD CD 6F 04 04 1956*       call p3d_sadd32
040DC1 D8          1957*       ret c
040DC2 C3 AA 04 04 1958*       jp p3d_sdiv32767_32_to_16
040DC6             1959*   
040DC6             1960*   ; ---------------------------------------------------------------------------
040DC6             1961*   ; Matrix composition and orientation conversion
040DC6             1962*   ; ---------------------------------------------------------------------------
040DC6             1963*   
040DC6             1964*   ; Multiply two signed-Q15 row-major matrices in place.
040DC6             1965*   ;
040DC6             1966*   ; inputs:
040DC6             1967*   ;   ix -> left/source/destination matrix A
040DC6             1968*   ;   iy -> right/source matrix B
040DC6             1969*   ; outputs:
040DC6             1970*   ;   (ix) = A*B
040DC6             1971*   ;   carry clear on success
040DC6             1972*   ;   carry set on signed accumulator or narrowed-result overflow
040DC6             1973*   ; destroys:
040DC6             1974*   ;   af, af', bc, de, hl, bc', de', hl'
040DC6             1975*   ; preserves:
040DC6             1976*   ;   ix, iy; A is unchanged on failure
040DC6             1977*   ; note:
040DC6             1978*   ;   Exact IX=IY aliasing is supported. No output is committed until all nine
040DC6             1979*   ;   dot products have succeeded.
040DC6             1980*   p3d_mat3_mul_mat3_16:
040DC6 DD E5       1981*       push ix
040DC8 FD E5       1982*       push iy
040DCA CD 92 0E 04 1983*       call p3d_mat3_dot_row_col16
040DCE DA 8C 0E 04 1984*       jp c,@result0_failed
