040A9D             1659*       push hl
040A9D             1660*       pop iy
040A9D             1661*       pop hl
040A9D             1662*       call p3d_sincos16
040A9D             1663*       P3D_ROT_LOAD_SIN_COS p3d_vec3_y,p3d_vec3_z
040A9D             1664*       call muladd_routine
040A9D             1665*       jr c,@second_failed
040A9D             1666*       ld e,l
040A9D             1667*       ld d,h
040A9D             1668*       push iy
040A9D             1669*       pop hl
040A9D             1670*       ld (ix+p3d_vec3_y),l
040A9D             1671*       ld (ix+p3d_vec3_y+1),h
040A9D             1672*       ld (ix+p3d_vec3_z),e
040A9D             1673*       ld (ix+p3d_vec3_z+1),d
040A9D             1674*       pop iy
040A9D             1675*       or a
040A9D             1676*       ret
040A9D             1677*   @second_failed:
040A9D             1678*       pop iy
040A9D             1679*       scf
040A9D             1680*       ret
040A9D             1681*   @first_failed:
040A9D             1682*       pop hl
040A9D             1683*       pop iy
040A9D             1684*       scf
040A9D             1685*       ret
040A9D             1686*       ENDMACRO
