0400BD             0207*       rst.lil $18
0400BD             0208*       jp @end
0400BD             0209*   @beg:
0400BD             0210*   ;  1040 VDU 23, 0, &A0, sid%; &49, 38, bmid%; Render To Bitmap
0400BD             0211*       db 23, 0, $A0
0400BD             0212*       dw SID
0400BD             0213*       db $49, 38
0400BD             0214*       dw BMID
0400BD             0215*   @end:
0400BD             0216*       ENDMACRO
0400BD             0217*   
0400BD             0218*   ; DISPLAY RENDER TARGET BITMAP
0400BD             0219*       MACRO DISPBMP BMID, X, Y
0400BD             0220*       ld hl,@beg
