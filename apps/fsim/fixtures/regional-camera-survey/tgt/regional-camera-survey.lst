040CEB             1806*   
040CEB             1807*   ; Apply Pingo-order Euler rotations to one signed 16-bit vec3 in place.
040CEB             1808*   ;
040CEB             1809*   ; Rotation order is X, then Y, then Z, matching Pingo transform construction.
040CEB             1810*   ;
040CEB             1811*   ; inputs:
040CEB             1812*   ;   ix -> six-byte source/destination vec3
040CEB             1813*   ;   iy -> six-byte angle vec3 (X, Y, Z)
040CEB             1814*   ; outputs:
040CEB             1815*   ;   rotated vec3 at (ix)
040CEB             1816*   ;   carry clear on success
040CEB             1817*   ;   carry set on arithmetic overflow
040CEB             1818*   ; destroys:
040CEB             1819*   ;   af, af', bc, de, hl, bc', de', hl'
040CEB             1820*   ; note:
040CEB             1821*   ;   The vector is restored to its original value if any axis fails.
040CEB             1822*   p3d_vec3_rotate_xyz16:
040CEB             1823*   ; Snapshot the vector and all angles before any in-place write.
040CEB DD 6E 00    1824*       ld l,(ix+p3d_vec3_x)
040CEE DD 66 01    1825*       ld h,(ix+p3d_vec3_x+1)
040CF1 E5          1826*       push hl
040CF2 DD 6E 02    1827*       ld l,(ix+p3d_vec3_y)
040CF5 DD 66 03    1828*       ld h,(ix+p3d_vec3_y+1)
040CF8 E5          1829*       push hl
040CF9 DD 6E 04    1830*       ld l,(ix+p3d_vec3_z)
040CFC DD 66 05    1831*       ld h,(ix+p3d_vec3_z+1)
040CFF E5          1832*       push hl
040D00 FD 6E 04    1833*       ld l,(iy+p3d_vec3_z)
040D03 FD 66 05    1834*       ld h,(iy+p3d_vec3_z+1)
040D06 E5          1835*       push hl
040D07 FD 6E 02    1836*       ld l,(iy+p3d_vec3_y)
040D0A FD 66 03    1837*       ld h,(iy+p3d_vec3_y+1)
040D0D E5          1838*       push hl
040D0E FD 6E 00    1839*       ld l,(iy+p3d_vec3_x)
040D11 FD 66 01    1840*       ld h,(iy+p3d_vec3_x+1)
040D14 E5          1841*       push hl
040D15 E1          1842*       pop hl
040D16 CD 9D 0A 04 1843*       call p3d_vec3_rotate_x16
040D1A 38 13       1844*       jr c,@x_failed
040D1C E1          1845*       pop hl
040D1D CD 63 0B 04 1846*       call p3d_vec3_rotate_y16
040D21 38 0D       1847*       jr c,@y_failed
040D23 E1          1848*       pop hl
040D24 CD 25 0C 04 1849*       call p3d_vec3_rotate_z16
040D28 38 07       1850*       jr c,@z_failed
040D2A             1851*   ; Discard the saved original Z, Y, X.
040D2A E1          1852*       pop hl
040D2B E1          1853*       pop hl
040D2C E1          1854*       pop hl
040D2D B7          1855*       or a
040D2E C9          1856*       ret
040D2F             1857*   @x_failed:
040D2F E1          1858*       pop hl                  ; unused Y angle
040D30             1859*   @y_failed:
040D30 E1          1860*       pop hl                  ; unused Z angle
040D31             1861*   @z_failed:
040D31             1862*   ; Restore original Z, Y, X.
040D31 E1          1863*       pop hl
040D32 DD 75 04    1864*       ld (ix+p3d_vec3_z),l
040D35 DD 74 05    1865*       ld (ix+p3d_vec3_z+1),h
040D38 E1          1866*       pop hl
040D39 DD 75 02    1867*       ld (ix+p3d_vec3_y),l
040D3C DD 74 03    1868*       ld (ix+p3d_vec3_y+1),h
040D3F E1          1869*       pop hl
040D40 DD 75 00    1870*       ld (ix+p3d_vec3_x),l
040D43 DD 74 01    1871*       ld (ix+p3d_vec3_x+1),h
040D46 37          1872*       scf
040D47 C9          1873*       ret
