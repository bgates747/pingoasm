040A55             1579*       ld h,(ix+b_offset+1)
040A55             1580*       exx
040A55             1581*       ld l,(ix+a_offset)
040A55             1582*       ld h,(ix+a_offset+1)
040A55             1583*       ENDMACRO
040A55             1584*   
040A55             1585*   ; Load a*sin and b*cos into opposite GP banks.
040A55             1586*   ; Requires BC=sin, DE=cos, IX=vector.
