05F1D2             0127    .endif
05F1D2             0128        include "terrain-manager-regular-lod-provider.inc"
05F1D2             0001*   ; =============================================================================
05F1D2             0002*   ; Position-driven regular hierarchy provider for the universal terrain manager.
05F1D2             0003*   ;
05F1D2             0004*   ; Detailed TRH/L0 cells retain stable slots 0..90.  Generated hierarchy leaves
05F1D2             0005*   ; are exact (lod, anchor_q, anchor_offset_row) identities and use a protected
05F1D2             0006*   ; dynamic pool in slots 91..254.  A new plan first preserves every matching
05F1D2             0007*   ; resident identity (active or inactive), then assigns unused pool slots.  The
05F1D2             0008*   ; shared manager still owns publication, retry, activation and rebase ordering.
05F1D2             0009*   ;
05F1D2             0010*   ; Every radius-five disk maps bijectively onto the first 91 slots through
05F1D2             0011*   ;
05F1D2             0012*   ;     slot = (5*q + 11*r) mod 91.
05F1D2             0013*   ;
05F1D2             0014*   ; The kernel basis (11,-5),(5,6) has determinant 91 and minimum non-zero hex
05F1D2             0015*   ; distance 11.  Therefore no difference between two cells in one radius-five
05F1D2             0016*   ; disk (maximum distance 10) can be in the kernel.  Smaller disks inherit the
05F1D2             0017*   ; same injectivity, and normalizing negative residues makes the mapping global.
05F1D2             0018*   ; =============================================================================
05F1D2             0019*   
05F1D2             0020*   hex_provider_q_max: equ 213
05F1D2             0021*   hex_provider_even_rows: equ 235
05F1D2             0022*   hex_provider_odd_rows: equ 234
05F1D2             0023*   hex_provider_cell_id_pair_stride: equ 469
05F1D2             0024*   hex_provider_terrain_y_count: equ 9728
05F1D2             0025*   hex_provider_object_scale_q8_8: equ 32768
05F1D2             0026*   hex_provider_hysteresis_count: equ 256
05F1D2             0027*   hex_provider_vertical_exit_first: equ 4657
05F1D2             0028*   hex_provider_tip_exit_first: equ 5377
05F1D2             0029*   hex_provider_sloped_normal_squared: equ 4146176
05F1D2             0030*   hex_provider_sloped_hysteresis: equ 521271
05F1D2             0031*   hex_provider_sloped_exit_first: equ 9532472
05F1D2             0032*   
05F1D2             0033*   regular_provider_near_slot_count: equ 91
05F1D2             0034*   regular_provider_coarse_slot_first: equ 91
05F1D2             0035*   regular_provider_coarse_slot_count: equ 164
05F1D2             0036*   regular_provider_plan_max: equ regular_lod_phase_maximum_records
05F1D2             0037*   regular_provider_plan_record_lod: equ 0
05F1D2             0038*   regular_provider_plan_record_q: equ 1
05F1D2             0039*   regular_provider_plan_record_row: equ 3
05F1D2             0040*   regular_provider_plan_record_slot: equ 5
05F1D2             0041*   regular_provider_plan_record_bytes: equ 6
05F1D2             0042*   regular_provider_unassigned_slot: equ 0ffh
05F1D2             0043*   regular_provider_error_plan: equ 031h
05F1D2             0044*   .if terrain_manager_group_staging
05F1D2             0045*   regular_transition_owner_count: equ 250
05F1D2             0046*   regular_transition_near_owner_count: equ 91
05F1D2             0047*   regular_transition_coarse_owner_count: equ 159
05F1D2             0048*   regular_transition_state_idle: equ 0
05F1D2             0049*   regular_transition_state_wait_rebase: equ 1
05F1D2             0050*   regular_transition_state_select: equ 2
05F1D2             0051*   regular_transition_state_stage: equ 3
05F1D2             0052*   regular_transition_state_commit: equ 4
05F1D2             0053*   regular_transition_state_error: equ 5
05F1D2             0054*   regular_transition_processed_bytes: equ 5
05F1D2             0055*   .endif
05F1D2             0056*   
05F1D2             0057*       MACRO HEX_PROVIDER_LOAD_U16_HL ADDRESS
05F1D2             0058*           ld hl,0
05F1D2             0059*           ld a,(ADDRESS)
05F1D2             0060*           ld l,a
05F1D2             0061*           ld a,(ADDRESS+1)
05F1D2             0062*           ld h,a
05F1D2             0063*       ENDMACRO
05F1D2             0064*   
05F1D2             0065*       MACRO HEX_PROVIDER_LOAD_U16_DE ADDRESS
05F1D2             0066*           ld de,0
05F1D2             0067*           ld a,(ADDRESS)
05F1D2             0068*           ld e,a
05F1D2             0069*           ld a,(ADDRESS+1)
05F1D2             0070*           ld d,a
05F1D2             0071*       ENDMACRO
05F1D2             0072*   
05F1D2             0073*       MACRO HEX_PROVIDER_STORE_U16_HL ADDRESS
05F1D2             0074*           ld a,l
05F1D2             0075*           ld (ADDRESS),a
05F1D2             0076*           ld a,h
05F1D2             0077*           ld (ADDRESS+1),a
05F1D2             0078*       ENDMACRO
05F1D2             0079*   
05F1D2             0080*       MACRO HEX_PROVIDER_LOAD_CAMERA_HL OFFSET
05F1D2             0081*           ld hl,0
05F1D2             0082*           ld l,(ix+OFFSET)
05F1D2             0083*           ld h,(ix+OFFSET+1)
05F1D2             0084*       ENDMACRO
05F1D2             0085*   
05F1D2             0086*       MACRO HEX_PROVIDER_STORE_CAMERA_HL OFFSET
05F1D2             0087*           ld (ix+OFFSET),l
05F1D2             0088*           ld (ix+OFFSET+1),h
05F1D2             0089*       ENDMACRO
05F1D2             0090*   
05F1D2             0091*   ; Before the first plan exists (manager initialization), report the complete
05F1D2             0092*   ; near disk.  Thereafter report the cached dense near+coarse desired count.
05F1D2             0093*   terrain_provider_ring_count:
05F1D2 47          0094*       ld b,a
05F1D3 3A A1 07 06 0095*       ld a,(regular_provider_plan_valid)
05F1D7 B7          0096*       or a
05F1D8 78          0097*       ld a,b
05F1D9 28 05       0098*       jr z,regular_provider_near_ring_count
05F1DB 3A A3 07 06 0099*       ld a,(regular_provider_desired_count)
05F1DF C9          0100*       ret
05F1E0             0101*   
05F1E0             0102*   regular_provider_near_ring_count:
05F1E0 21 04 06 06 0103*       ld hl,hex_provider_ring_counts
05F1E4 11 00 00 00 0104*       ld de,0
05F1E8 5F          0105*       ld e,a
05F1E9 19          0106*       add hl,de
05F1EA 7E          0107*       ld a,(hl)
05F1EB C9          0108*       ret
05F1EC             0109*   
05F1EC             0110*   ; Input A is an ordinal in the current complete disk.  Output is the shared
05F1EC             0111*   ; candidate request block.  Carry means the bounded regional corpus clips the
05F1EC             0112*   ; requested cell.  The ordering is centre first, then clockwise rings, each
05F1EC             0113*   ; beginning at the northwestern cell; it is byte-identical to disk_offsets().
05F1EC             0114*   terrain_provider_desired_at:
05F1EC F5          0115*       push af
05F1ED 3A 8F 1F 06 0116*       ld a,(terrain_manager_current_ring)
05F1F1 CD E0 F1 05 0117*       call regular_provider_near_ring_count
05F1F5 47          0118*       ld b,a
05F1F6 F1          0119*       pop af
05F1F7 B8          0120*       cp b
05F1F8 38 05       0121*       jr c,regular_provider_near_desired_at
05F1FA 90          0122*       sub b
05F1FB C3 8A F2 05 0123*       jp regular_provider_coarse_desired_at
05F1FF             0124*   
05F1FF             0125*   regular_provider_near_desired_at:
05F1FF             0126*   .if terrain_manager_group_staging
05F1FF 32 22 0C 06 0127*       ld (regular_provider_near_ordinal),a
05F203 CD 22 F2 05 0128*       call regular_provider_build_near_candidate
05F207 D8          0129*       ret c
05F208 3A 22 0C 06 0130*       ld a,(regular_provider_near_ordinal)
05F20C CD 30 F6 05 0131*       call regular_provider_near_slot_pointer
05F210 7E          0132*       ld a,(hl)
05F211 FE FF       0133*       cp regular_provider_unassigned_slot
05F213 28 0B       0134*       jr z,@outside
05F215 32 A9 1F 06 0135*       ld (terrain_manager_candidate_slot),a
05F219 AF          0136*       xor a
05F21A 32 AA 1F 06 0137*       ld (terrain_manager_candidate_lod),a
05F21E B7          0138*       or a
05F21F C9          0139*       ret
05F220             0140*   @outside:
05F220 37          0141*       scf
05F221 C9          0142*       ret
05F222             0143*   
05F222             0144*   ; Build only the bounded L0 identity for one canonical disk ordinal.  Physical
05F222             0145*   ; ownership is deliberately separate: after the first coverage handoff a near
05F222             0146*   ; cell may occupy any one of the 255 manager slots.
05F222             0147*   regular_provider_build_near_candidate:
05F222             0148*   .endif
05F222 21 00 00 00 0149*       ld hl,0
05F226 6F          0150*       ld l,a
05F227 29          0151*       add hl,hl
05F228 11 0A 06 06 0152*       ld de,hex_provider_disk_offsets
05F22C 19          0153*       add hl,de
05F22D E5          0154*       push hl
05F22E DD E1       0155*       pop ix
05F230             0156*   
05F230             0157*       HEX_PROVIDER_LOAD_U16_HL terrain_manager_origin_q
                       M1 Args: ADDRESS=terrain_manager_origin_q 
05F230 21 00 00 00 0001*M1         ld hl,0
05F234 3A 96 1F 06 0002*M1         ld a,(ADDRESS)
05F238 6F          0003*M1         ld l,a
05F239 3A 97 1F 06 0004*M1         ld a,(ADDRESS+1)
05F23D 67          0005*M1         ld h,a
05F23E 11 00 00 00 0158*       ld de,0
05F242 DD 5E 00    0159*       ld e,(ix+0)
05F245 CB 7B       0160*       bit 7,e
05F247 28 02       0161*       jr z,@q_extended
05F249 16 FF       0162*       ld d,0ffh
05F24B             0163*   @q_extended:
05F24B 52 19       0164*       add.s hl,de
05F24D             0165*       HEX_PROVIDER_STORE_U16_HL terrain_manager_candidate_q
                       M1 Args: ADDRESS=terrain_manager_candidate_q 
05F24D 7D          0001*M1         ld a,l
05F24E 32 A5 1F 06 0002*M1         ld (ADDRESS),a
05F252 7C          0003*M1         ld a,h
05F253 32 A6 1F 06 0004*M1         ld (ADDRESS+1),a
05F257             0166*   
05F257             0167*       HEX_PROVIDER_LOAD_U16_HL terrain_manager_origin_r
                       M1 Args: ADDRESS=terrain_manager_origin_r 
05F257 21 00 00 00 0001*M1         ld hl,0
05F25B 3A 98 1F 06 0002*M1         ld a,(ADDRESS)
05F25F 6F          0003*M1         ld l,a
05F260 3A 99 1F 06 0004*M1         ld a,(ADDRESS+1)
05F264 67          0005*M1         ld h,a
05F265 11 00 00 00 0168*       ld de,0
05F269 DD 5E 01    0169*       ld e,(ix+1)
05F26C CB 7B       0170*       bit 7,e
05F26E 28 02       0171*       jr z,@r_extended
05F270 16 FF       0172*       ld d,0ffh
