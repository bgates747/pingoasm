059D08             0056*           ld e,a
059D08             0057*           ld a,(ADDRESS+1)
059D08             0058*           ld d,a
059D08             0059*       ENDMACRO
059D08             0060*   
059D08             0061*       MACRO HEX_PROVIDER_STORE_U16_HL ADDRESS
059D08             0062*           ld a,l
059D08             0063*           ld (ADDRESS),a
059D08             0064*           ld a,h
059D08             0065*           ld (ADDRESS+1),a
059D08             0066*       ENDMACRO
059D08             0067*   
059D08             0068*       MACRO HEX_PROVIDER_LOAD_CAMERA_HL OFFSET
059D08             0069*           ld hl,0
