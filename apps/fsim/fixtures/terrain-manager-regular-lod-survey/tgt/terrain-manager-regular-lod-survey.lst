05B29E             0116        include "../../../runtime/ez80/terrain-manager.inc"
05B29E             0001*   ; =============================================================================
05B29E             0002*   ; Topology-neutral Pingo terrain residency manager (ADL=1).
05B29E             0003*   ;
05B29E             0004*   ; Required compile-time constants:
05B29E             0005*   ;   terrain_manager_slot_count       1..255 (91 for radius-five hex)
05B29E             0006*   ;   terrain_manager_max_ring
05B29E             0007*   ;   terrain_manager_initial_ring
05B29E             0008*   ;   terrain_manager_mesh_id_base     exact u16
05B29E             0009*   ;   terrain_manager_object_id_base   exact u16
05B29E             0010*   ;
05B29E             0011*   ; Required provider hooks:
05B29E             0012*   ;   terrain_provider_ring_count
05B29E             0013*   ;       A=ring -> A=count (1..slot_count).
05B29E             0014*   ;   terrain_provider_desired_at
05B29E             0015*   ;       A=ordinal. Fills candidate_q/r (s16), candidate_slot (u8), and
05B29E             0016*   ;       candidate_lod (u8). Carry set means clipped/outside the corpus.
05B29E             0017*   ;       Slots must be injective over every desired set and stable per world cell.
05B29E             0018*   ;   terrain_provider_load_candidate
05B29E             0019*   ;       Reads candidate fields and work_mesh_id. Performs one complete validated
05B29E             0020*   ;       P3DM/AGNB publication; Z/A=0 success, NZ/A=error. Failure must retain the
05B29E             0021*   ;       old mesh/object exactly.
05B29E             0022*   ;   terrain_provider_position_candidate
05B29E             0023*   ;       Reads candidate fields, current origin and work_object_id. Publishes the
05B29E             0024*   ;       command-52 transform; Z/A=0 success, NZ/A=error.
05B29E             0025*   ;   terrain_provider_candidate_is_desired
05B29E             0026*   ;       Reads candidate fields/current origin/ring; Z desired, NZ stale.
05B29E             0027*   ;   terrain_provider_normalize_position
05B29E             0028*   ;       IX is opaque mutable application position state. The manager seeds
05B29E             0029*   ;       proposed_origin_q/r. Provider may normalize local X/Z, writes proposed
05B29E             0030*   ;       q/r, marks application position dirty, and returns carry iff origin moved.
05B29E             0031*   ;
05B29E             0032*   ; Required VDU helper: pingo_set_object_active (HL=u16 object ID, A=0/1).
05B29E             0033*   ;
05B29E             0034*   ; Public API:
05B29E             0035*   ;   terrain_manager_initialize
05B29E             0036*   ;   terrain_manager_submit_origin       BC=s16 q, DE=s16 r
05B29E             0037*   ;   terrain_manager_update_position     IX=opaque mutable position state;
05B29E             0038*   ;                                       A=0 unchanged/A=1 rebased, carry=error
05B29E             0039*   ;   terrain_manager_set_ring            A=ring
05B29E             0040*   ;   terrain_manager_service_idle        only while no render is in flight
05B29E             0041*   ;   terrain_manager_query               IX=status
05B29E             0042*   ;   terrain_manager_shutdown_idle       only while no render is in flight
05B29E             0043*   ;
05B29E             0044*   ; service_idle performs one load, activation, deactivation, or atomic all-active
05B29E             0045*   ; origin-reposition transaction. Carry clear returns A=operation; carry set
05B29E             0046*   ; returns A=error. Every dw below is accessed bytewise.
05B29E             0047*   ; =============================================================================
