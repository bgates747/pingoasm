047B66             0001*   ; =============================================================================
047B66             0002*   ; Experimental Pingo command 53 client.
047B66             0003*   ;
047B66             0004*   ; Inputs:
047B66             0005*   ;   HL = projection far distance in Pingo scene units (2..65535)
047B66             0006*   ;
047B66             0007*   ; Values 0 and 1 are consumed but rejected by the VDP, preserving the current
047B66             0008*   ; setting.  Copy the two-byte value bytewise so ADL mode cannot widen the
047B66             0009*   ; packet field into the following command stream.
047B66             0010*   ; Clobbers AF, BC, HL.
047B66             0011*   ; =============================================================================
047B66             0012*   
