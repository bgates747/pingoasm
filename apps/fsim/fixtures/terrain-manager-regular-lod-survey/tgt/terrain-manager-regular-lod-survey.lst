047D48             0001*   ; =============================================================================
047D48             0002*   ; Fixture-only live terrain-radius controls.
047D48             0003*   ;
047D48             0004*   ; The manager receives policy through manager_survey_radius_request; it does
047D48             0005*   ; not know about keyboards.  Top-row digits use MOS's BBC-compatible physical
047D48             0006*   ; key map.  Selection is rising-edge only, and simultaneous presses choose the
047D48             0007*   ; lowest radius deterministically.
047D48             0008*   ; =============================================================================
047D48             0009*   
047D48             0010*   manager_survey_initialize_radius_controls:
047D48 AF          0011*       xor a
047D49 32 D1 7D 04 0012*       ld (manager_survey_radius_keys_down),a
