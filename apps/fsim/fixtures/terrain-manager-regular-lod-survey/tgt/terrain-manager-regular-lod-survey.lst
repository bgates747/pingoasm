04305E             0118        include "../../p3dm-loader-probe/src/p3dm-loader.inc"
04305E             0001*   ; Exact AGNB 0.3/P3DM one-component loader and experimental publication API.
04305E             0002*   ;
04305E             0003*   ; Contract:
04305E             0004*   ;   p3dm_load_component
04305E             0005*   ;       opens the path in p3dm_filename_pointer, reads it completely, closes
04305E             0006*   ;       it, validates the exact fixed container and caller-selected policy,
04305E             0007*   ;       CRC32 and indices,
04305E             0008*   ;       uploads only DATA to p3dm_stage_buffer_id, consolidates, and sends
04305E             0009*   ;       Pingo subcommand 50 to the already-established p3dm_target_mesh_id.
04305E             0010*   ;   pingo_set_object_active
04305E             0011*   ;       sends Pingo subcommand 51 for an already-established object.
04305E             0012*   ;
04305E             0013*   ; Required compile-time policy:
04305E             0014*   ;   p3dm_mirror_z_on_load
04305E             0015*   ;       0 uploads validated DATA byte-for-byte.
04305E             0016*   ;       1 converts the legacy reflected terrain basis from Z=-east to
04305E             0017*   ;       Z=+east after CRC/index validation and before VDP upload. The
04305E             0018*   ;       conversion negates every vertex Z and reverses position/UV winding.
04305E             0019*   ;
04305E             0020*   ; The 16 KiB whole-file window admits all current Bay Area proof components,
04305E             0021*   ; including KSFO M00 (14,120 bytes). It keeps parsing fail-closed and wholly
04305E             0022*   ; pre-publication while the regional coordinator reuses the request block.
04305E             0023*   
04305E             0024*       MACRO P3DM_LD_U16_BC ADDRESS
04305E             0025*       ld bc,0
04305E             0026*       ld a,(ADDRESS)
04305E             0027*       ld c,a
04305E             0028*       ld a,(ADDRESS+1)
04305E             0029*       ld b,a
04305E             0030*       ENDMACRO
04305E             0031*   
04305E             0032*       MACRO P3DM_LD_U16_DE ADDRESS
04305E             0033*       ld de,0
04305E             0034*       ld a,(ADDRESS)
04305E             0035*       ld e,a
04305E             0036*       ld a,(ADDRESS+1)
04305E             0037*       ld d,a
04305E             0038*       ENDMACRO
04305E             0039*   
04305E             0040*       MACRO P3DM_LD_U16_HL ADDRESS
04305E             0041*       ld hl,0
04305E             0042*       ld a,(ADDRESS)
04305E             0043*       ld l,a
04305E             0044*       ld a,(ADDRESS+1)
04305E             0045*       ld h,a
04305E             0046*       ENDMACRO
04305E             0047*   
04305E             0048*       MACRO P3DM_ST_U16_HL ADDRESS
04305E             0049*       ld a,l
04305E             0050*       ld (ADDRESS),a
04305E             0051*       ld a,h
04305E             0052*       ld (ADDRESS+1),a
04305E             0053*       ENDMACRO
04305E             0054*   
