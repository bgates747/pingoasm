042AF3             0115        include "terrain-manager-solid-sky.inc"
042AF3             0001*   ; =============================================================================
042AF3             0002*   ; Fixed full-frame sky clear for terrain-manager camera fixtures.
042AF3             0003*   ;
042AF3             0004*   ; Pingo clears untouched target pixels to transparent before each render.  The
042AF3             0005*   ; completed target is composited over this solid canvas clear, so missing
042AF3             0006*   ; scenery reveals one stable sky colour.  This deliberately has no horizon,
042AF3             0007*   ; ground proxy, pitch, roll, or other camera-attitude dependency.
042AF3             0008*   ; =============================================================================
042AF3             0009*   
042AF3             0010*   terrain_sky_plot_move_absolute: equ 04h
042AF3             0011*   terrain_sky_plot_triangle_absolute: equ 55h
042AF3             0012*   terrain_sky_colour: equ 47
042AF3             0013*   
042AF3             0014*   ; render-async.inc retains this historical callback name.  For this fixture it
042AF3             0015*   ; means only "clear the visible render area before compositing the target".
042AF3             0016*   draw_flight_backdrop:
042AF3 21 FE 2A 04 0017*       ld hl,terrain_sky_clear_packet
042AF7 01 27 00 00 0018*       ld bc,terrain_sky_clear_packet_end-terrain_sky_clear_packet
042AFB 5B DF       0019*       rst.lil 18h
042AFD C9          0020*       ret
042AFE             0021*   
042AFE             0022*   terrain_sky_clear_packet:
042AFE 12 00 2F    0023*       db 18,0,terrain_sky_colour
042B01 19 04       0024*       db 25,terrain_sky_plot_move_absolute
042B03 00 00 00 00 0025*       dw 0,0
042B07 19 04       0026*       db 25,terrain_sky_plot_move_absolute
042B09 3F 01 00 00 0027*       dw viewport_width-1,0
042B0D 19 55       0028*       db 25,terrain_sky_plot_triangle_absolute
042B0F 3F 01 EF 00 0029*       dw viewport_width-1,viewport_height-1
042B13 19 04       0030*       db 25,terrain_sky_plot_move_absolute
042B15 00 00 00 00 0031*       dw 0,0
042B19 19 04       0032*       db 25,terrain_sky_plot_move_absolute
042B1B 3F 01 EF 00 0033*       dw viewport_width-1,viewport_height-1
042B1F 19 55       0034*       db 25,terrain_sky_plot_triangle_absolute
042B21 00 00 EF 00 0035*       dw 0,viewport_height-1
042B25             0036*   terrain_sky_clear_packet_end:
042B25             0037*   
042B25             0038*   ; The superseded attitude backdrop occupied 704 more assembled bytes at this
042B25             0039*   ; include boundary.  Preserve that space so the large generated hierarchy and
042B25             0040*   ; manager retain their established debugger/listing addresses while this
042B25             0041*   ; presentation experiment is under human review.
042B25             0042*   terrain_sky_compatibility_reserve_bytes: equ 704
042B25             0043*       ds terrain_sky_compatibility_reserve_bytes
