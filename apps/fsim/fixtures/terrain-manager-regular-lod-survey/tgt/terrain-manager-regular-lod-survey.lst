040000             0030    simulation_max_backlog_ticks: equ 32
040000             0031    survey_angular_rate_128: equ 4864
040000             0032    survey_angular_step: equ survey_angular_rate_128 >> 5
040000             0033    survey_pitch_limit: equ 8191
040000             0034    survey_translation_rate_min: equ 8
040000             0035    survey_translation_rate_initial: equ 32
040000             0036    survey_translation_rate_max: equ 256
040000             0037    
040000             0038    ; Universal-manager policy.  This client supplies no flight dynamics,
040000             0039    ; collision, aircraft, or non-terrain scenery assumptions.
040000             0040    ; Slots 0..90 retain the qualified radius-five TRH/L0 hash.  The hierarchy
040000             0041    ; plan owns 91..254 dynamically: no legal plan needs more than 159 coarse
040000             0042    ; leaves, leaving five protected replacement slots at the proven 250-object
040000             0043    ; maximum.
040000             0044    terrain_manager_slot_count: equ 255
040000             0045    terrain_manager_max_ring: equ 5
040000             0046    terrain_manager_initial_ring: equ 5
040000             0047    terrain_manager_mesh_id_base: equ 1
040000             0048    terrain_manager_object_id_base: equ 1
040000             0049    ; Keep the preceding plan visible until every desired replacement is active.
040000             0050    ; The regular provider has a proven one-cell placement fringe for this handoff.
040000             0051    terrain_manager_defer_stale_rebase: equ 1
040000             0052    ; The accepted regular fixture uses full-owner coverage-group staging.
040000             0053    ; scripts/build_regular_lod_group_scratch.py --group-staging 0 preserves the
040000             0054    ; byte-exact inactive-first policy as an isolated rollback build.
040000             0055    terrain_manager_group_staging: equ 1
040000             0056    
040000             0057    ; Command 53 carries the complete unsigned word.  At the terrain convention of
040000             0058    ; eight metres per Pingo unit this is about 524 km; resident rings and later
040000             0059    ; LOD policy, rather than the projection plane, still bound submitted geometry.
040000             0060    manager_survey_projection_far_units: equ 65535
040000             0061    
040000             0062    manager_survey_slot_count: equ terrain_manager_slot_count
040000             0063    manager_survey_default_radius: equ terrain_manager_initial_ring
040000             0064    manager_survey_mesh_base: equ terrain_manager_mesh_id_base
040000             0065    manager_survey_object_base: equ terrain_manager_object_id_base
040000             0066    
040000             0067    ; Preserve the reviewed Berkeley Marina position, but express it in its
040000             0068    ; actual containing cell so the first manager publication needs no corrective
040000             0069    ; origin rebase.  The view is 500 m above the source datum, level, and facing
040000             0070    ; almost due north.  Roll is explicitly zeroed by the attitude initializer.
040000             0071    manager_survey_start_q: equ 80
040000             0072    manager_survey_start_r: equ 125
040000             0073    camera_initial_x: equ 4275
040000             0074    camera_initial_y: equ 8000
040000             0075    camera_initial_z: equ -466
040000             0076    camera_initial_pitch: equ 0
040000             0077    camera_initial_yaw: equ -8192
040000             0078    
040000             0079    ; The complete TRH/RGL corpora use the provider's true Bay Area q/r bounds. The
040000             0080    ; historical Campanile and Marina extractions remain separate build artifacts,
040000             0081    ; but no experimental disk fence limits this regional viewer.
040000             0082    hex_provider_fixture_bounds_enabled: equ 0
040000             0083    hex_provider_fixture_center_q: equ manager_survey_start_q
040000             0084    hex_provider_fixture_center_r: equ manager_survey_start_r
040000             0085    hex_provider_fixture_radius: equ 5
040000             0086    hex_provider_natural_namespace: equ 1
