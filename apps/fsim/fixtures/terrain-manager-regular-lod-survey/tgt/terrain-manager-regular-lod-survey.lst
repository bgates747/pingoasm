047D58             0017*   
047D58             0018*   manager_survey_update_radius_keys:
047D58 DD 21 5C 00 0019*       ld ix,keyboard_masks
       04          
047D5D 06 00       0020*       ld b,0
047D5F DD CB 04 7E 0021*       bit 7,(ix+4)                       ; top-row 0: physical key 40
047D63 28 02       0022*       jr z,@one
047D65 CB C0       0023*       set 0,b
047D67             0024*   @one:
047D67 DD CB 06 46 0025*       bit 0,(ix+6)                       ; top-row 1: physical key 49
047D6B 28 02       0026*       jr z,@two
047D6D CB C8       0027*       set 1,b
047D6F             0028*   @two:
047D6F DD CB 06 4E 0029*       bit 1,(ix+6)                       ; top-row 2: physical key 50
047D73 28 02       0030*       jr z,@three
047D75 CB D0       0031*       set 2,b
047D77             0032*   @three:
047D77 DD CB 02 4E 0033*       bit 1,(ix+2)                       ; top-row 3: physical key 18
047D7B 28 02       0034*       jr z,@four
047D7D CB D8       0035*       set 3,b
047D7F             0036*   @four:
047D7F DD CB 02 56 0037*       bit 2,(ix+2)                       ; top-row 4: physical key 19
047D83 28 02       0038*       jr z,@five
047D85 CB E0       0039*       set 4,b
047D87             0040*   @five:
047D87 DD CB 02 5E 0041*       bit 3,(ix+2)                       ; top-row 5: physical key 20
047D8B 28 02       0042*       jr z,@edges
047D8D CB E8       0043*       set 5,b
047D8F             0044*   
047D8F             0045*   @edges:
047D8F 3A D1 7D 04 0046*       ld a,(manager_survey_radius_keys_down)
047D93 4F          0047*       ld c,a
047D94 78          0048*       ld a,b
047D95 32 D1 7D 04 0049*       ld (manager_survey_radius_keys_down),a
047D99 79          0050*       ld a,c
047D9A 2F          0051*       cpl
047D9B A0          0052*       and b                              ; A = newly pressed radius keys
047D9C C8          0053*       ret z
047D9D CB 47       0054*       bit 0,a
047D9F 20 14       0055*       jr nz,@radius_zero
047DA1 CB 4F       0056*       bit 1,a
047DA3 20 13       0057*       jr nz,@radius_one
047DA5 CB 57       0058*       bit 2,a
047DA7 20 13       0059*       jr nz,@radius_two
047DA9 CB 5F       0060*       bit 3,a
047DAB 20 13       0061*       jr nz,@radius_three
047DAD CB 67       0062*       bit 4,a
047DAF 20 13       0063*       jr nz,@radius_four
047DB1 3E 05       0064*       ld a,5
047DB3 18 11       0065*       jr @publish
047DB5             0066*   @radius_zero:
047DB5 AF          0067*       xor a
047DB6 18 0E       0068*       jr @publish
047DB8             0069*   @radius_one:
047DB8 3E 01       0070*       ld a,1
047DBA 18 0A       0071*       jr @publish
047DBC             0072*   @radius_two:
047DBC 3E 02       0073*       ld a,2
047DBE 18 06       0074*       jr @publish
047DC0             0075*   @radius_three:
047DC0 3E 03       0076*       ld a,3
047DC2 18 02       0077*       jr @publish
047DC4             0078*   @radius_four:
047DC4 3E 04       0079*       ld a,4
047DC6             0080*   @publish:
047DC6 32 D2 7D 04 0081*       ld (manager_survey_radius_request),a
047DCA 3E 01       0082*       ld a,1
047DCC 32 D3 7D 04 0083*       ld (manager_survey_radius_pending),a
