0429FA             0261*   
0429FA             0262*   ; A/D: left local -X / right local +X.
0429FA DD CB 08 4E 0263*       bit 1,(ix+8)                        ; A
0429FE 28 23       0264*       jr z,@right_translation_only
042A00 DD CB 06 56 0265*       bit 2,(ix+6)                        ; D
042A04 20 37       0266*       jr nz,@horizontal_ready
