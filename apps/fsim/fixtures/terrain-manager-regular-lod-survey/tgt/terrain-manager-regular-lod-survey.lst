059D08             0115        include "terrain-manager-regular-lod-provider.inc"
059D08             0001*   ; =============================================================================
059D08             0002*   ; Position-driven regular hierarchy provider for the universal terrain manager.
059D08             0003*   ;
059D08             0004*   ; Detailed TRH/L0 cells retain stable slots 0..90.  Generated hierarchy leaves
059D08             0005*   ; are exact (lod, anchor_q, anchor_offset_row) identities and use a protected
059D08             0006*   ; dynamic pool in slots 91..254.  A new plan first preserves every matching
059D08             0007*   ; resident identity (active or inactive), then assigns unused pool slots.  The
059D08             0008*   ; shared manager still owns publication, retry, activation and rebase ordering.
059D08             0009*   ;
059D08             0010*   ; Every radius-five disk maps bijectively onto the first 91 slots through
059D08             0011*   ;
059D08             0012*   ;     slot = (5*q + 11*r) mod 91.
059D08             0013*   ;
059D08             0014*   ; The kernel basis (11,-5),(5,6) has determinant 91 and minimum non-zero hex
059D08             0015*   ; distance 11.  Therefore no difference between two cells in one radius-five
059D08             0016*   ; disk (maximum distance 10) can be in the kernel.  Smaller disks inherit the
059D08             0017*   ; same injectivity, and normalizing negative residues makes the mapping global.
059D08             0018*   ; =============================================================================
059D08             0019*   
059D08             0020*   hex_provider_q_max: equ 213
059D08             0021*   hex_provider_even_rows: equ 235
059D08             0022*   hex_provider_odd_rows: equ 234
059D08             0023*   hex_provider_cell_id_pair_stride: equ 469
059D08             0024*   hex_provider_terrain_y_count: equ 9728
059D08             0025*   hex_provider_object_scale_q8_8: equ 32768
059D08             0026*   hex_provider_hysteresis_count: equ 256
059D08             0027*   hex_provider_vertical_exit_first: equ 4657
059D08             0028*   hex_provider_tip_exit_first: equ 5377
059D08             0029*   hex_provider_sloped_normal_squared: equ 4146176
059D08             0030*   hex_provider_sloped_hysteresis: equ 521271
059D08             0031*   hex_provider_sloped_exit_first: equ 9532472
059D08             0032*   
059D08             0033*   regular_provider_near_slot_count: equ 91
059D08             0034*   regular_provider_coarse_slot_first: equ 91
059D08             0035*   regular_provider_coarse_slot_count: equ 164
059D08             0036*   regular_provider_plan_max: equ regular_lod_phase_maximum_records
059D08             0037*   regular_provider_plan_record_lod: equ 0
059D08             0038*   regular_provider_plan_record_q: equ 1
059D08             0039*   regular_provider_plan_record_row: equ 3
059D08             0040*   regular_provider_plan_record_slot: equ 5
059D08             0041*   regular_provider_plan_record_bytes: equ 6
059D08             0042*   regular_provider_unassigned_slot: equ 0ffh
059D08             0043*   regular_provider_error_plan: equ 031h
059D08             0044*   
059D08             0045*       MACRO HEX_PROVIDER_LOAD_U16_HL ADDRESS
059D08             0046*           ld hl,0
059D08             0047*           ld a,(ADDRESS)
059D08             0048*           ld l,a
059D08             0049*           ld a,(ADDRESS+1)
059D08             0050*           ld h,a
059D08             0051*       ENDMACRO
059D08             0052*   
059D08             0053*       MACRO HEX_PROVIDER_LOAD_U16_DE ADDRESS
059D08             0054*           ld de,0
