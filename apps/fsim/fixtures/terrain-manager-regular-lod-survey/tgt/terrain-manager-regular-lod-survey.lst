06156C             0129        include "../../../runtime/ez80/terrain-manager.inc"
06156C             0001*   ; =============================================================================
06156C             0002*   ; Topology-neutral Pingo terrain residency manager (ADL=1).
06156C             0003*   ;
06156C             0004*   ; Required compile-time constants:
06156C             0005*   ;   terrain_manager_slot_count       1..255 (91 for radius-five hex)
06156C             0006*   ;   terrain_manager_max_ring
06156C             0007*   ;   terrain_manager_initial_ring
06156C             0008*   ;   terrain_manager_mesh_id_base     exact u16
06156C             0009*   ;   terrain_manager_object_id_base   exact u16
06156C             0010*   ;   terrain_manager_defer_stale_rebase
06156C             0011*   ;       0 retires stale active objects during the origin transaction.
06156C             0012*   ;       1 repositions and retains them until the complete desired plan is
06156C             0013*   ;       active, then lets ordinary stale eviction retire them.
06156C             0014*   ;   terrain_manager_group_staging
06156C             0015*   ;       0 omits the experimental coverage-group staging API and storage.
06156C             0016*   ;       1 assembles load-without-activate and atomic group-commit support.
06156C             0017*   ;
06156C             0018*   ; Required provider hooks:
06156C             0019*   ;   terrain_provider_ring_count
06156C             0020*   ;       A=ring -> A=count (1..slot_count).
06156C             0021*   ;   terrain_provider_desired_at
06156C             0022*   ;       A=ordinal. Fills candidate_q/r (s16), candidate_slot (u8), and
06156C             0023*   ;       candidate_lod (u8). Carry set means clipped/outside the corpus.
06156C             0024*   ;       Slots must be injective over every desired set and stable per world cell.
06156C             0025*   ;   terrain_provider_load_candidate
06156C             0026*   ;       Reads candidate fields and work_mesh_id. Performs one complete validated
06156C             0027*   ;       P3DM/AGNB publication; Z/A=0 success, NZ/A=error. Failure must retain the
06156C             0028*   ;       old mesh/object exactly.
06156C             0029*   ;   terrain_provider_position_candidate
06156C             0030*   ;       Reads candidate fields, current origin and work_object_id. Publishes the
06156C             0031*   ;       command-52 transform; Z/A=0 success, NZ/A=error.
06156C             0032*   ;   terrain_provider_candidate_is_desired
06156C             0033*   ;       Reads candidate fields/current origin/ring; Z desired, NZ stale.
06156C             0034*   ;   terrain_provider_normalize_position
06156C             0035*   ;       IX is opaque mutable application position state. The manager seeds
06156C             0036*   ;       proposed_origin_q/r. Provider may normalize local X/Z, writes proposed
06156C             0037*   ;       q/r, marks application position dirty, and returns carry iff origin moved.
06156C             0038*   ; When terrain_manager_group_staging=1:
06156C             0039*   ;   terrain_provider_transition_busy     A=0 idle/A!=0 owns manager service
06156C             0040*   ;   terrain_provider_ring_change_allowed A=0 allowed/A!=0 reject unchanged
06156C             0041*   ;   terrain_provider_service_transition only while no render is in flight
06156C             0042*   ;
06156C             0043*   ; Required VDU helper: pingo_set_object_active (HL=u16 object ID, A=0/1).
06156C             0044*   ;
06156C             0045*   ; Public API:
06156C             0046*   ;   terrain_manager_initialize
06156C             0047*   ;   terrain_manager_submit_origin       BC=s16 q, DE=s16 r
06156C             0048*   ;   terrain_manager_update_position     IX=opaque mutable position state;
06156C             0049*   ;                                       A=0 unchanged/A=1 rebased, carry=error
06156C             0050*   ;   terrain_manager_set_ring            A=ring
06156C             0051*   ;   terrain_manager_service_idle        only while no render is in flight
06156C             0052*   ;   terrain_manager_stage_candidate     load/position one inactive candidate
06156C             0053*   ;                                       without making it visible
06156C             0054*   ;   terrain_manager_commit_staged_group IX=retiring u8 slots, B=count;
06156C             0055*   ;                                       IY=entering u8 slots, C=count;
06156C             0056*   ;                                       only while no render is in flight
06156C             0057*   ;   terrain_manager_query               IX=status
06156C             0058*   ;   terrain_manager_shutdown_idle       only while no render is in flight
06156C             0059*   ;
06156C             0060*   ; service_idle performs one load, activation, deactivation, or atomic all-active
06156C             0061*   ; origin-reposition transaction. Carry clear returns A=operation; carry set
06156C             0062*   ; returns A=error. Every dw below is accessed bytewise.
06156C             0063*   ; =============================================================================
06156C             0064*   
06156C             0065*   terrain_manager_state_uninitialized: equ 0
06156C             0066*   terrain_manager_state_ready:         equ 1
06156C             0067*   terrain_manager_state_error:         equ 2
06156C             0068*   terrain_manager_state_shutdown:      equ 3
06156C             0069*   
06156C             0070*   terrain_manager_operation_none:       equ 0
06156C             0071*   terrain_manager_operation_load:       equ 1
06156C             0072*   terrain_manager_operation_activate:   equ 2
06156C             0073*   terrain_manager_operation_deactivate: equ 3
06156C             0074*   terrain_manager_operation_rebase:     equ 4
06156C             0075*   terrain_manager_operation_shutdown:   equ 5
06156C             0076*   terrain_manager_operation_stage:      equ 6
06156C             0077*   terrain_manager_operation_group:      equ 7
06156C             0078*   
06156C             0079*   terrain_manager_flag_resident: equ 1
06156C             0080*   terrain_manager_flag_active:   equ 2
06156C             0081*   terrain_manager_flag_staged:   equ 4
06156C             0082*   
06156C             0083*   terrain_manager_error_config:   equ 020h
06156C             0084*   terrain_manager_error_ring:     equ 021h
06156C             0085*   terrain_manager_error_origin:   equ 022h
06156C             0086*   terrain_manager_error_provider: equ 023h
06156C             0087*   terrain_manager_error_position: equ 024h
06156C             0088*   terrain_manager_error_slot:     equ 025h
06156C             0089*   terrain_manager_error_group:    equ 026h
06156C             0090*   terrain_manager_retry_max:      equ 5
06156C             0091*   
06156C             0092*       MACRO TERRAIN_MANAGER_STORE_U16_HL ADDRESS
06156C             0093*           ld a,l
06156C             0094*           ld (ADDRESS+0),a
06156C             0095*           ld a,h
06156C             0096*           ld (ADDRESS+1),a
06156C             0097*       ENDMACRO
06156C             0098*   
06156C             0099*       MACRO TERRAIN_MANAGER_LOAD_U16_HL ADDRESS
06156C             0100*           ld hl,0
06156C             0101*           ld a,(ADDRESS+0)
06156C             0102*           ld l,a
06156C             0103*           ld a,(ADDRESS+1)
06156C             0104*           ld h,a
06156C             0105*       ENDMACRO
06156C             0106*   
06156C             0107*       MACRO TERRAIN_MANAGER_STORE_U16_BC ADDRESS
06156C             0108*           ld a,c
06156C             0109*           ld (ADDRESS+0),a
06156C             0110*           ld a,b
06156C             0111*           ld (ADDRESS+1),a
06156C             0112*       ENDMACRO
06156C             0113*   
06156C             0114*       MACRO TERRAIN_MANAGER_STORE_U16_DE ADDRESS
06156C             0115*           ld a,e
06156C             0116*           ld (ADDRESS+0),a
06156C             0117*           ld a,d
06156C             0118*           ld (ADDRESS+1),a
06156C             0119*       ENDMACRO
06156C             0120*   
06156C             0121*   terrain_manager_initialize:
