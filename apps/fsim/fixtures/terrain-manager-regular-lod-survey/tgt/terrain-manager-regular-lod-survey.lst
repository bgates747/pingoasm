059DF5             0196*   ; profiles are translation-independent; absolute anchors are resolved here and
059DF5             0197*   ; empty nodes beyond the bounded Bay Area corpus are omitted before allocation.
059DF5             0198*   terrain_provider_prepare_plan:
059DF5 AF          0199*       xor a
059DF6 32 45 AA 05 0200*       ld (regular_provider_plan_valid),a
