                       M1 Args: ADDRESS=survey_translation_rate 
042A06 3A E8 C6 05 0001*M1         ld a,(ADDRESS)
042A0A 6F          0002*M1         ld l,a
042A0B 3A E9 C6 05 0003*M1         ld a,(ADDRESS+1)
042A0F 67          0004*M1         ld h,a
