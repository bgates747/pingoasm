059DD2             0001*   ; Generated by pingo_terrain.regular_lod_runtime.emit_transition_include.
059DD2             0002*   ; Index = ((origin_q&7)*4 + (origin_offset_row&3))*6 + direction.
059DD2             0003*   ; Directions exactly match hex_provider_origin_steps.
059DD2             0004*   ; Owner ordinals name the unbounded source plan; absent edge owners
059DD2             0005*   ; are 0ffh in the runtime ordinal map and must be skipped, never packed.
059DD2             0006*   ; Source plan = 91 near disk entries, then static coarse phase records.
059DD2             0007*   ; Recipe: group_count:u8, followed by variable-length groups.
059DD2             0008*   ; Group: retiring_count:u8, entering_count:u8, then old source
059DD2             0009*   ; ordinals[retiring_count] and new source ordinals[entering_count].
059DD2             0010*   ; Canonical offset-table SHA-256: 34fd0c448e6b653d4ab25883eb283a328dc5825cd6232591866059cbd2b6a79d
