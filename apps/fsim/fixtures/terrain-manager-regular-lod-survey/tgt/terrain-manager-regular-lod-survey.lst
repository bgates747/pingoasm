047A9C             0110        include "../../../fixtures/_common/pingo-projection.inc"
047A9C             0001*   ; =============================================================================
047A9C             0002*   ; Experimental Pingo command 53 client.
047A9C             0003*   ;
047A9C             0004*   ; Inputs:
047A9C             0005*   ;   HL = projection far distance in Pingo scene units (2..65535)
047A9C             0006*   ;
047A9C             0007*   ; Values 0 and 1 are consumed but rejected by the VDP, preserving the current
047A9C             0008*   ; setting.  Copy the two-byte value bytewise so ADL mode cannot widen the
047A9C             0009*   ; packet field into the following command stream.
047A9C             0010*   ; Clobbers AF, BC, HL.
047A9C             0011*   ; =============================================================================
047A9C             0012*   
047A9C             0013*   pingo_set_projection_far_units:
047A9C 7D          0014*       ld a,l
047A9D 32 B8 7A 04 0015*       ld (@far_units),a
047AA1 7C          0016*       ld a,h
047AA2 32 B9 7A 04 0017*       ld (@far_units+1),a
047AA6             0018*   
047AA6 21 B1 7A 04 0019*       ld hl,@command
047AAA 01 09 00 00 0020*       ld bc,@command_end-@command
047AAE 5B DF       0021*       rst.lil 18h
047AB0 C9          0022*       ret
047AB1             0023*   
047AB1             0024*   @command:
047AB1 17 00 A0    0025*       db 23,0,0A0h
047AB4 C3 06       0026*       dw sid
047AB6 49 35       0027*       db 049h,53
047AB8             0028*   @far_units:
047AB8 00 00       0029*       dw 0
047ABA             0030*   @command_end:
047ABA             0111        include "terrain-manager-scene.inc"
047ABA             0001*   ; =============================================================================
047ABA             0002*   ; Stable Pingo terrain slots for the reusable-manager survey fixture.
047ABA             0003*   ;
047ABA             0004*   ; The fixture reserves the complete radius-five axial hex disk, but
047ABA             0005*   ; every slot starts inactive.  Runtime-patched packets keep mesh and object
047ABA             0006*   ; identifiers genuinely 16-bit; the setup loop must not silently become an
047ABA             0007*   ; eight-bit-ID implementation merely because this first pool begins at one.
047ABA             0008*   ; Command 50 can subsequently replace each placeholder mesh atomically.
047ABA             0009*   ; =============================================================================
047ABA             0010*   
047ABA             0011*       MACRO MANAGER_SCENE_STORE_U16_HL ADDRESS
047ABA             0012*           ld a,l
047ABA             0013*           ld (ADDRESS),a
047ABA             0014*           ld a,h
047ABA             0015*           ld (ADDRESS+1),a
047ABA             0016*       ENDMACRO
047ABA             0017*   
047ABA             0018*       MACRO MANAGER_SCENE_LOAD_U16_HL ADDRESS
047ABA             0019*           ld hl,0
047ABA             0020*           ld a,(ADDRESS)
047ABA             0021*           ld l,a
047ABA             0022*           ld a,(ADDRESS+1)
047ABA             0023*           ld h,a
047ABA             0024*       ENDMACRO
047ABA             0025*   
047ABA             0026*       MACRO MANAGER_SCENE_LOAD_U16_DE ADDRESS
047ABA             0027*           ld de,0
047ABA             0028*           ld a,(ADDRESS)
047ABA             0029*           ld e,a
047ABA             0030*           ld a,(ADDRESS+1)
047ABA             0031*           ld d,a
047ABA             0032*       ENDMACRO
047ABA             0033*   
047ABA             0034*   manager_survey_establish_scene_slots:
047ABA 21 01 00 00 0035*       ld hl,manager_survey_mesh_base
047ABE             0036*       MANAGER_SCENE_STORE_U16_HL terrain_scene_next_mesh_id
                       M1 Args: ADDRESS=terrain_scene_next_mesh_id 
047ABE 7D          0001*M1         ld a,l
047ABF 32 79 7C 04 0002*M1         ld (ADDRESS),a
047AC3 7C          0003*M1         ld a,h
047AC4 32 7A 7C 04 0004*M1         ld (ADDRESS+1),a
047AC8 21 01 00 00 0037*       ld hl,manager_survey_object_base
