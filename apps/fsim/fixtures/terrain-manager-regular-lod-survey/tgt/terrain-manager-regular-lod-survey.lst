040000             0019    ; Correct the legacy reflected disk corpus to right-handed Z=+east while it is
040000             0020    ; in the validated host staging window, before publication to Pingo.
040000             0021    p3dm_mirror_z_on_load: equ 1
040000             0022    
040000             0023    viewport_width: equ 320
040000             0024    viewport_height: equ 240
040000             0025    viewport_x: equ 0
040000             0026    viewport_y: equ 0
040000             0027    
040000             0028    simulation_step_ticks: equ 4
